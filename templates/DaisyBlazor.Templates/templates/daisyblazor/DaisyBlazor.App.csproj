<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <!-- Keep these in sync with <Version> in the repository's Directory.Build.props, so a freshly
       scaffolded app pulls the version that was just published (they were left at 0.1.1 while
       the kit shipped 0.2.3). -->
  <ItemGroup>
    <PackageReference Include="DaisyBlazor.Components" Version="0.2.4" />
    <PackageReference Include="DaisyBlazor.Charts" Version="0.2.3" />
  </ItemGroup>

  <!-- Build the Tailwind/daisyUI CSS as part of `dotnet build` (runs `npm install` on first run). -->
  <Target Name="BuildDaisyBlazorCss" BeforeTargets="BeforeBuild"
          Inputs="Styles\main.css;package.json"
          Outputs="wwwroot\css\app.css">
    <Exec Command="npm install" Condition="!Exists('node_modules')" />
    <Exec Command="npm run build:css" />
  </Target>

</Project>
