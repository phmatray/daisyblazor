<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <!-- release-please bumps these with each DaisyBlazor release, so a freshly scaffolded app
       pulls the version that was just published. -->
  <ItemGroup>
    <PackageReference Include="DaisyBlazor.Components" Version="0.4.0" /> <!-- x-release-please-version -->
    <PackageReference Include="DaisyBlazor.Charts" Version="0.4.0" /> <!-- x-release-please-version -->
  </ItemGroup>

  <!-- DaisyBlazor.Components compiles Styles/main.css to wwwroot/css/app.css on every build with
       the Tailwind standalone CLI (downloaded once, no Node/npm needed). -->
  <PropertyGroup>
    <DaisyBlazorBuildCss>true</DaisyBlazorBuildCss>
  </PropertyGroup>

</Project>
