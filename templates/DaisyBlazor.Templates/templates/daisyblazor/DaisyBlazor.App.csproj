<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <!-- Keep these in sync with <Version> in the repository's Directory.Build.props, so a freshly
       scaffolded app pulls the version that was just published (they were left at 0.1.1 while
       the kit shipped 0.2.3). -->
  <ItemGroup>
    <PackageReference Include="DaisyBlazor.Components" Version="0.3.0" />
    <PackageReference Include="DaisyBlazor.Charts" Version="0.3.0" />
  </ItemGroup>

  <!-- DaisyBlazor.Components compiles Styles/main.css to wwwroot/css/app.css on every build with
       the Tailwind standalone CLI (downloaded once, no Node/npm needed). -->
  <PropertyGroup>
    <DaisyBlazorBuildCss>true</DaisyBlazorBuildCss>
  </PropertyGroup>

</Project>
