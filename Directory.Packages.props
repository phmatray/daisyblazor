<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Sample / template app -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.0" />
  </ItemGroup>

  <!-- Testing (bUnit + xUnit v3) -->
  <ItemGroup>
    <PackageVersion Include="bunit" Version="2.7.2" />
    <!-- bunit 2.7.2 pulls AngleSharp 1.4.0, which carries GHSA-pgww-w46g-26qg (NU1902).
         Pinned forward (explicit reference in the test project); drop once bunit ships a newer transitive. -->
    <PackageVersion Include="AngleSharp" Version="1.7.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>
</Project>
