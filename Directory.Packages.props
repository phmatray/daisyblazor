<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Sample / template app -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.14" />
  </ItemGroup>

  <!-- Libraries (Server and WebAssembly compatible: no Microsoft.AspNetCore.App framework reference) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Jint" Version="4.17.0" />
  </ItemGroup>

  <!-- Documentation site (Blazor WebAssembly) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" />
  </ItemGroup>

  <!-- Testing (bUnit + xUnit v3) -->
  <ItemGroup>
    <PackageVersion Include="bunit" Version="2.12.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>
</Project>
