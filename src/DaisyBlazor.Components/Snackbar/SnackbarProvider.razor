@namespace DaisyBlazor
@implements IDisposable
@inject ISnackbar Snackbar

@* MudSnackbarProvider replacement. Renders queued toasts bottom-end and auto-dismisses each
   after its VisibleStateDuration (paused while the toast is hovered or focused, WCAG 2.2.1).
   Place once in MainLayout (or App). The container is the single live region: it turns
   assertive while an error/warning is shown, polite otherwise; toasts carry no role of their
   own so each message is announced once. *@

<div class="@CssClass.Merge("toast toast-end toast-bottom z-50", Class)"
     style="@Style"
     aria-live="@Politeness"
     @attributes="UserAttributes">
    @foreach (SnackbarMessage message in Snackbar.Shown)
    {
        <div class="@ToastClass(message)" @key="message.Id"
             @onmouseenter="() => Pause(message, hover: true)"
             @onmouseleave="() => Resume(message, hover: true)"
             @onfocusin="() => Pause(message, hover: false)"
             @onfocusout="() => Resume(message, hover: false)">
            <Icon Name="@SeverityIcon(message.Severity)" Size="Size.Small" Class="@(IsTinted(message) ? Alert.Tint(message.Severity) : null)" />
            <span>@message.Message</span>
            @if (message.Options.ShowCloseIcon)
            {
                <button type="button"
                        class="btn btn-ghost btn-xs btn-circle"
                        aria-label="@CloseLabel"
                        @onclick="() => Snackbar.Remove(message)">
                    <Icon Name="@Icons.Material.Filled.Close" Size="Size.Small" />
                </button>
            }
        </div>
    }
</div>

@code {
    /// <summary>Extra CSS classes merged onto the root toast container element.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline CSS styles applied to the root toast container element.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    /// <summary>Accessible label of each toast's close button. Override to localise; defaults to "Close".</summary>
    [Parameter] public string CloseLabel { get; set; } = "Close";

    /// <summary>
    /// Default alert style of every toast: Filled (default) is solid, Outlined adds <c>alert-outline</c>,
    /// Text adds <c>alert-soft</c>. A message overrides it with <see cref="SnackbarOptions.Variant"/>.
    /// </summary>
    [Parameter] public Variant Variant { get; set; } = Variant.Filled;

    /// <summary>Extra CSS classes merged onto every toast's alert element. Per message, use <see cref="SnackbarOptions.Class"/>.</summary>
    [Parameter] public string? AlertClass { get; set; }

    // Auto-dismiss state per toast: the countdown is cancelled while hovered/focused and resumes
    // with the remaining time once neither applies.
    private sealed class DismissTimer
    {
        public CancellationTokenSource? Cts;
        public long StartedAt;
        public int RemainingMs;
        public bool Hovered;
        public bool Focused;
    }

    private readonly Dictionary<Guid, DismissTimer> _timers = [];

    private string Politeness =>
        Snackbar.Shown.Any(m => m.Severity is Severity.Error or Severity.Warning) ? "assertive" : "polite";

    protected override void OnInitialized()
    {
        Snackbar.OnChange += HandleChange;
    }

    private void HandleChange()
    {
        InvokeAsync(() =>
        {
            ScheduleDismissals();
            StateHasChanged();
        });
    }

    private void ScheduleDismissals()
    {
        IReadOnlyList<SnackbarMessage> shown = Snackbar.Shown;
        foreach (Guid gone in _timers.Keys.Where(id => shown.All(m => m.Id != id)).ToArray())
        {
            _timers[gone].Cts?.Cancel();
            _timers.Remove(gone);
        }

        foreach (SnackbarMessage message in shown)
        {
            if (_timers.ContainsKey(message.Id))
            {
                continue;
            }

            DismissTimer timer = new()
            {
                RemainingMs = message.Options.VisibleStateDuration > 0 ? message.Options.VisibleStateDuration : 5000
            };
            _timers[message.Id] = timer;
            Start(message, timer);
        }
    }

    private void Start(SnackbarMessage message, DismissTimer timer)
    {
        timer.Cts = new CancellationTokenSource();
        timer.StartedAt = Environment.TickCount64;
        _ = DismissAfterAsync(message, timer.RemainingMs, timer.Cts.Token);
    }

    private void Pause(SnackbarMessage message, bool hover)
    {
        if (!_timers.TryGetValue(message.Id, out DismissTimer? timer))
        {
            return;
        }

        timer.Hovered |= hover;
        timer.Focused |= !hover;

        if (timer.Cts is not null)
        {
            timer.Cts.Cancel();
            timer.Cts = null;
            timer.RemainingMs -= (int)(Environment.TickCount64 - timer.StartedAt);
        }
    }

    private void Resume(SnackbarMessage message, bool hover)
    {
        if (!_timers.TryGetValue(message.Id, out DismissTimer? timer))
        {
            return;
        }

        timer.Hovered &= !hover;
        timer.Focused &= hover;

        if (timer.Cts is null && !timer.Hovered && !timer.Focused)
        {
            // Leave a moment to finish reading rather than vanishing the instant the pointer leaves.
            timer.RemainingMs = Math.Max(timer.RemainingMs, 1000);
            Start(message, timer);
        }
    }

    private async Task DismissAfterAsync(SnackbarMessage message, int delayMs, CancellationToken token)
    {
        try
        {
            await Task.Delay(delayMs, token);
            Snackbar.Remove(message);
        }
        catch (TaskCanceledException)
        {
            // Paused or removed.
        }
    }

    private Variant VariantOf(SnackbarMessage message) => message.Options.Variant ?? Variant;

    // Same contrast rule as Alert: outlined/soft toasts keep base-content text and tint only the icon.
    private bool IsTinted(SnackbarMessage message) =>
        VariantOf(message) is Variant.Outlined or Variant.Text && Alert.Tint(message.Severity) is not null;

    private string ToastClass(SnackbarMessage message) => CssClass.Merge(
        "alert",
        CssClass.AlertSeverity(message.Severity),
        Alert.VariantClass(VariantOf(message)),
        IsTinted(message) ? "text-base-content" : null,
        "shadow-lg",
        AlertClass,
        message.Options.Class);

    private static string SeverityIcon(Severity severity) => severity switch
    {
        Severity.Normal => Icons.Material.Filled.Notifications,
        _ => Alert.SeverityIcon(severity)
    };

    public void Dispose()
    {
        Snackbar.OnChange -= HandleChange;
        foreach (DismissTimer timer in _timers.Values)
        {
            timer.Cts?.Cancel();
        }
    }
}
