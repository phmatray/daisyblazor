@namespace DaisyBlazor.Layout

@* PageHeader: title + optional subtitle on the left, optional action slot on the right. *@

@* Wrap so the actions drop below the title on narrow screens instead of overflowing. *@
<Stack Row="true" Wrap="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center"
       Class="@Class" Style="@Style" @attributes="UserAttributes">
    <Stack Spacing="0" Class="min-w-0">
        <Typography Typo="@(Typo.h1 + Math.Clamp(HeadingLevel, 1, 6) - 1)" Look="@TitleTypo" Class="@CssClass.Merge(string.IsNullOrEmpty(Icon) ? null : "flex items-center gap-2", TitleClass)">
            @if (!string.IsNullOrEmpty(Icon))
            {
                <Icon Name="@Icon" />
            }
            @Title
        </Typography>
        @if (Subtitle is not null)
        {
            <Typography Typo="Typo.body2" Color="@SubtitleColor" Class="@SubtitleClass">@Subtitle</Typography>
        }
    </Stack>
    @if (Actions is not null)
    {
        <Stack Row="true" Wrap="true" Spacing="2" AlignItems="AlignItems.Center">
            @Actions
        </Stack>
    }
</Stack>
