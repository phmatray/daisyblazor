@namespace DaisyBlazor.Layout

@* DetailCard: a SectionCard whose body is a dense, hoverable label/value table.
   Pair with DetailRow. The chrome (surface, icon+title header) lives in SectionCard so
   the two cannot drift apart; use SectionCard directly for a free-form body. *@

<SectionCard Title="@Title"
             Icon="@Icon"
             Elevation="@Elevation"
             ShowDivider="false"
             Class="@Class"
             Style="@Style"
             @attributes="UserAttributes">
    <SimpleTable Dense="@Dense" Hover="true">
        <tbody>
            @ChildContent
        </tbody>
    </SimpleTable>
</SectionCard>
