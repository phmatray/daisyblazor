@namespace DaisyBlazor
@using Microsoft.AspNetCore.Components.Rendering
@implements IDisposable
@inject IDialogService DialogService
@inject IJSRuntime JS

@* Host for IDialogService. Mount once near the app root. Renders each shown dialog inside a
   daisyUI <dialog class="modal" open> + .modal-box, cascading an IMudDialogInstance. Once
   interactive, dialog.js promotes it to a real modal via showModal() (focus moved in, background
   inert, Escape) and restores focus to the opener on close. Without JS (prerender) the open
   <dialog> still renders and Escape is handled by the keydown fallback. *@

@foreach (DialogReference dialog in _dialogs)
{
    <dialog class="modal modal-open" open @key="dialog.Id" @ref="_elements[dialog.Id]"
            @oncancel="@(() => OnEscape(dialog))" @oncancel:preventDefault
            @onkeydown="@(e => OnKeyDown(e, dialog))">
        <div class="@ModalBoxCss(dialog)"
             role="@Role(dialog)"
             tabindex="-1"
             aria-modal="true"
             aria-labelledby="@dialog.TitleId"
             aria-label="@AriaLabel(dialog)">
            @if (ShowCloseButton(dialog))
            {
                <button type="button"
                        class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2"
                        @onclick="@(() => dialog.Cancel())"
                        aria-label="@CloseLabel">
                    <Icon Name="@Icons.Material.Filled.Close" Size="Size.Small" />
                </button>
            }
            <CascadingValue Value="@((IMudDialogInstance)dialog)" IsFixed="true">
                @RenderDialogContent(dialog)
            </CascadingValue>
        </div>
        <form method="dialog" class="modal-backdrop" @onclick="@(() => OnBackdrop(dialog))">
            <button type="button" tabindex="-1" aria-hidden="true">@CloseLabel</button>
        </form>
    </dialog>
}

@code {
    /// <summary>Accessible label of the close (x) button. Override to localise; defaults to "Close".</summary>
    [Parameter] public string CloseLabel { get; set; } = "Close";

    private readonly List<DialogReference> _dialogs = [];
    private readonly Dictionary<Guid, ElementReference> _elements = [];
    private readonly HashSet<Guid> _opened = [];
    private IJSObjectReference? _module;

    protected override void OnInitialized()
    {
        DialogService.OnDialogShown += HandleShown;
    }

    public void Dispose()
    {
        DialogService.OnDialogShown -= HandleShown;
        _ = DisposeModuleAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        foreach (DialogReference dialog in _dialogs.ToArray())
        {
            if (_elements.TryGetValue(dialog.Id, out ElementReference element) && _opened.Add(dialog.Id))
            {
                await InvokeJsAsync("open", element);
            }
        }
    }

    private void HandleShown(DialogReference reference)
    {
        reference.OnClose += HandleClosed;
        _dialogs.Add(reference);
        InvokeAsync(StateHasChanged);
    }

    private void HandleClosed(DialogReference reference)
    {
        reference.OnClose -= HandleClosed;
        InvokeAsync(async () =>
        {
            // Close the native modal first so focus can return to the opener (the rest of the
            // page is inert while it is open), then drop it from the render tree. The id stays in
            // _opened until then: a render in between (the close button / Escape handler re-renders
            // the provider) must not see it as new and showModal() it again (#97).
            if (_opened.Contains(reference.Id) && _elements.TryGetValue(reference.Id, out ElementReference element))
            {
                await InvokeJsAsync("close", element);
            }

            _opened.Remove(reference.Id);
            _dialogs.Remove(reference);
            _elements.Remove(reference.Id);
            StateHasChanged();
        });
    }

    private void OnEscape(DialogReference dialog)
    {
        if (dialog.Options.CloseOnEscapeKey != false)
        {
            dialog.Cancel();
        }
    }

    private void OnKeyDown(KeyboardEventArgs e, DialogReference dialog)
    {
        if (e.Key == "Escape")
        {
            OnEscape(dialog);
        }
    }

    private async Task InvokeJsAsync(string identifier, ElementReference element)
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/DaisyBlazor.Components/dialog.js");
            await _module.InvokeVoidAsync(identifier, element);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException or JSException)
        {
            // Prerender / disconnected circuit / JS unavailable: the inline <dialog open> fallback stays.
        }
    }

    private async Task DisposeModuleAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private void OnBackdrop(DialogReference dialog)
    {
        if (dialog.Options.BackdropClick != false)
        {
            dialog.Cancel();
        }
    }

    private static bool ShowCloseButton(DialogReference dialog) =>
        dialog.Options.CloseButton == true;

    // aria-labelledby points at the title Dialog.razor renders (id = TitleId). aria-label is only
    // the fallback for hosted components that render no Dialog title (an unresolved
    // aria-labelledby is ignored by the accessible-name computation).
    private static string? AriaLabel(DialogReference dialog) =>
        string.IsNullOrEmpty(dialog.Title) ? null : dialog.Title;

    // Confirmations (MessageBoxDialog, ConfirmDialog) are alertdialogs unless the caller says otherwise.
    private static string Role(DialogReference dialog) =>
        dialog.Options.AlertDialog
        ?? (dialog.ComponentType == typeof(MessageBoxDialog) || dialog.ComponentType == typeof(ConfirmDialog))
            ? "alertdialog"
            : "dialog";

    private static string ModalBoxCss(DialogReference dialog) => CssClass.Merge(
        "modal-box relative focus:outline-none",
        MaxWidthCss(dialog.Options.MaxWidth),
        dialog.Options.FullWidth == true ? "w-full" : null,
        // Keep a long title clear of the absolutely positioned close (x) button.
        ShowCloseButton(dialog) ? "[&_[id$=-title]]:pr-8" : null);

    // .modal-box already caps at 32rem, so every step sits above it and scales up roughly like
    // MudBlazor's breakpoints (sm 600px, md 960px, lg 1280px, xl 1920px).
    private static string? MaxWidthCss(MaxWidth? maxWidth) => maxWidth switch
    {
        MaxWidth.Small => "max-w-xl",
        MaxWidth.Medium => "max-w-4xl",
        MaxWidth.Large => "max-w-6xl",
        MaxWidth.ExtraLarge => "max-w-7xl",
        MaxWidth.ExtraExtraLarge => "max-w-full",
        _ => null
    };

    private RenderFragment RenderDialogContent(DialogReference dialog) => builder =>
    {
        builder.OpenComponent(0, dialog.ComponentType);
        int sequence = 1;
        foreach (KeyValuePair<string, object?> parameter in dialog.Parameters)
        {
            if (parameter.Value is not null)
            {
                builder.AddAttribute(sequence++, parameter.Key, parameter.Value);
            }
        }

        builder.CloseComponent();
    };
}
