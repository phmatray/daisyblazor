@namespace DaisyBlazor

@* MudDialog replacement. Renders title / body / actions sections inside the modal-box that the
   DialogProvider establishes. Reads the cascaded IMudDialogInstance for the title fallback. *@

@if (TitleContent is not null)
{
    <div id="@_titleId" class="@_titleCls">
        @TitleContent
    </div>
}
else if (!string.IsNullOrEmpty(_title))
{
    <h3 id="@_titleId" class="@_titleCls">@_title</h3>
}

<div class="@_bodyCls">
    @DialogContent
    @ChildContent
</div>

@if (_actions is not null)
{
    <div class="modal-action mt-6">
        @_actions
    </div>
}

@code {
    [CascadingParameter] private IMudDialogInstance? DialogInstance { get; set; }

    /// <summary>Custom title markup; takes precedence over <see cref="Title"/>.</summary>
    [Parameter] public RenderFragment? TitleContent { get; set; }
    /// <summary>Dialog body content, rendered before <see cref="ChildContent"/>.</summary>
    [Parameter] public RenderFragment? DialogContent { get; set; }
    /// <summary>Additional body content, rendered after <see cref="DialogContent"/>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Footer actions. <c>DialogActions</c> matches the MudBlazor child-content name;
    /// <c>Actions</c> is supported as an alias.</summary>
    [Parameter] public RenderFragment? DialogActions { get; set; }
    /// <summary>Alias for <see cref="DialogActions"/>, used only when DialogActions is not set.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>Title text; falls back to the title passed to the dialog service when empty.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Extra CSS classes applied to the title element only.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Accepted for API compatibility; currently not rendered anywhere.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    private string? _title => !string.IsNullOrEmpty(Title) ? Title : DialogInstance?.Title;

    private string? _titleId => (DialogInstance as DialogReference)?.TitleId;

    private RenderFragment? _actions => DialogActions ?? Actions;

    private string _titleCls => CssClass.Merge("font-heading text-lg font-semibold", Class);

    private string _bodyCls => "py-2 text-base-content";
}
