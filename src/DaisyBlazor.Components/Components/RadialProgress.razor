@namespace DaisyBlazor
@using System.Globalization

@* daisyUI .radial-progress driven by CSS custom properties: --value, --size, --thickness.
   Color is applied via text-{token}. role=progressbar with aria-valuenow/min/max. *@

<div class="@_cls" style="@_style" role="progressbar"
     aria-valuenow="@_valueText" aria-valuemin="0" aria-valuemax="100"
     aria-label="@AriaLabel"
     @attributes="UserAttributes">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @* Scales with the ring so small sizes do not collide with the stroke; 5rem keeps 1rem. *@
        <span style="font-size:calc(var(--size) / 5)">@($"{Math.Round(_value).ToString(CultureInfo.InvariantCulture)}%")</span>
    }
</div>

@code {
    /// <summary>Progress value between 0 and 100 (clamped). Maps to the CSS --value custom property.</summary>
    [Parameter] public double Value { get; set; }

    /// <summary>
    /// CSS size of the radial element (e.g. "5rem", "80px"). Maps to the CSS --size custom property.
    /// Defaults to "5rem".
    /// </summary>
    [Parameter] public string? SizeRem { get; set; } = "5rem";

    /// <summary>
    /// CSS thickness of the progress ring (e.g. "4px", "0.5rem"). Maps to the CSS --thickness custom property.
    /// When null the daisyUI default thickness is used.
    /// </summary>
    [Parameter] public string? Thickness { get; set; }

    /// <summary>Color token for the ring and label text (maps to text-primary, text-success, etc.).</summary>
    [Parameter] public Color Color { get; set; } = Color.Default;

    /// <summary>Accessible name of the progressbar (aria-label), e.g. "Storage used".</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Custom inner content; defaults to the rounded "@Value%" when not provided.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Extra CSS classes merged onto the .radial-progress element.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline CSS appended after the --value/--size/--thickness custom properties.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    private double _value => double.IsNaN(Value) ? 0 : Math.Clamp(Value, 0, 100);

    // Invariant so fr-FR does not write "--value:44,5", which breaks the ring.
    private string _valueText => _value.ToString(CultureInfo.InvariantCulture);

    private string _cls
    {
        get
        {
            // Dark/Surface would map to neutral, which is close to base-100 on dark themes and
            // makes the ring vanish; base-content stays readable on all of them.
            string? token = Color is Color.Dark or Color.Surface ? "base-content" : CssClass.ColorToken(Color);
            string? colorClass = token is { } t ? $"text-{t}" : null;
            return CssClass.Merge("radial-progress", colorClass, Class);
        }
    }

    private string _style
    {
        get
        {
            string cssVars = $"--value:{_valueText};";

            string size = string.IsNullOrEmpty(SizeRem) ? "5rem" : SizeRem!;
            cssVars += $"--size:{size};";

            // daisyUI draws rounded end caps even at 0%; a zero thickness hides that stray dot.
            if (_value <= 0)
            {
                cssVars += "--thickness:0px;";
            }
            else if (!string.IsNullOrEmpty(Thickness))
            {
                cssVars += $"--thickness:{Thickness};";
            }

            if (!string.IsNullOrEmpty(Style))
            {
                cssVars += Style;
            }

            return cssVars;
        }
    }
}
