@namespace DaisyBlazor

@* MudCheckBox replacement. daisyUI .checkbox. Supports Value/ValueChanged (bool) and the
   MudBlazor alias Checked/CheckedChanged, with an optional Label + ChildContent.
   Non-generic on purpose, matching Switch: a checkbox is only ever ticked or not, so a type
   parameter bought nothing but a mandatory T="bool" on every call site. *@

<label class="@_labelCls" style="@Style">
    <input type="checkbox"
           class="@_cls"
           checked="@_checked"
           disabled="@Disabled"
           readonly="@ReadOnly"
           @onchange="OnChange"
           @attributes="UserAttributes" />
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="label-text">@Label</span>
    }
    @ChildContent
</label>

@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public bool Checked { get; set; }
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public Color Color { get; set; } = Color.Default;
    [Parameter] public Size Size { get; set; } = Size.Medium;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    @* `Checked` is the MudBlazor-style alias for `Value`. A non-nullable bool can no longer signal
       "unset", so opting into the alias means wiring CheckedChanged or passing Checked="true" —
       Checked="false" alone falls through to Value, which renders identically either way. *@
    private bool _usesChecked => CheckedChanged.HasDelegate || (Checked && !ValueChanged.HasDelegate);

    private bool _checked => _usesChecked ? Checked : Value;

    private string _labelCls => CssClass.Merge("flex items-center gap-2 cursor-pointer", Class);

    private string _colorCls => Color switch
    {
        Color.Primary => "checkbox-primary",
        Color.Secondary => "checkbox-secondary",
        Color.Tertiary => "checkbox-accent",
        Color.Info => "checkbox-info",
        Color.Success => "checkbox-success",
        Color.Warning => "checkbox-warning",
        Color.Error => "checkbox-error",
        _ => ""
    };

    private string _sizeCls => Size switch
    {
        Size.Small => "checkbox-sm",
        Size.Large => "checkbox-lg",
        _ => ""
    };

    private string _cls => CssClass.Merge("checkbox", _colorCls, _sizeCls);

    private async Task OnChange(ChangeEventArgs args)
    {
        if (ReadOnly || Disabled)
        {
            return;
        }

        bool isChecked = args.Value is bool b && b;

        if (_usesChecked)
        {
            Checked = isChecked;
            await CheckedChanged.InvokeAsync(isChecked);
        }
        else
        {
            Value = isChecked;
            await ValueChanged.InvokeAsync(isChecked);
        }
    }
}
