@namespace DaisyBlazor

@* Individual tab within a <Tabs> container. Registers with the cascaded Tabs parent
   on init and unregisters on dispose. The tab button and content panel are rendered
   by the parent; this component only holds metadata and ChildContent. *@

@implements IDisposable

@code {
    [CascadingParameter] private Tabs? Parent { get; set; }

    /// <summary>Text label shown in the tab button. When <see cref="TitleContent"/> is set, it becomes the button's
    /// <c>aria-label</c> instead (so include anything screen readers should hear, e.g. a count).</summary>
    [Parameter] public string Title { get; set; } = string.Empty;

    /// <summary>Rich tab button content (icon, count badge...) rendered in place of <see cref="Title"/>.</summary>
    [Parameter] public RenderFragment? TitleContent { get; set; }

    /// <summary>When true the tab button is rendered as disabled and is not selectable.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Content displayed in the tab panel when this tab is active.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Extra CSS classes merged onto this tab's button.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline CSS style applied to this tab's button.</summary>
    [Parameter] public string? Style { get; set; }
    /// <summary>Extra attributes splatted onto this tab's button.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    protected override void OnInitialized()
    {
        Parent?.RegisterTab(this);
    }

    public void Dispose()
    {
        Parent?.UnregisterTab(this);
    }
}
