@namespace DaisyBlazor

@* MudSimpleTable replacement. Wraps raw <thead>/<tbody> (or Tr/Th/Td) in a daisyUI .table. *@

<div class="@_wrapCls" style="@Style" @attributes="UserAttributes">
    <table class="@_cls">
        @ChildContent
    </table>
</div>

@code {
    /// <summary>Table markup (<c>&lt;thead&gt;</c>/<c>&lt;tbody&gt;</c> or Tr/Th/Td) rendered inside the <c>.table</c>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Adds <c>table-sm</c> for compact rows.</summary>
    [Parameter] public bool Dense { get; set; }
    /// <summary>Highlights body rows on hover: <c>bg-base-200</c>, or <c>bg-base-300</c> when <see cref="Striped"/> (zebra rows are already base-200).</summary>
    [Parameter] public bool Hover { get; set; }
    /// <summary>Adds <c>table-zebra</c> for alternating row backgrounds.</summary>
    [Parameter] public bool Striped { get; set; }
    /// <summary>Adds a <c>border border-base-300</c> outline around the table.</summary>
    [Parameter] public bool Bordered { get; set; }
    /// <summary>Caps the wrapper height at <c>max-h-96</c> with vertical scrolling and pins the header (<c>table-pin-rows</c>).</summary>
    [Parameter] public bool FixedHeader { get; set; }
    /// <summary>Extra CSS classes merged onto the <c>&lt;table&gt;</c> element.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline CSS style applied to the scrolling wrapper <c>&lt;div&gt;</c>.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    private string _wrapCls => CssClass.Merge(
        "overflow-x-auto",
        FixedHeader ? "max-h-96 overflow-y-auto" : null);

    @* Rows are caller markup, so daisyUI's per-row row-hover can't be added; mirror it at table
       scope instead, stepping up to base-300 on zebra tables like row-hover does. *@
    private string _cls => CssClass.Merge(
        "table",
        Dense ? "table-sm" : null,
        FixedHeader ? "table-pin-rows" : null,
        Hover ? (Striped ? "[&_tbody_tr:hover]:bg-base-300" : "[&_tbody_tr:hover]:bg-base-200") : null,
        Striped ? "table-zebra" : null,
        Bordered ? "border border-base-300" : null,
        Class);
}
