@namespace DaisyBlazor
@using System.Linq.Expressions
@implements IFormField
@implements IDisposable

@* MudTextField replacement. daisyUI .input / .textarea inside a .fieldset with a .label.
   Supports adornments, helper/error text, multi-line (Lines > 1 => textarea). *@

<div class="@_fieldsetCls" style="@Style">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="label" for="@_id">
            <span class="label-text">@Label@(Required ? " *" : null)</span>
        </label>
    }

    @if (Lines > 1)
    {
        <textarea class="@_textareaCls"
                  placeholder="@Placeholder"
                  rows="@Lines"
                  disabled="@Disabled"
                  readonly="@ReadOnly"
                  required="@Required"
                  value="@Value"
                  @oninput="OnInput"
                  @onkeyup="OnKeyUpHandler"
                  id="@_id"
                  aria-invalid="@(_hasError ? "true" : null)"
                  aria-describedby="@_describedBy"
                  @attributes="UserAttributes"></textarea>
    }
    else if (Clearable || (Adornment != Adornment.None && (!string.IsNullOrEmpty(AdornmentIcon) || !string.IsNullOrEmpty(AdornmentText))))
    {
        <label class="@_inputWrapperCls">
            @if (Adornment == Adornment.Start)
            {
                @AdornmentInner
            }
            <input type="@_htmlType"
                   class="grow"
                   placeholder="@Placeholder"
                   disabled="@Disabled"
                   readonly="@ReadOnly"
                   required="@Required"
                   value="@Value"
                   @oninput="OnInput"
                   @onkeyup="OnKeyUpHandler"
                   id="@_id"
                   aria-invalid="@(_hasError ? "true" : null)"
                   aria-describedby="@_describedBy"
                   @attributes="UserAttributes" />
            @if (Clearable && !string.IsNullOrEmpty(Value) && !Disabled && !ReadOnly)
            {
                <button type="button" class="btn btn-ghost btn-xs btn-circle" @onclick="ClearAsync" tabindex="-1" aria-label="Clear">
                    <Icon Name="@Icons.Material.Filled.Clear" Size="Size.Small" />
                </button>
            }
            @if (Adornment == Adornment.End)
            {
                @AdornmentInner
            }
        </label>
    }
    else
    {
        <input type="@_htmlType"
               class="@_inputCls"
               placeholder="@Placeholder"
               disabled="@Disabled"
               readonly="@ReadOnly"
               required="@Required"
               value="@Value"
               @oninput="OnInput"
               @onkeyup="OnKeyUpHandler"
               id="@_id"
               aria-invalid="@(_hasError ? "true" : null)"
               aria-describedby="@_describedBy"
               @attributes="UserAttributes" />
    }

    @if (_showError)
    {
        <span id="@_helpId" class="label-text text-error text-xs mt-1">@_errorText</span>
    }
    else if (!string.IsNullOrEmpty(HelperText))
    {
        <span id="@_helpId" class="label-text text-xs opacity-70 mt-1">@HelperText</span>
    }
</div>

@code {
    private readonly string _generatedId = FieldId.New();
    private string _id => FieldId.Resolve(UserAttributes, _generatedId);

    /// <summary>The current text value; bind with <c>@bind-Value</c>.</summary>
    [Parameter] public string? Value { get; set; }
    /// <summary>Raised on every keystroke (the <c>input</c> event) with the new text.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    /// <summary>Label text rendered above the field; an asterisk is appended when Required.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Placeholder text shown when the field is empty.</summary>
    [Parameter] public string? Placeholder { get; set; }
    /// <summary>Outlined (default) draws the daisyUI border; Filled adds a bg-base-200 background; Text renders a borderless ghost field (input-ghost).</summary>
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    /// <summary>Margin.Dense renders the small size (input-sm), same as Dense; defaults to Normal.</summary>
    [Parameter] public Margin Margin { get; set; } = Margin.Normal;
    /// <summary>When true renders the small size (input-sm / textarea-sm).</summary>
    [Parameter] public bool Dense { get; set; }
    /// <summary>Disables the input or textarea.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Makes the input or textarea read-only.</summary>
    [Parameter] public bool ReadOnly { get; set; }
    /// <summary>Sets the HTML required attribute and appends an asterisk to the label.</summary>
    [Parameter] public bool Required { get; set; }
    /// <summary>Message shown when an enclosing <see cref="Form"/> validates this Required field while it is empty. Defaults to "Required".</summary>
    [Parameter] public string? RequiredError { get; set; }
    /// <summary>Checked by an enclosing <see cref="Form"/>: <c>Func&lt;string?, string?&gt;</c> (error or null), <c>Func&lt;string?, bool&gt;</c> or <c>Func&lt;string?, IEnumerable&lt;string&gt;&gt;</c>.</summary>
    [Parameter] public object? Validation { get; set; }
    /// <summary>Accepted for MudBlazor compatibility; currently has no effect (value always updates on each keystroke).</summary>
    [Parameter] public bool Immediate { get; set; }
    /// <summary>Raised on each keyup event in the field.</summary>
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyUp { get; set; }
    /// <summary>When true (default) the field and its fieldset span the full width (w-full).</summary>
    [Parameter] public bool FullWidth { get; set; } = true;
    /// <summary>Renders a clear button inside a single-line input while it has a value (not on multi-line, disabled or read-only fields).</summary>
    [Parameter] public bool Clearable { get; set; }
    /// <summary>Number of visible rows; values above 1 render a textarea instead of an input. Defaults to 1.</summary>
    [Parameter] public int Lines { get; set; } = 1;
    /// <summary>Where AdornmentIcon/AdornmentText render: Start or End inside the input; None (default) hides them.</summary>
    [Parameter] public Adornment Adornment { get; set; } = Adornment.None;
    /// <summary>Icon name rendered as the adornment at the Adornment position.</summary>
    [Parameter] public string? AdornmentIcon { get; set; }
    /// <summary>Text rendered as the adornment at the Adornment position.</summary>
    [Parameter] public string? AdornmentText { get; set; }
    /// <summary>Hint text shown below the field when there is no error message.</summary>
    [Parameter] public string? HelperText { get; set; }
    /// <summary>When true applies the error style (input-error / textarea-error).</summary>
    [Parameter] public bool Error { get; set; }
    /// <summary>Error message shown below the field (in place of HelperText) when the field is in error.</summary>
    [Parameter] public string? ErrorText { get; set; }

    /// <summary>
    /// Field name used to pick up a server-side error from an enclosing
    /// <see cref="DaisyBlazor.Validation.ServerValidation"/>. Deliberately NOT called <c>Name</c>:
    /// a parameter called <c>Name</c> would capture the HTML <c>name</c> attribute instead of
    /// letting it splat through, silently breaking form posts.
    /// </summary>
    [Parameter] public string? FieldName { get; set; }

    [CascadingParameter] private ServerValidationState? ServerValidation { get; set; }
    [CascadingParameter] private Form? Form { get; set; }
    private string? _validationError;

    protected override void OnInitialized() => Form?.Register(this);
    public void Dispose() => Form?.Unregister(this);
    string? IFormField.GetError() => FormValidation.Run(Form, Required, RequiredError, Validation, Value, FieldName);
    void IFormField.ShowError(string? error)
    {
        _validationError = error;
        StateHasChanged();
    }

    /// <summary>HTML input type to render (text, password, email, number, date, ...). Defaults to Text.</summary>
    [Parameter] public InputType InputType { get; set; } = InputType.Text;
    /// <summary>Validation expression (MudBlazor compat; not used for HTML rendering).</summary>
    [Parameter] public object? For { get; set; }
    /// <summary>Accepted for MudBlazor compatibility; currently has no effect (no masking is applied).</summary>
    [Parameter] public object? Mask { get; set; }

    /// <summary>Extra CSS classes merged onto the outer fieldset.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline CSS styles applied to the outer fieldset.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    private bool _isDense => Dense || Margin == Margin.Dense;

    // An explicit Error/ErrorText always wins; the cascaded server state only fills the gap.
    // That keeps every existing usage byte-identical when no ServerValidation is present.
    private string? _serverError => FieldName is null ? null : ServerValidation?.FirstErrorFor(FieldName);

    private bool _hasError => Error || _validationError is not null || _serverError is not null;

    private string? _errorText => ErrorText ?? _validationError ?? _serverError;

    private bool _showError => _hasError && !string.IsNullOrEmpty(_errorText);
    private string _helpId => _id + "-help";
    private string? _describedBy => _showError || !string.IsNullOrEmpty(HelperText) ? _helpId : null;

    private string _htmlType => InputType switch
    {
        InputType.Password => "password",
        InputType.Email => "email",
        InputType.Number => "number",
        InputType.Search => "search",
        InputType.Telephone => "tel",
        InputType.Url => "url",
        InputType.Date => "date",
        InputType.DateTimeLocal => "datetime-local",
        InputType.Month => "month",
        InputType.Time => "time",
        InputType.Week => "week",
        InputType.Color => "color",
        _ => "text"
    };

    private string _fieldsetCls => CssClass.Merge(
        "fieldset",
        FullWidth ? "w-full" : null,
        Class);

    private string _inputCls => CssClass.Merge(
        "input",
        Variant == Variant.Outlined ? "input-bordered" : null,
        Variant == Variant.Filled ? "input-bordered bg-base-200" : null,
        Variant == Variant.Text ? "input-ghost" : null,
        _isDense ? "input-sm" : null,
        FullWidth ? "w-full" : null,
        _hasError ? "input-error" : null);

    private string _inputWrapperCls => CssClass.Merge(
        "input",
        Variant == Variant.Outlined ? "input-bordered" : null,
        Variant == Variant.Filled ? "input-bordered bg-base-200" : null,
        Variant == Variant.Text ? "input-ghost" : null,
        _isDense ? "input-sm" : null,
        FullWidth ? "w-full" : null,
        _hasError ? "input-error" : null,
        "flex items-center gap-2");

    private string _textareaCls => CssClass.Merge(
        "textarea",
        Variant == Variant.Outlined ? "textarea-bordered" : null,
        Variant == Variant.Filled ? "textarea-bordered bg-base-200" : null,
        Variant == Variant.Text ? "textarea-ghost" : null,
        _isDense ? "textarea-sm" : null,
        FullWidth ? "w-full" : null,
        _hasError ? "textarea-error" : null);

    private RenderFragment AdornmentInner => @<text>
        @if (!string.IsNullOrEmpty(AdornmentIcon))
        {
            <Icon Name="@AdornmentIcon" Size="Size.Small" />
        }
        @if (!string.IsNullOrEmpty(AdornmentText))
        {
            <span class="opacity-70">@AdornmentText</span>
        }
    </text>;

    private async Task OnInput(ChangeEventArgs args)
    {
        Value = args.Value?.ToString();
        await ValueChanged.InvokeAsync(Value);
        if (Form is not null)
        {
            await Form.FieldChanged(this);
        }
    }

    private async Task ClearAsync()
    {
        Value = null;
        await ValueChanged.InvokeAsync(Value);
        if (Form is not null)
        {
            await Form.FieldChanged(this);
        }
    }

    private async Task OnKeyUpHandler(KeyboardEventArgs args)
    {
        if (OnKeyUp.HasDelegate)
        {
            await OnKeyUp.InvokeAsync(args);
        }
    }
}
