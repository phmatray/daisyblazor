@namespace DaisyBlazor
@typeparam T
@implements IDisposable

@* MudAutocomplete<T> replacement. A text input with a debounced async search dropdown. *@

<div class="form-control w-full @Class" style="@Style">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="label" for="@_id"><span class="label-text">@Label</span></label>
    }
    <div class="dropdown w-full @(_open && (_results.Count > 0 || _searched) ? "dropdown-open" : null)">
        <label class="input input-bordered flex items-center gap-2 w-full @(Dense ? "input-sm" : null) @(Disabled ? "input-disabled" : null)">
            @if (Adornment == Adornment.Start && !string.IsNullOrEmpty(AdornmentIcon))
            {
                <Icon Name="@AdornmentIcon" Size="Size.Small" Class="opacity-60" />
            }
            <input type="text" class="grow bg-transparent outline-none"
                   placeholder="@Placeholder"
                   value="@_text"
                   disabled="@Disabled"
                   @oninput="OnInput"
                   @onfocus="@(() => _open = true)"
                   id="@_id"
                   @attributes="UserAttributes" />
            @if (Clearable && (!string.IsNullOrEmpty(_text) || Value is not null))
            {
                <button type="button" class="btn btn-ghost btn-xs btn-circle" @onclick="ClearAsync" tabindex="-1" aria-label="@ClearAriaLabel">
                    <Icon Name="@Icons.Material.Filled.Clear" Size="Size.Small" />
                </button>
            }
            @if (Adornment == Adornment.End && !string.IsNullOrEmpty(AdornmentIcon))
            {
                <Icon Name="@AdornmentIcon" Size="Size.Small" Class="opacity-60" />
            }
        </label>

        @if (_open)
        {
            <ul class="dropdown-content menu bg-base-100 rounded-box shadow-lg z-50 w-full mt-1 max-h-72 flex-nowrap overflow-y-auto">
                @if (_loading)
                {
                    <li class="disabled"><span class="loading loading-spinner loading-sm"></span></li>
                }
                else if (_results.Count == 0 && _searched)
                {
                    <li class="disabled">
                        @if (NoItemsTemplate is not null)
                        {
                            @NoItemsTemplate
                        }
                        else
                        {
                            <span class="p-2 text-sm opacity-70">@NoItemsText</span>
                        }
                    </li>
                }
                else
                {
                    @foreach (T item in _results)
                    {
                        T captured = item;
                        <li>
                            <button type="button" @onclick="@(() => SelectAsync(captured))">
                                @if (ItemTemplate is not null)
                                {
                                    @ItemTemplate(captured)
                                }
                                else
                                {
                                    @FormatItem(captured)
                                }
                            </button>
                        </li>
                    }
                }
            </ul>
        }
    </div>
    @if (Required && _touched && Value is null)
    {
        <label class="label"><span class="label-text-alt text-error">@RequiredError</span></label>
    }
</div>

@code {
    private readonly string _generatedId = FieldId.New();
    private string _id => FieldId.Resolve(UserAttributes, _generatedId);

    /// <summary>The currently selected item; supports two-way binding with @bind-Value.</summary>
    [Parameter] public T? Value { get; set; }
    /// <summary>Raised when an item is selected, cleared, or reset by emptying the text.</summary>
    [Parameter] public EventCallback<T?> ValueChanged { get; set; }
    /// <summary>Text rendered in a daisyUI label above the input.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Placeholder text shown in the input when it is empty.</summary>
    [Parameter] public string? Placeholder { get; set; }
    /// <summary>Async search invoked with the typed text and a cancellation token; returns the dropdown results.</summary>
    [Parameter] public Func<string, CancellationToken, Task<IEnumerable<T>>>? SearchFunc { get; set; }
    /// <summary>Converts an item to its display text; falls back to ToString() when not set.</summary>
    [Parameter] public Func<T, string>? ToStringFunc { get; set; }
    /// <summary>Accepted for MudBlazor compatibility; currently has no effect (the input is always input-bordered).</summary>
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    /// <summary>Accepted for MudBlazor compatibility; currently has no effect.</summary>
    [Parameter] public Margin Margin { get; set; } = Margin.None;
    /// <summary>Shows a clear button inside the input that empties the text and resets the value.</summary>
    [Parameter] public bool Clearable { get; set; }
    /// <summary>Delay in milliseconds after the last keystroke before searching; defaults to 300.</summary>
    [Parameter] public int DebounceInterval { get; set; } = 300;
    /// <summary>Minimum number of typed characters before the search runs; defaults to 2.</summary>
    [Parameter] public int MinCharacters { get; set; } = 2;
    /// <summary>Maximum number of results shown in the dropdown; defaults to 20.</summary>
    [Parameter] public int MaxItems { get; set; } = 20;
    /// <summary>Renders a smaller input using the daisyUI input-sm class.</summary>
    [Parameter] public bool Dense { get; set; }
    /// <summary>Disables the input and applies the daisyUI input-disabled class.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Shows <see cref="RequiredError"/> once the user has typed and no value is selected.</summary>
    [Parameter] public bool Required { get; set; }
    /// <summary>Error message shown below the input when <see cref="Required"/> is set and no value is selected.</summary>
    [Parameter] public string? RequiredError { get; set; }
    /// <summary>Icon rendered inside the input at the side given by <see cref="Adornment"/>.</summary>
    [Parameter] public string? AdornmentIcon { get; set; }
    /// <summary>Where <see cref="AdornmentIcon"/> is placed (start or end); defaults to none, which hides it.</summary>
    [Parameter] public Adornment Adornment { get; set; } = Adornment.None;
    /// <summary>Clears the selected value when the user deletes all text from the input.</summary>
    [Parameter] public bool ResetValueOnEmptyText { get; set; }
    /// <summary>Accepted for MudBlazor compatibility; currently has no effect.</summary>
    [Parameter] public bool CoerceText { get; set; }
    /// <summary>Accepted for MudBlazor compatibility; currently has no effect.</summary>
    [Parameter] public bool CoerceValue { get; set; }
    /// <summary>Text shown in the dropdown when a search returns no results; defaults to "No items found".</summary>
    [Parameter] public string NoItemsText { get; set; } = "No items found";
    /// <summary>Accessible label for the clear button; defaults to "Clear".</summary>
    [Parameter] public string ClearAriaLabel { get; set; } = "Clear";
    /// <summary>Custom content for each result in the dropdown; defaults to the item's display text.</summary>
    [Parameter] public RenderFragment<T>? ItemTemplate { get; set; }
    /// <summary>Custom content shown when a search returns no results; overrides <see cref="NoItemsText"/>.</summary>
    [Parameter] public RenderFragment? NoItemsTemplate { get; set; }
    /// <summary>Extra CSS classes added to the root form-control element.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline CSS styles applied to the root form-control element.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    private string _text = string.Empty;
    private readonly List<T> _results = [];
    private bool _open;
    private bool _loading;
    private bool _searched;
    private bool _touched;
    private CancellationTokenSource? _debounceCts;

    protected override void OnParametersSet()
    {
        if (Value is not null && string.IsNullOrEmpty(_text))
        {
            _text = FormatItem(Value);
        }
    }

    private string FormatItem(T item) => ToStringFunc?.Invoke(item) ?? item?.ToString() ?? string.Empty;

    private async Task OnInput(ChangeEventArgs args)
    {
        _text = args.Value?.ToString() ?? string.Empty;
        _touched = true;
        _open = true;

        if (ResetValueOnEmptyText && string.IsNullOrEmpty(_text) && Value is not null)
        {
            await SetValueAsync(default);
        }

        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        CancellationToken token = _debounceCts.Token;

        try
        {
            await Task.Delay(DebounceInterval, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await RunSearchAsync(token);
    }

    private async Task RunSearchAsync(CancellationToken token)
    {
        if (SearchFunc is null || _text.Length < MinCharacters)
        {
            _results.Clear();
            _searched = false;
            StateHasChanged();
            return;
        }

        _loading = true;
        StateHasChanged();

        try
        {
            IEnumerable<T> found = await SearchFunc(_text, token);
            if (token.IsCancellationRequested)
            {
                return;
            }

            _results.Clear();
            _results.AddRange(found.Take(MaxItems));
            _searched = true;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task SelectAsync(T item)
    {
        _text = FormatItem(item);
        _open = false;
        _results.Clear();
        await SetValueAsync(item);
    }

    private async Task ClearAsync()
    {
        _text = string.Empty;
        _results.Clear();
        _searched = false;
        await SetValueAsync(default);
    }

    private async Task SetValueAsync(T? value)
    {
        Value = value;
        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(value);
        }
    }

    public void Dispose() => _debounceCts?.Cancel();
}
