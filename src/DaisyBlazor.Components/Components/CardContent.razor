@namespace DaisyBlazor

@* MudCardContent replacement. daisyUI .card-body content region. *@

<div class="@CssClass.Merge("card-body", Class)" style="@Style" @attributes="UserAttributes">
    @ChildContent
</div>

@code {
    /// <summary>Content rendered inside the daisyUI card-body region.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Extra CSS classes merged onto the root element.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline CSS styles applied to the root element.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }
}
