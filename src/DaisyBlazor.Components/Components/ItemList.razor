@namespace DaisyBlazor

@* MudList replacement. daisyUI .menu vertical list; ListItem children render <li>.
   Non-generic on purpose: nothing here ever read the item type, so it only forced a
   T="..." onto every call site — and onto every child, via the cascade it used to declare. *@

<ul class="@_cls" style="@Style" @attributes="UserAttributes">
    @ChildContent
</ul>

@code {
    /// <summary>The <see cref="ListItem"/> entries rendered in the list.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Renders compact items (menu-sm).</summary>
    [Parameter] public bool Dense { get; set; }
    /// <summary>Extra CSS classes added to the menu list.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline CSS style applied to the menu list.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    private string _cls => CssClass.Merge(
        "menu w-full p-0",
        Dense ? "menu-sm" : null,
        Class);
}
