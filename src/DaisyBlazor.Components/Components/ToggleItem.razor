@namespace DaisyBlazor
@typeparam T

@* MudToggleItem<T> replacement. One button of a ToggleGroup segmented control. *@

<button type="button" class="@_cls" aria-pressed="@(_selected ? "true" : "false")" disabled="@(Disabled || (Parent?.Disabled ?? false))"
        @onclick="OnClickHandler" style="@Style" @attributes="UserAttributes">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <Icon Name="@Icon" Size="Size.Small" />
    }
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else if (!string.IsNullOrEmpty(Text))
    {
        <span>@Text</span>
    }
</button>

@code {
    [CascadingParameter] private ToggleGroup<T>? Parent { get; set; }

    /// <summary>Button content; takes precedence over <see cref="Text"/>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Value selected in the parent ToggleGroup when this button is clicked.</summary>
    [Parameter] public T? Value { get; set; }
    /// <summary>Button label shown when <see cref="ChildContent"/> is not set.</summary>
    [Parameter] public string? Text { get; set; }
    /// <summary>Material Symbols ligature rendered small before the label.</summary>
    [Parameter] public string? Icon { get; set; }
    /// <summary>Disables this button; it is also disabled when the parent group is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Additional CSS classes merged onto the <c>join-item btn</c> button.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline styles applied to the button.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    private bool _selected => Parent?.IsSelected(Value) ?? false;

    private string _cls => CssClass.Merge(
        "join-item btn",
        Parent?.SizeClass,
        _selected ? Parent?.ActiveColor : "btn-ghost",
        Class);

    private async Task OnClickHandler()
    {
        if (Parent is not null)
        {
            await Parent.SelectAsync(Value);
        }
    }
}
