@namespace DaisyBlazor

@* MudMenu replacement. daisyUI dropdown: an activator (IconButton, Label button or
   ActivatorContent) toggles a .dropdown-content .menu list of <MenuItem> children.
   Open state is controlled in C# (no JS) so ActivatorContent's menu.ToggleAsync works
   for server rendering. A transparent backdrop closes the menu on outside click. *@

<div class="@_rootCls" style="@Style" @attributes="UserAttributes">
    @if (ActivatorContent is not null)
    {
        @ActivatorContent(_activator)
    }
    else if (!string.IsNullOrEmpty(Icon))
    {
        <IconButton Icon="@Icon" Size="Size" @onclick="ToggleAsync"
                    aria-label="@(AriaLabel ?? Label ?? "Open menu")" aria-haspopup="menu" aria-expanded="@(_open ? "true" : "false")" />
    }
    else
    {
        <button type="button" class="@_labelBtnCls" aria-label="@AriaLabel" aria-haspopup="menu"
                aria-expanded="@(_open ? "true" : "false")" @onclick="ToggleAsync">
            @Label
            <Icon Name="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" />
        </button>
    }

    @if (_open)
    {
        @* Backdrop captures outside clicks to dismiss the menu. *@
        <div class="fixed inset-0 z-[1]" @onclick="CloseAsync"></div>
        <ul tabindex="0" class="@_listCls">
            <CascadingValue Value="this" IsFixed="true">
                @ChildContent
            </CascadingValue>
        </ul>
    }
</div>

@code {
    /// <summary>Material Symbols ligature for the default icon activator.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Text label for the default button activator.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Accessible name for the activator. The icon activator falls back to <see cref="Label"/>, then "Open menu".</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Whether the menu is open. Set it to render the menu expanded; supports <c>@bind-Open</c>.</summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>Raised when the menu opens or closes.</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Size of the default icon and label activators (btn-sm / btn-lg); ignored by custom activators.</summary>
    [Parameter] public Size Size { get; set; } = Size.Medium;
    /// <summary>Renders compact menu items (menu-sm).</summary>
    [Parameter] public bool Dense { get; set; }
    /// <summary>Extra CSS classes added to the dropdown menu list.</summary>
    [Parameter] public string? ListClass { get; set; }
    /// <summary>Dropdown placement: right origins add dropdown-end, top origins add dropdown-top,
    /// CenterLeft / CenterRight open beside the activator (dropdown-left / dropdown-right).</summary>
    [Parameter] public Origin AnchorOrigin { get; set; } = Origin.BottomLeft;
    /// <summary>Which corner of the list sits at the anchor: right origins align the list's right edge
    /// (dropdown-end), center origins centre it (dropdown-center), bottom origins open it upward (dropdown-top).</summary>
    [Parameter] public Origin TransformOrigin { get; set; } = Origin.TopLeft;

    /// <summary>Custom activator markup; receives a context with <c>ToggleAsync</c>.</summary>
    [Parameter] public RenderFragment<MenuActivator>? ActivatorContent { get; set; }

    /// <summary>The <see cref="MenuItem"/> entries shown in the dropdown list.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Extra CSS classes added to the dropdown root.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline CSS style applied to the dropdown root.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    private bool _open;
    private bool _lastOpenParam;
    private MenuActivator _activator = default!;

    protected override void OnInitialized()
    {
        _activator = new MenuActivator(ToggleAsync);
    }

    protected override void OnParametersSet()
    {
        // Only a changed Open parameter overrides the internal state, so unrelated re-renders keep it.
        if (Open != _lastOpenParam)
        {
            _lastOpenParam = Open;
            _open = Open;
        }
    }

    public Task ToggleAsync() => SetOpenAsync(!_open);

    public Task CloseAsync() => SetOpenAsync(false);

    private async Task SetOpenAsync(bool open)
    {
        if (_open == open)
        {
            return;
        }

        _open = open;
        _lastOpenParam = open;
        StateHasChanged();
        await OpenChanged.InvokeAsync(open);
    }

    /// <summary>Called by child MenuItems after activation to dismiss the menu.</summary>
    internal Task NotifyItemClickedAsync() => CloseAsync();

    // CenterLeft / CenterRight anchors open the list beside the activator.
    private string? _sideClass => AnchorOrigin switch
    {
        Origin.CenterLeft => "dropdown-left",
        Origin.CenterRight => "dropdown-right",
        _ => null
    };

    // Anchor on the trigger's right edge, or list pinned by its right edge => dropdown-end;
    // list pinned by its horizontal centre => dropdown-center.
    private string? _alignClass => _sideClass is not null ? null
        : AnchorOrigin is Origin.BottomRight or Origin.TopRight
          || TransformOrigin is Origin.TopRight or Origin.BottomRight ? "dropdown-end"
        : TransformOrigin is Origin.TopCenter or Origin.BottomCenter ? "dropdown-center"
        : null;

    // Anchor on the trigger's top edge, or list pinned by its bottom edge => open upward.
    private string? _openOnTopClass => _sideClass is null
        && (AnchorOrigin is Origin.TopLeft or Origin.TopCenter or Origin.TopRight
            || TransformOrigin is Origin.BottomLeft or Origin.BottomCenter or Origin.BottomRight)
        ? "dropdown-top" : null;

    private string _labelBtnCls => CssClass.Merge("btn btn-ghost gap-1", CssClass.ButtonSize(Size));

    private string _rootCls => CssClass.Merge(
        "dropdown",
        _sideClass,
        _alignClass,
        _openOnTopClass,
        _open ? "dropdown-open" : null,
        Class);

    private string _listCls => CssClass.Merge(
        "dropdown-content menu bg-base-100 rounded-box z-[2] w-56 p-2 shadow-lg",
        Dense ? "menu-sm" : null,
        ListClass);
}
