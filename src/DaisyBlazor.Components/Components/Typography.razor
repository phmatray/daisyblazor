@namespace DaisyBlazor

@* MudText replacement. Renders typography with an appropriate element + classes. *@

@if (_element == "h1")
{
    <h1 class="@_cls" style="@Style" @attributes="UserAttributes">@ChildContent</h1>
}
else if (_element == "h2")
{
    <h2 class="@_cls" style="@Style" @attributes="UserAttributes">@ChildContent</h2>
}
else if (_element == "h3")
{
    <h3 class="@_cls" style="@Style" @attributes="UserAttributes">@ChildContent</h3>
}
else if (_element == "h4")
{
    <h4 class="@_cls" style="@Style" @attributes="UserAttributes">@ChildContent</h4>
}
else if (_element == "h5")
{
    <h5 class="@_cls" style="@Style" @attributes="UserAttributes">@ChildContent</h5>
}
else if (_element == "h6")
{
    <h6 class="@_cls" style="@Style" @attributes="UserAttributes">@ChildContent</h6>
}
else
{
    <p class="@_cls" style="@Style" @attributes="UserAttributes">@ChildContent</p>
}

@code {
    /// <summary>Text style; picks the element (h1–h6 or p) and its typography classes. Defaults to body1.</summary>
    [Parameter] public Typo Typo { get; set; } = Typo.body1;
    /// <summary>Text style when it should differ from the element's (an <c>h1</c> that looks like an <c>h4</c>); null takes the style of <see cref="Typo"/>.</summary>
    [Parameter] public Typo? Look { get; set; }
    /// <summary>Text color class (e.g. <c>text-primary</c>); defaults to Inherit.</summary>
    [Parameter] public Color Color { get; set; } = Color.Inherit;
    /// <summary>Extra CSS classes added to the rendered element.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline styles applied to the rendered element.</summary>
    [Parameter] public string? Style { get; set; }
    /// <summary>The text content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Text alignment: <c>left</c>/<c>start</c>, <c>center</c>, <c>right</c>/<c>end</c> or <c>justify</c> (case-insensitive); anything else adds no class.</summary>
    [Parameter] public string? Align { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    private string _element => CssClass.TypographyElement(Typo);
    private string _cls => CssClass.Merge(CssClass.Typography(Look ?? Typo), CssClass.TextColor(Color), _alignCls, Class);

    private string? _alignCls => Align?.Trim().ToLowerInvariant() switch
    {
        "left" or "start" => "text-left",
        "center" => "text-center",
        "right" or "end" => "text-right",
        "justify" => "text-justify",
        _ => null,
    };
}
