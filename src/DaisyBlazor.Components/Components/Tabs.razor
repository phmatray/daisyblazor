@namespace DaisyBlazor
@using Microsoft.JSInterop

@* Tabs container. daisyUI .tabs with variant modifiers tabs-box | tabs-border | tabs-lift
   and sizes tabs-xs | tabs-sm | tabs-md | tabs-lg | tabs-xl.
   Cascades itself so each <Tab> can register and query the active index. *@

<CascadingValue Value="this" IsFixed="false">
    @* Render the Tab children so they register with this container (each Tab renders no markup itself). *@
    @ChildContent

    <div class="@_cls" style="@Style" @attributes="UserAttributes">
        @* Tab button row *@
        <div role="tablist" class="tabs @_variantClass @_sizeClass" @ref="_tabList" @onkeydown="OnTabListKeyDown" @onfocusin="OnTabListFocusIn">
            @foreach (Tab tab in _tabs)
            {
                bool isActive = _activeTab == tab;
                @* WAI-ARIA tabs: each tab declares its selected state and is linked to the shared
                   panel; the panel is labelled back by the active tab (aria-labelledby below).
                   Roving tabindex: only the selected tab is in the tab order; arrows move between tabs. *@
                <button @attributes="tab.UserAttributes"
                        role="tab"
                        type="button"
                        id="@TabId(tab)"
                        tabindex="@(isActive ? "0" : "-1")"
                        aria-selected="@(isActive ? "true" : "false")"
                        aria-controls="@PanelId"
                        @ref="_tabRefs[tab]"
                        class="@TabButtonClass(tab)"
                        style="@tab.Style"
                        disabled="@tab.Disabled"
                        aria-disabled="@(tab.Disabled ? "true" : null)"
                        @onclick="() => SetActive(tab)">
                    @tab.Title
                </button>
            }
        </div>

        @* Active tab panel *@
        @if (_activeTab is not null)
        {
            <div role="tabpanel" id="@PanelId" aria-labelledby="@TabId(_activeTab)" tabindex="0" class="tab-content">
                @_activeTab.ChildContent
            </div>
        }
    </div>
</CascadingValue>

@code {
    private readonly List<Tab> _tabs = new();
    private readonly Dictionary<Tab, ElementReference> _tabRefs = new();
    private Tab? _activeTab;
    private ElementReference _tabList;
    private bool _focusActiveTab;
    private bool _scrollGuardInstalled;

    [Inject] private IJSRuntime JS { get; set; } = null!;

    // Per-instance id prefix so the tab buttons and the panel can reference each other (WAI-ARIA).
    private readonly string _id = "tabs-" + Guid.NewGuid().ToString("N")[..8];

    /// <summary>The shared tab-panel element id (one panel renders the active tab's content).</summary>
    private string PanelId => $"{_id}-panel";

    /// <summary>A stable element id for a tab button, by its registration index.</summary>
    private string TabId(Tab tab) => $"{_id}-tab-{_tabs.IndexOf(tab)}";

    /// <summary>The tab definitions (one or more <see cref="Tab"/> components).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Zero-based index of the currently active tab.</summary>
    [Parameter] public int ActiveIndex { get; set; }

    /// <summary>Raised when the active index changes.</summary>
    [Parameter] public EventCallback<int> ActiveIndexChanged { get; set; }

    /// <summary>Visual style of the tab strip (Box, Border, or Lift).</summary>
    [Parameter] public TabsVariant Variant { get; set; } = TabsVariant.Box;

    /// <summary>Size of the tab buttons.</summary>
    [Parameter] public Size Size { get; set; } = Size.Medium;

    /// <summary>Extra CSS classes merged onto the outer <c>w-full</c> container.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline CSS style applied to the outer container.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    private string _variantClass => Variant switch
    {
        TabsVariant.Border => "tabs-border",
        TabsVariant.Lift => "tabs-lift",
        _ => "tabs-box"
    };

    private string _sizeClass => Size switch
    {
        Size.Small => "tabs-sm",
        Size.Medium => "tabs-md",
        Size.Large => "tabs-lg",
        _ => string.Empty
    };

    private string _cls => CssClass.Merge("w-full", Class);

    private string TabButtonClass(Tab tab)
    {
        bool isActive = _activeTab == tab;
        return CssClass.Merge("tab", isActive ? "tab-active" : null, tab.Class);
    }

    /// <summary>Called by each <see cref="Tab"/> during OnInitialized to register itself.</summary>
    public void RegisterTab(Tab tab)
    {
        if (!_tabs.Contains(tab))
        {
            _tabs.Add(tab);
        }

        // Keep the active tab in sync with ActiveIndex (clamped), defaulting to the first tab.
        _activeTab = ActiveIndex >= 0 && ActiveIndex < _tabs.Count
            ? _tabs[ActiveIndex]
            : _tabs.Count > 0 ? _tabs[0] : null;

        StateHasChanged();
    }

    /// <summary>Called by each <see cref="Tab"/> during Dispose to unregister itself.</summary>
    public void UnregisterTab(Tab tab)
    {
        _tabs.Remove(tab);
        _tabRefs.Remove(tab);
        if (_activeTab == tab)
        {
            _activeTab = _tabs.Count > 0 ? _tabs[0] : null;
        }

        StateHasChanged();
    }

    private async Task SetActive(Tab tab)
    {
        _activeTab = tab;
        int index = _tabs.IndexOf(tab);
        ActiveIndex = index;
        await ActiveIndexChanged.InvokeAsync(index);
    }

    /// <summary>Activates the tab at the given zero-based index programmatically.</summary>
    public async Task SetActiveIndexAsync(int index)
    {
        if (index >= 0 && index < _tabs.Count)
        {
            await SetActive(_tabs[index]);
        }
    }

    // WAI-ARIA tabs keyboard pattern (automatic activation): arrows wrap, Home/End jump; disabled tabs are skipped.
    private async Task OnTabListKeyDown(KeyboardEventArgs e)
    {
        List<Tab> enabled = _tabs.Where(t => !t.Disabled).ToList();
        if (enabled.Count == 0)
        {
            return;
        }

        int i = Math.Max(0, _activeTab is null ? 0 : enabled.IndexOf(_activeTab));
        Tab? target = e.Key switch
        {
            "ArrowRight" => enabled[(i + 1) % enabled.Count],
            "ArrowLeft" => enabled[(i - 1 + enabled.Count) % enabled.Count],
            "Home" => enabled[0],
            "End" => enabled[^1],
            _ => null
        };

        if (target is not null)
        {
            _focusActiveTab = true;
            await SetActive(target);
        }
    }

    // Loaded on first focus (not first render) so pages that never focus the tabs never touch JS.
    private async Task OnTabListFocusIn()
    {
        if (_scrollGuardInstalled)
        {
            return;
        }

        _scrollGuardInstalled = true;
        try
        {
            // Stop Arrow/Home/End from scrolling the page while the tab list has focus.
            await using IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/DaisyBlazor.Components/tabs.js");
            await module.InvokeVoidAsync("preventNavKeyScroll", _tabList);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // JS unavailable (prerender / disconnected circuit): keys still work, the page may just scroll.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusActiveTab || _activeTab is null || !_tabRefs.TryGetValue(_activeTab, out ElementReference el))
        {
            return;
        }

        _focusActiveTab = false;
        try
        {
            await el.FocusAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // JS unavailable (prerender / disconnected circuit): selection still moved, focus did not.
        }
    }

    protected override void OnParametersSet()
    {
        // Sync ActiveIndex if it changed from the parent without a click.
        if (ActiveIndex >= 0 && ActiveIndex < _tabs.Count)
        {
            Tab target = _tabs[ActiveIndex];
            if (_activeTab != target)
            {
                _activeTab = target;
            }
        }
    }
}
