@namespace DaisyBlazor
@typeparam T
@using System.Globalization

@* MudNumericField<T> replacement. daisyUI .input type=number inside a .fieldset with a .label. *@

<div class="@_fieldsetCls" style="@Style">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="label" for="@_id">
            <span class="label-text">@Label@(Required ? " *" : null)</span>
        </label>
    }

    @if (Adornment != Adornment.None && (!string.IsNullOrEmpty(AdornmentIcon) || !string.IsNullOrEmpty(AdornmentText)))
    {
        <label class="@_inputWrapperCls">
            @if (Adornment == Adornment.Start)
            {
                @AdornmentInner
            }
            <input type="number"
                   class="grow"
                   placeholder="@Placeholder"
                   disabled="@Disabled"
                   readonly="@ReadOnly"
                   required="@Required"
                   min="@_minStr"
                   max="@_maxStr"
                   step="@_stepStr"
                   value="@_displayValue"
                   @onchange="OnChange"
                   id="@_id"
                   @attributes="UserAttributes" />
            @if (Adornment == Adornment.End)
            {
                @AdornmentInner
            }
        </label>
    }
    else
    {
        <input type="number"
               class="@_inputCls"
               placeholder="@Placeholder"
               disabled="@Disabled"
               readonly="@ReadOnly"
               required="@Required"
               min="@_minStr"
               max="@_maxStr"
               step="@_stepStr"
               value="@_displayValue"
               @onchange="OnChange"
               id="@_id"
               @attributes="UserAttributes" />
    }

    @if (_hasError && !string.IsNullOrEmpty(_errorText))
    {
        <span class="label-text text-error text-xs mt-1">@_errorText</span>
    }
    else if (!string.IsNullOrEmpty(HelperText))
    {
        <span class="label-text text-xs opacity-70 mt-1">@HelperText</span>
    }
</div>

@code {
    private readonly string _generatedId = FieldId.New();
    private string _id => FieldId.Resolve(UserAttributes, _generatedId);

    /// <summary>The current numeric value (two-way bindable); empty or unparsable input resets it to default.</summary>
    [Parameter] public T? Value { get; set; }
    /// <summary>Raised with the parsed value when the input's change event fires.</summary>
    [Parameter] public EventCallback<T?> ValueChanged { get; set; }
    /// <summary>Text of the .label rendered above the input; a trailing asterisk is added when Required.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Placeholder text shown in the empty number input.</summary>
    [Parameter] public string? Placeholder { get; set; }
    /// <summary>Visual style: Outlined adds input-bordered, Filled adds input-bordered with bg-base-200; defaults to Outlined.</summary>
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    /// <summary>Margin.Dense makes the input compact (input-sm), like Dense.</summary>
    [Parameter] public Margin Margin { get; set; } = Margin.Normal;
    /// <summary>When true, renders the compact input-sm size.</summary>
    [Parameter] public bool Dense { get; set; }
    /// <summary>Disables the number input.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Makes the number input read-only.</summary>
    [Parameter] public bool ReadOnly { get; set; }
    /// <summary>Sets the HTML required attribute and appends an asterisk to the label.</summary>
    [Parameter] public bool Required { get; set; }
    /// <summary>Accepted for MudBlazor compatibility; currently has no effect.</summary>
    [Parameter] public string? RequiredError { get; set; }
    /// <summary>Accepted for MudBlazor compatibility; currently has no effect (value updates on change, not on each keystroke).</summary>
    [Parameter] public bool Immediate { get; set; }
    /// <summary>When true (the default), the fieldset and input stretch to full width (w-full).</summary>
    [Parameter] public bool FullWidth { get; set; } = true;
    /// <summary>Minimum allowed value, rendered as the input's min attribute.</summary>
    [Parameter] public T? Min { get; set; }
    /// <summary>Maximum allowed value, rendered as the input's max attribute.</summary>
    [Parameter] public T? Max { get; set; }
    /// <summary>Increment step, rendered as the input's step attribute.</summary>
    [Parameter] public T? Step { get; set; }
    /// <summary>Format string (invariant culture) used to display the value, e.g. "F2".</summary>
    [Parameter] public string? Format { get; set; }
    /// <summary>Where the adornment icon/text is placed (Start or End); None renders no adornment.</summary>
    [Parameter] public Adornment Adornment { get; set; } = Adornment.None;
    /// <summary>Icon name rendered inside the input as the adornment.</summary>
    [Parameter] public string? AdornmentIcon { get; set; }
    /// <summary>Text rendered inside the input as the adornment.</summary>
    [Parameter] public string? AdornmentText { get; set; }
    /// <summary>Hint text shown below the input when there is no error.</summary>
    [Parameter] public string? HelperText { get; set; }
    /// <summary>When true, applies input-error styling and shows ErrorText.</summary>
    [Parameter] public bool Error { get; set; }
    /// <summary>Error message shown below the input in error state; overrides any server-side error.</summary>
    [Parameter] public string? ErrorText { get; set; }

    /// <summary>
    /// Field name used to pick up a server-side error from an enclosing
    /// <see cref="DaisyBlazor.Validation.ServerValidation"/>. Not called <c>Name</c> so the HTML
    /// <c>name</c> attribute keeps splatting through.
    /// </summary>
    [Parameter] public string? FieldName { get; set; }

    [CascadingParameter] private ServerValidationState? ServerValidation { get; set; }
    /// <summary>Accepted for MudBlazor compatibility; currently has no effect.</summary>
    [Parameter] public object? For { get; set; }

    /// <summary>Extra CSS classes merged onto the root .fieldset element.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline CSS styles applied to the root .fieldset element.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    private bool _isDense => Dense || Margin == Margin.Dense;

    // Explicit Error/ErrorText wins; the cascaded server state only fills the gap.
    private string? _serverError => FieldName is null ? null : ServerValidation?.FirstErrorFor(FieldName);

    private bool _hasError => Error || _serverError is not null;

    private string? _errorText => ErrorText ?? _serverError;

    private string? _displayValue => Format is { } f && Value is IFormattable fmt
        ? fmt.ToString(f, CultureInfo.InvariantCulture)
        : Convert.ToString(Value, CultureInfo.InvariantCulture);

    // For a value-type T, an unset Min/Max/Step is default(T) = 0, indistinguishable from an
    // explicit 0. Track which ones the parent actually passed so unset bounds render no attribute
    // (otherwise every field gets max="0" step="0" and any positive value is :invalid).
    private bool _minSet;
    private bool _maxSet;
    private bool _stepSet;

    public override Task SetParametersAsync(ParameterView parameters)
    {
        _minSet = parameters.TryGetValue<T?>(nameof(Min), out _);
        _maxSet = parameters.TryGetValue<T?>(nameof(Max), out _);
        _stepSet = parameters.TryGetValue<T?>(nameof(Step), out _);
        return base.SetParametersAsync(parameters);
    }

    private string? _minStr => _minSet ? Convert.ToString(Min, CultureInfo.InvariantCulture) : null;
    private string? _maxStr => _maxSet ? Convert.ToString(Max, CultureInfo.InvariantCulture) : null;
    // Without a step the browser assumes 1, so a fractional value in a double/decimal field would be :invalid.
    // step="0" is never valid HTML, so an explicit zero is treated as unset too.
    private string? _stepStr => _stepSet && Convert.ToString(Step, CultureInfo.InvariantCulture) is { } step and not ("" or "0")
        ? step
        : (Nullable.GetUnderlyingType(typeof(T)) ?? typeof(T)) is var t && (t == typeof(double) || t == typeof(float) || t == typeof(decimal))
            ? "any"
            : null;

    private string _fieldsetCls => CssClass.Merge(
        "fieldset",
        FullWidth ? "w-full" : null,
        Class);

    private string _inputCls => CssClass.Merge(
        "input",
        Variant == Variant.Outlined ? "input-bordered" : null,
        Variant == Variant.Filled ? "input-bordered bg-base-200" : null,
        _isDense ? "input-sm" : null,
        FullWidth ? "w-full" : null,
        _hasError ? "input-error" : null);

    private string _inputWrapperCls => CssClass.Merge(
        "input",
        Variant == Variant.Outlined ? "input-bordered" : null,
        Variant == Variant.Filled ? "input-bordered bg-base-200" : null,
        _isDense ? "input-sm" : null,
        FullWidth ? "w-full" : null,
        _hasError ? "input-error" : null,
        "flex items-center gap-2");

    private RenderFragment AdornmentInner => @<text>
        @if (!string.IsNullOrEmpty(AdornmentIcon))
        {
            <Icon Name="@AdornmentIcon" Size="Size.Small" />
        }
        @if (!string.IsNullOrEmpty(AdornmentText))
        {
            <span class="opacity-70">@AdornmentText</span>
        }
    </text>;

    private async Task OnChange(ChangeEventArgs args)
    {
        string? raw = args.Value?.ToString();
        T? parsed = Parse(raw);
        Value = parsed;
        await ValueChanged.InvokeAsync(parsed);
    }

    private static T? Parse(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return default;
        }

        Type target = Nullable.GetUnderlyingType(typeof(T)) ?? typeof(T);

        try
        {
            object converted = Convert.ChangeType(raw, target, CultureInfo.InvariantCulture);
            return (T)converted;
        }
        catch
        {
            return default;
        }
    }
}
