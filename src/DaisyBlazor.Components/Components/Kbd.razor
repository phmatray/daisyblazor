@namespace DaisyBlazor

@* Keyboard key display component. daisyUI .kbd with optional size modifiers
   kbd-sm / kbd-md / kbd-lg (from Size). Add kbd-xs or kbd-xl through Class. *@

<kbd class="@_cls" style="@Style" @attributes="UserAttributes">@ChildContent</kbd>

@code {
    /// <summary>Content displayed inside the key cap (text or nested elements).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Size of the key cap. Small → kbd-sm, Medium → kbd-md, Large → kbd-lg (pass kbd-xs / kbd-xl via Class).</summary>
    [Parameter] public Size Size { get; set; } = Size.Medium;

    /// <summary>Extra CSS classes added to the kbd element.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline CSS style applied to the kbd element.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    private string _sizeClass => Size switch
    {
        Size.Small => "kbd-sm",
        Size.Large => "kbd-lg",
        _ => "kbd-md"
    };

    private string _cls => CssClass.Merge("kbd", _sizeClass, Class);
}
