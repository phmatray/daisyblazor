@namespace DaisyBlazor
@typeparam T
@implements IDisposable

@* MudSelectItem<T> replacement. Registers itself with the parent Select; renders nothing
   directly (the parent Select emits the <option> using this item's ChildContent + Value). *@

@code {
    /// <summary>The value selected in the parent Select when this option is chosen.</summary>
    [Parameter] public T? Value { get; set; }
    /// <summary>Disables the rendered option so it cannot be chosen.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Option text; when omitted the parent Select renders the Value as text.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>CSS classes applied to the rendered <c>option</c>.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline styles applied to the rendered <c>option</c>.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    [CascadingParameter] private Select<T>? Parent { get; set; }

    protected override void OnInitialized()
    {
        Parent?.RegisterItem(this);
    }

    public void Dispose()
    {
        Parent?.UnregisterItem(this);
    }
}
