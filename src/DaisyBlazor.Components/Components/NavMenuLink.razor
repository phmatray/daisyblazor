@namespace DaisyBlazor
@using Microsoft.AspNetCore.Components.Routing
@* Alias the framework NavLink so the unqualified <NavLink> in this file resolves to it,
   not to this component (which is also named NavLink). *@

@* MudNavLink replacement (named NavMenuLink to avoid the framework NavLink clash). Renders a Blazor NavLink styled as a daisyUI menu link.
   The framework NavLink applies ActiveClass (and aria-current="page") when the route matches;
   daisyUI 5's .menu highlights ".menu-active", so that is the class emitted. *@

@if (Disabled)
{
    <span role="link" aria-disabled="true" class="@_disabledCls" style="@Style" @attributes="UserAttributes">
        @LinkInner
    </span>
}
else
{
    <Microsoft.AspNetCore.Components.Routing.NavLink href="@Href" Match="Match" target="@Target"
                   class="@_cls" ActiveClass="menu-active" style="@Style" @attributes="UserAttributes">
        @LinkInner
    </Microsoft.AspNetCore.Components.Routing.NavLink>
}

@code {
    /// <summary>The link label rendered after the optional icon.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Target URL of the link.</summary>
    [Parameter] public string? Href { get; set; }
    /// <summary>Material Symbols icon name rendered before the label at small size.</summary>
    [Parameter] public string? Icon { get; set; }
    /// <summary>How the current URL is matched to apply <c>menu-active</c>; defaults to Prefix.</summary>
    [Parameter] public NavLinkMatch Match { get; set; } = NavLinkMatch.Prefix;
    /// <summary>The anchor <c>target</c> attribute, e.g. <c>_blank</c>.</summary>
    [Parameter] public string? Target { get; set; }
    /// <summary>Renders a dimmed, non-clickable <c>span</c> instead of a link.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Extra CSS classes added to the link element.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline styles applied to the link element.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    private string _cls => CssClass.Merge("flex items-center gap-2", Class);

    private string _disabledCls => CssClass.Merge("flex items-center gap-2 opacity-50 pointer-events-none", Class);

    private RenderFragment LinkInner => @<text>
        @if (!string.IsNullOrEmpty(Icon))
        {
            <Icon Name="@Icon" Size="Size.Small" />
        }
        @ChildContent
    </text>;
}
