@namespace DaisyBlazor

@* daisyUI validator wrapper. daisyUI reveals a hint through `.validator:user-invalid ~ .validator-hint`
   (also matching `.validator:has(:user-invalid)`), so the hint must be a SIBLING of the .validator
   element. The ChildContent therefore sits in an inner .validator div and the Hint paragraph follows
   it; the outer div carries Class/Style/attributes. Colouring the input border itself still needs
   class="validator" on the input, since daisyUI's .input sets its own --input-color. *@

<div class="@Class" style="@Style" @attributes="UserAttributes">
    <div class="validator">
        @ChildContent
    </div>
    @if (!string.IsNullOrEmpty(Hint))
    {
        <p class="validator-hint">@Hint</p>
    }
</div>

@code {
    /// <summary>The input element(s) to validate, wrapped in a .validator element.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Optional hint rendered after the inputs as a .validator-hint paragraph, shown once an input is invalid.</summary>
    [Parameter] public string? Hint { get; set; }

    /// <summary>Extra CSS classes applied to the outer wrapper (around the inputs and the hint).</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline CSS styles applied to the outer wrapper.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }
}
