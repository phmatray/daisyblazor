@namespace DaisyBlazor
@typeparam T
@attribute [CascadingTypeParameter(nameof(T))]
@implements IFormField
@implements IDisposable

@* MudSelect<T> replacement. daisyUI .select. SelectItem children register via a cascading
   value; we render a native <select> of <option>s and map the chosen index back to T.
   CascadingTypeParameter lets a <SelectItem> infer T from this parent, so an item that
   sets no Value of its own (a placeholder, say) still needs no T="..." annotation. *@

<div class="@_fieldsetCls" style="@Style">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="label" for="@_id">
            <span class="label-text">@Label@(Required ? " *" : null)</span>
        </label>
    }

    <CascadingValue Value="this" IsFixed="true">
        @* Hidden render pass so SelectItem children register their values + content. *@
        <div style="display:none">@ChildContent</div>
    </CascadingValue>

    <select class="@_selectCls"
            disabled="@Disabled"
            required="@Required"
            multiple="@MultiSelection"
            size="@_size"
            value="@_selectValue"
            @onchange="OnSelectChanged"
            id="@_id"
            aria-invalid="@(_hasError ? "true" : null)"
            aria-describedby="@_describedBy"
            @attributes="UserAttributes">
        @if (!MultiSelection && Clearable)
        {
            <option value="" selected="@(SelectedIndex < 0)">@ClearText</option>
        }
        else if (!MultiSelection && SelectedIndex < 0)
        {
            @* Nothing chosen: show an empty, unpickable placeholder instead of the browser
               silently displaying (but not selecting) the first option. *@
            <option value="" selected disabled hidden></option>
        }
        @for (int i = 0; i < _items.Count; i++)
        {
            int idx = i;
            SelectItem<T> item = _items[idx];
            <option value="@idx"
                    disabled="@item.Disabled"
                    selected="@IsSelected(idx)"
                    class="@item.Class"
                    style="@item.Style"
                    @attributes="item.UserAttributes">@(item.ChildContent ?? RenderText(item.Value))</option>
        }
    </select>

    @if (_showError)
    {
        <span id="@_helpId" class="label-text text-error text-xs mt-1">@_errorText</span>
    }
    else if (!string.IsNullOrEmpty(HelperText))
    {
        <span id="@_helpId" class="label-text text-xs opacity-70 mt-1">@HelperText</span>
    }
</div>

@code {
    private readonly string _generatedId = FieldId.New();
    private string _id => FieldId.Resolve(UserAttributes, _generatedId);

    /// <summary>The selected value in single-selection mode; supports two-way binding with <c>@bind-Value</c>.</summary>
    [Parameter] public T? Value { get; set; }
    /// <summary>Raised with the newly selected value (or default when cleared) in single-selection mode.</summary>
    [Parameter] public EventCallback<T?> ValueChanged { get; set; }
    /// <summary>The selected values when <see cref="MultiSelection"/> is on; supports <c>@bind-SelectedValues</c>.</summary>
    [Parameter] public IEnumerable<T>? SelectedValues { get; set; }
    /// <summary>Raised with the chosen values whenever the selection changes in multi-selection mode.</summary>
    [Parameter] public EventCallback<IEnumerable<T>> SelectedValuesChanged { get; set; }
    /// <summary>Text rendered in a <c>label</c> above the select, linked to it by id.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Outlined (default) adds <c>select-bordered</c>; Filled also adds <c>bg-base-200</c>; Text renders a borderless ghost select (<c>select-ghost</c>).</summary>
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    /// <summary>Spacing preset; <c>Margin.Dense</c> renders the compact <c>select-sm</c> size, like <see cref="Dense"/>.</summary>
    [Parameter] public Margin Margin { get; set; } = Margin.Normal;
    /// <summary>Renders the compact <c>select-sm</c> size.</summary>
    [Parameter] public bool Dense { get; set; }
    /// <summary>Disables the native select element.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Adds an empty first option (labelled <see cref="ClearText"/>) that resets the value; single-selection only.</summary>
    [Parameter] public bool Clearable { get; set; }
    /// <summary>Renders a native multiple select bound through <see cref="SelectedValues"/> instead of <see cref="Value"/>.</summary>
    [Parameter] public bool MultiSelection { get; set; }
    /// <summary>Appends an asterisk to the label and sets the native HTML <c>required</c> attribute.</summary>
    [Parameter] public bool Required { get; set; }
    /// <summary>Message shown when an enclosing <see cref="Form"/> validates this Required select while nothing is chosen. Defaults to "Required".</summary>
    [Parameter] public string? RequiredError { get; set; }
    /// <summary>Checked by an enclosing <see cref="Form"/> against <see cref="Value"/>: <c>Func&lt;T, string?&gt;</c> (error or null), <c>Func&lt;T, bool&gt;</c> or <c>Func&lt;T, IEnumerable&lt;string&gt;&gt;</c>.</summary>
    [Parameter] public object? Validation { get; set; }
    /// <summary>Stretches the wrapper and select to full width (<c>w-full</c>); on by default.</summary>
    [Parameter] public bool FullWidth { get; set; } = true;
    /// <summary>Hint text shown beneath the select; hidden while an error message is showing.</summary>
    [Parameter] public string? HelperText { get; set; }

    /// <summary>Marks the control as invalid (adds <c>select-error</c>).</summary>
    [Parameter] public bool Error { get; set; }

    /// <summary>Message shown beneath the control when <see cref="Error"/> is set. Replaces
    /// <see cref="HelperText"/> while an error is showing, matching TextField's behaviour.</summary>
    [Parameter] public string? ErrorText { get; set; }

    /// <summary>
    /// Field name used to pick up a server-side error from an enclosing
    /// <see cref="DaisyBlazor.Validation.ServerValidation"/>. Not called <c>Name</c> so the HTML
    /// <c>name</c> attribute keeps splatting through.
    /// </summary>
    [Parameter] public string? FieldName { get; set; }

    [CascadingParameter] private ServerValidationState? ServerValidation { get; set; }
    [CascadingParameter] private Form? Form { get; set; }
    private string? _validationError;

    protected override void OnInitialized() => Form?.Register(this);
    public void Dispose() => Form?.Unregister(this);
    string? IFormField.GetError() => FormValidation.Run(
        Form, Required && FormValidation.IsEmpty(MultiSelection ? SelectedValues : Value), RequiredError, Validation, Value, FieldName);
    void IFormField.ShowError(string? error)
    {
        _validationError = error;
        StateHasChanged();
    }

    /// <summary>Label of the empty option added when <see cref="Clearable"/> is set; empty by default.</summary>
    [Parameter] public string ClearText { get; set; } = "";
    /// <summary>Accepted for MudBlazor compatibility; currently has no effect.</summary>
    [Parameter] public object? For { get; set; }
    /// <summary>The <see cref="SelectItem{T}"/> children that define the options.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Extra CSS classes added to the wrapping <c>fieldset</c> element.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline styles applied to the wrapping <c>fieldset</c> element.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    private readonly List<SelectItem<T>> _items = new();

    private bool _isDense => Dense || Margin == Margin.Dense;

    // Explicit Error/ErrorText wins; the cascaded server state only fills the gap.
    private string? _serverError => FieldName is null ? null : ServerValidation?.FirstErrorFor(FieldName);

    private bool _hasError => Error || _validationError is not null || _serverError is not null;

    private string? _errorText => ErrorText ?? _validationError ?? _serverError;

    private bool _showError => _hasError && !string.IsNullOrEmpty(_errorText);
    private string _helpId => _id + "-help";
    private string? _describedBy => _showError || !string.IsNullOrEmpty(HelperText) ? _helpId : null;

    internal void RegisterItem(SelectItem<T> item)
    {
        if (!_items.Contains(item))
        {
            _items.Add(item);
            StateHasChanged();
        }
    }

    internal void UnregisterItem(SelectItem<T> item)
    {
        if (_items.Remove(item))
        {
            StateHasChanged();
        }
    }

    private static RenderFragment RenderText(T? value) => builder =>
    {
        builder.AddContent(0, value?.ToString());
    };

    private int SelectedIndex => _items.FindIndex(it => EqualityComparer<T?>.Default.Equals(it.Value, Value));

    private bool IsSelected(int idx)
    {
        if (MultiSelection)
        {
            return SelectedValues is { } sv && sv.Any(v => EqualityComparer<T?>.Default.Equals(v, _items[idx].Value));
        }

        return idx == SelectedIndex;
    }

    private string _fieldsetCls => CssClass.Merge(
        "fieldset",
        FullWidth ? "w-full" : null,
        Class);

    // Single mode drives selection through the select's value property: the option `selected`
    // attribute stops taking effect once the user has picked an option (selectedness dirty flag).
    private string? _selectValue => MultiSelection ? null : SelectedIndex < 0 ? "" : SelectedIndex.ToString();

    // A multiple select is a listbox: show the options as rows (up to 8) rather than one strip.
    private object? _size => MultiSelection ? Math.Clamp(_items.Count, 2, 8) : null;

    // daisyUI .select is a fixed-height inline-flex control built for a single-value dropdown;
    // on a <select multiple> it squashes the options into one clipped row. The textarea look
    // (border, padding, focus ring, auto height) suits a listbox.
    private string _selectCls => MultiSelection
        ? CssClass.Merge(
            "textarea h-auto",
            Variant == Variant.Filled ? "bg-base-200" : null,
            Variant == Variant.Text ? "border-0" : null,
            _isDense ? "textarea-sm" : null,
            FullWidth ? "w-full" : null,
            _hasError ? "textarea-error" : null)
        : CssClass.Merge(
        "select",
        Variant == Variant.Outlined ? "select-bordered" : null,
        Variant == Variant.Filled ? "select-bordered bg-base-200" : null,
        Variant == Variant.Text ? "select-ghost" : null,
        _isDense ? "select-sm" : null,
        FullWidth ? "w-full" : null,
        _hasError ? "select-error" : null);

    private async Task OnSelectChanged(ChangeEventArgs args)
    {
        await ApplySelection(args);
        if (Form is not null)
        {
            await Form.FieldChanged(this);
        }
    }

    private async Task ApplySelection(ChangeEventArgs args)
    {
        if (MultiSelection)
        {
            List<T> chosen = new();
            if (args.Value is IEnumerable<string> raw)
            {
                foreach (string s in raw)
                {
                    if (int.TryParse(s, out int i) && i >= 0 && i < _items.Count)
                    {
                        T? v = _items[i].Value;
                        if (v is not null)
                        {
                            chosen.Add(v);
                        }
                    }
                }
            }

            SelectedValues = chosen;
            await SelectedValuesChanged.InvokeAsync(chosen);
            return;
        }

        string? rawValue = args.Value?.ToString();
        if (string.IsNullOrEmpty(rawValue) || !int.TryParse(rawValue, out int idx) || idx < 0 || idx >= _items.Count)
        {
            Value = default;
            await ValueChanged.InvokeAsync(default);
            return;
        }

        Value = _items[idx].Value;
        await ValueChanged.InvokeAsync(Value);
    }
}
