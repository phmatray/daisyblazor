@namespace DaisyBlazor

@* MudAlert replacement. daisyUI .alert with severity color, optional soft/outline variant,
   an automatic severity icon (unless NoIcon) and child content. *@

<div role="@_role" class="@_cls" style="@Style" @attributes="UserAttributes">
    @if (!NoIcon)
    {
        <Icon Name="@_icon" Class="@(_tinted ? _tint : null)" />
    }
    <span>@ChildContent</span>
</div>

@code {
    /// <summary>Message content rendered next to the icon.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Alert color (alert-info, alert-success, alert-warning, alert-error) and default icon; Normal is neutral.</summary>
    [Parameter] public Severity Severity { get; set; } = Severity.Normal;
    /// <summary>Filled (default) is solid; Outlined adds alert-outline; Text adds alert-soft.</summary>
    [Parameter] public Variant Variant { get; set; } = Variant.Filled;
    /// <summary>Reduces vertical padding (py-2).</summary>
    [Parameter] public bool Dense { get; set; }

    /// <summary>Explicit icon ligature; overrides the severity default when set.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Suppress the leading severity icon.</summary>
    [Parameter] public bool NoIcon { get; set; }

    /// <summary>
    /// ARIA role of the alert. When null (default), Warning and Error use the assertive
    /// <c>alert</c> role and the other severities the polite <c>status</c> role.
    /// </summary>
    [Parameter] public string? Role { get; set; }

    /// <summary>Extra CSS classes added to the alert.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline CSS style applied to the alert.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    private string _icon => !string.IsNullOrEmpty(Icon) ? Icon! : SeverityIcon(Severity);

    /// <summary>The default icon for a severity; shared with <see cref="SnackbarProvider"/>.</summary>
    internal static string SeverityIcon(Severity severity) => severity switch
    {
        Severity.Success => Icons.Material.Filled.CheckCircle,
        Severity.Warning => Icons.Material.Filled.Warning,
        Severity.Error => Icons.Material.Filled.Error,
        _ => Icons.Material.Filled.Info
    };

    private string _role => Role ?? (Severity is Severity.Warning or Severity.Error ? "alert" : "status");

    private string? _tint => Tint(Severity);

    /// <summary>Severity text colour used to tint the icon of outlined/soft alerts; shared with <see cref="SnackbarProvider"/>.</summary>
    internal static string? Tint(Severity severity) => severity switch
    {
        Severity.Info => "text-info",
        Severity.Success => "text-success",
        Severity.Warning => "text-warning",
        Severity.Error => "text-error",
        _ => null
    };

    // Outlined/soft alerts sit on the page background: tinted text there (amber on white) fails
    // contrast, so keep the text base-content and tint only the border/background and the icon.
    private bool _tinted => Variant is Variant.Outlined or Variant.Text && _tint is not null;

    private string _variantClass => VariantClass(Variant);

    /// <summary>The daisyUI alert style class for a variant; shared with <see cref="SnackbarProvider"/>.</summary>
    internal static string VariantClass(Variant variant) => variant switch
    {
        Variant.Outlined => "alert-outline",
        Variant.Text => "alert-soft",
        _ => string.Empty
    };

    private string _cls => CssClass.Merge(
        "alert",
        CssClass.AlertSeverity(Severity),
        _variantClass,
        _tinted ? "text-base-content" : null,
        Dense ? "py-2" : null,
        Class);
}
