@namespace DaisyBlazor

@* MudTimelineItem replacement. A daisyUI .timeline <li> with a colored dot (middle),
   opposite content (timeline-start) and main content (timeline-end).
   Like daisyUI's markup, the first item has no leading line and the last no trailing one
   (hidden with :first-child / :last-child so the item needs no index from the parent).
   The middle column has a fixed width so different dot sizes / icons keep the boxes aligned. *@

<li @attributes="UserAttributes">
    <hr class="[li:first-child>&]:hidden" />
    @if (ItemOpposite is not null)
    {
        <div class="timeline-start">
            @ItemOpposite
        </div>
    }
    <div class="timeline-middle flex w-5 justify-center">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <Icon Name="@Icon" Size="Size.Small" Color="@Color" />
        }
        else
        {
            <span class="@_dotCls"></span>
        }
    </div>
    <div class="@_contentCls" style="@Style">
        @if (ItemContent is not null)
        {
            @ItemContent
        }
        else
        {
            @ChildContent
        }
    </div>
    <hr class="[li:last-child>&]:hidden" />
</li>

@code {
    /// <summary>Main content shown in the <c>timeline-end timeline-box</c>; ignored when <see cref="ItemContent"/> is set.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Main content shown in the <c>timeline-end timeline-box</c>; takes precedence over <see cref="ChildContent"/>.</summary>
    [Parameter] public RenderFragment? ItemContent { get; set; }
    /// <summary>Content rendered on the opposite side, in <c>timeline-start</c>.</summary>
    [Parameter] public RenderFragment? ItemOpposite { get; set; }
    /// <summary>Color of the middle dot (e.g. <c>bg-primary</c>) or icon; defaults to a neutral <c>bg-base-300</c> dot.</summary>
    [Parameter] public Color Color { get; set; } = Color.Default;
    /// <summary>Size of the middle dot (small, medium or large); does not affect the icon.</summary>
    [Parameter] public Size Size { get; set; } = Size.Medium;
    /// <summary>Material Symbols ligature shown in the middle instead of the dot.</summary>
    [Parameter] public string? Icon { get; set; }
    /// <summary>Accepted for MudBlazor compatibility; currently has no effect.</summary>
    [Parameter] public TimelineAlign TimelineAlign { get; set; } = TimelineAlign.Default;
    /// <summary>Additional CSS classes merged onto the content box.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline styles applied to the content box.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    private string _dotSize => Size switch
    {
        Size.Small => "h-2 w-2",
        Size.Large => "h-4 w-4",
        _ => "h-3 w-3"
    };

    private string _dotColor => Color switch
    {
        Color.Primary => "bg-primary",
        Color.Secondary => "bg-secondary",
        Color.Tertiary => "bg-accent",
        Color.Info => "bg-info",
        Color.Success => "bg-success",
        Color.Warning => "bg-warning",
        Color.Error => "bg-error",
        Color.Dark => "bg-neutral",
        _ => "bg-base-300"
    };

    private string _dotCls => CssClass.Merge("inline-block rounded-full", _dotSize, _dotColor);

    private string _contentCls => CssClass.Merge("timeline-end timeline-box", Class);
}
