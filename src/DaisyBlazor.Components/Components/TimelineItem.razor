@namespace DaisyBlazor
@implements IDisposable

@* MudTimelineItem replacement. A daisyUI .timeline <li> with a colored dot (middle), the main
   content box and the opposite content on either side; the parent Timeline decides which side. *@

<li @attributes="UserAttributes">
    <hr />
    @if (_contentOnStart)
    {
        <div class="@_contentCls" style="@Style">@Body</div>
    }
    else if (ItemOpposite is not null)
    {
        <div class="@_oppositeCls">@ItemOpposite</div>
    }
    <div class="timeline-middle">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <Icon Name="@Icon" Size="@Size" Color="@Color" />
        }
        else
        {
            <span class="@_dotCls"></span>
        }
    </div>
    @if (!_contentOnStart)
    {
        <div class="@_contentCls" style="@Style">@Body</div>
    }
    else if (ItemOpposite is not null)
    {
        <div class="@_oppositeCls">@ItemOpposite</div>
    }
    <hr />
</li>

@code {
    [CascadingParameter] private Timeline? Parent { get; set; }

    /// <summary>Main content shown in the timeline box; ignored when <see cref="ItemContent"/> is set.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Main content shown in the timeline box; takes precedence over <see cref="ChildContent"/>.</summary>
    [Parameter] public RenderFragment? ItemContent { get; set; }
    /// <summary>Content rendered on the opposite side of the line from the box (above the box in a compact Start timeline).</summary>
    [Parameter] public RenderFragment? ItemOpposite { get; set; }
    /// <summary>Color of the middle dot (e.g. <c>bg-primary</c>) or icon; defaults to a neutral <c>bg-base-300</c> dot.</summary>
    [Parameter] public Color Color { get; set; } = Color.Default;
    /// <summary>Size of the middle dot or icon (small, medium or large).</summary>
    [Parameter] public Size Size { get; set; } = Size.Medium;
    /// <summary>Material Symbols ligature shown in the middle instead of the dot.</summary>
    [Parameter] public string? Icon { get; set; }
    /// <summary>Vertical alignment of the box and opposite content against the dot: Start (top), End (bottom) or Default (centred).</summary>
    [Parameter] public TimelineAlign TimelineAlign { get; set; } = TimelineAlign.Default;
    /// <summary>Additional CSS classes merged onto the content box.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline styles applied to the content box.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    private string _dotSize => Size switch
    {
        Size.Small => "h-2 w-2",
        Size.Large => "h-4 w-4",
        _ => "h-3 w-3"
    };

    private string _dotColor => Color switch
    {
        Color.Primary => "bg-primary",
        Color.Secondary => "bg-secondary",
        Color.Tertiary => "bg-accent",
        Color.Info => "bg-info",
        Color.Success => "bg-success",
        Color.Warning => "bg-warning",
        Color.Error => "bg-error",
        Color.Dark => "bg-neutral",
        _ => "bg-base-300"
    };

    private string _dotCls => CssClass.Merge("inline-block rounded-full", _dotSize, _dotColor);

    private bool _contentOnStart => Parent?.ContentOnStart(this) ?? false;

    private RenderFragment? Body => ItemContent ?? ChildContent;

    private string? _alignCls => TimelineAlign switch
    {
        TimelineAlign.Start => "self-start",
        TimelineAlign.End => "self-end",
        _ => null
    };

    private string _contentCls => CssClass.Merge(_contentOnStart ? "timeline-start" : "timeline-end", "timeline-box", _alignCls, Class);

    private string _oppositeCls => CssClass.Merge(_contentOnStart ? "timeline-end" : "timeline-start", _alignCls);

    protected override void OnInitialized() => Parent?.Register(this);

    /// <summary>Removes the item from its parent timeline's numbering.</summary>
    public void Dispose() => Parent?.Unregister(this);
}
