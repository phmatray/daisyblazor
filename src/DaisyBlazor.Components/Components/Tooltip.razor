@namespace DaisyBlazor

@* MudTooltip replacement. Wraps ChildContent in a daisyUI .tooltip with data-tip text. *@

<div class="@_cls" data-tip="@Text" style="@Style" @attributes="UserAttributes">
    @ChildContent
    @* data-tip lives in a pseudo-element that assistive tech never reads; this copy is announced. *@
    @if (!string.IsNullOrEmpty(Text))
    {
        <span class="sr-only">@Text</span>
    }
</div>

@code {
    /// <summary>Content wrapped by the daisyUI tooltip that triggers it on hover.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Tooltip text shown on hover.</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>Tooltip placement relative to the wrapped content.</summary>
    [Parameter] public Placement Placement { get; set; } = Placement.Top;

    /// <summary>Accepted for MudBlazor compatibility; daisyUI tooltips always show an arrow.</summary>
    [Parameter] public bool Arrow { get; set; }

    /// <summary>Semantic colour of the tip (tooltip-{color}); Default adds no colour class.</summary>
    [Parameter] public Color Color { get; set; } = Color.Default;

    /// <summary>Keeps the tip visible without hover or focus (tooltip-open).</summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>Extra CSS classes merged onto the root tooltip element.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline CSS styles applied to the root tooltip element.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    private string _placementClass => Placement switch
    {
        Placement.Bottom => "tooltip-bottom",
        Placement.Left => "tooltip-left",
        Placement.Right => "tooltip-right",
        _ => "tooltip-top"
    };

    private string _cls => CssClass.Merge(
        "tooltip",
        _placementClass,
        CssClass.ColorToken(Color) is { } t ? $"tooltip-{t}" : null,
        Open ? "tooltip-open" : null,
        Class);
}
