@namespace DaisyBlazor

@* MudProgressCircular replacement. Indeterminate (the default): daisyUI .loading .loading-spinner.
   Indeterminate="false": a determinate daisyUI .radial-progress ring filled to Value within Min..Max. *@

@if (Indeterminate)
{
    <span class="@_cls" style="@Style" role="status" aria-label="@(AriaLabel ?? _strings.Loading)" @attributes="UserAttributes"></span>
}
else
{
    <div class="@_ringCls" style="@_ringStyle" role="progressbar" aria-label="@(AriaLabel ?? _strings.Loading)"
         aria-valuemin="@_fmt(Min)" aria-valuemax="@_fmt(Max)" aria-valuenow="@_fmt(_clamped)"
         @attributes="UserAttributes"></div>
}

@code {
    [Inject] private IServiceProvider Services { get; set; } = null!;
    private DaisyBlazorStrings _strings => DaisyBlazorStrings.From(Services);

    /// <summary>True (the default) shows an endless spinner; false shows a ring filled to <see cref="Value"/>.</summary>
    [Parameter] public bool Indeterminate { get; set; } = true;
    /// <summary>Current progress, between <see cref="Min"/> and <see cref="Max"/>. Used when <see cref="Indeterminate"/> is false.</summary>
    [Parameter] public double Value { get; set; }
    /// <summary>Value of an empty ring. Defaults to 0.</summary>
    [Parameter] public double Min { get; set; }
    /// <summary>Value of a full ring. Defaults to 100.</summary>
    [Parameter] public double Max { get; set; } = 100;
    /// <summary>Spinner or ring color, applied as a daisyUI text color class.</summary>
    [Parameter] public Color Color { get; set; } = Color.Default;
    /// <summary>Spinner or ring size (loading-{size} for the spinner). Defaults to Medium.</summary>
    [Parameter] public Size Size { get; set; } = Size.Medium;
    /// <summary>Accessible label of the status / progressbar element. Null uses the app-wide <see cref="DaisyBlazorOptions.Strings"/>.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Extra CSS classes merged onto the root element.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline CSS styles applied to the root element.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    private string _colorClass => CssClass.TextColor(Color) ?? string.Empty;

    private string _cls => CssClass.Merge(
        "loading",
        "loading-spinner",
        CssClass.LoadingSize(Size),
        _colorClass,
        Class);

    private string _ringCls => CssClass.Merge("radial-progress", _colorClass, Class);

    private double _clamped => Math.Clamp(Value, Math.Min(Min, Max), Math.Max(Min, Max));

    private double _percent => Max > Min ? (_clamped - Min) / (Max - Min) * 100 : 0;

    // Roughly the loading-{size} spinner sizes, so switching modes does not shift the layout.
    private string _ringSize => Size switch
    {
        Size.Small => "1.5rem",
        Size.Large => "3rem",
        _ => "2.25rem"
    };

    private string _ringStyle =>
        $"--value:{_fmt(_percent)};--size:{_ringSize};--thickness:calc({_ringSize} / 8);{Style}";

    private static string _fmt(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
