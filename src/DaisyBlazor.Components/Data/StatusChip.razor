@namespace DaisyBlazor.Data

@* A filled chip for status indicators. Colour and icon can be resolved from a StatusMap so the
   call site stops computing them; an explicit Color/Icon always wins, keeping older usage intact. *@

<Chip Color="@_color"
      Size="@Size"
      Variant="Variant.Filled"
      Icon="@_icon"
      Class="@Class"
      Style="@Style"
      @attributes="UserAttributes">
    @_label
</Chip>
