@namespace DaisyBlazor

@* daisyUI mockup-window — renders a desktop window chrome with a title bar
   and arbitrary child content.
   Classes used: mockup-window *@

<div class="@_cls" style="@Style" @attributes="UserAttributes">
    @if (!string.IsNullOrEmpty(Title))
    {
        @* Positioned onto the ::before traffic-light row (padding-top 1.25rem, dots 0.75rem tall)
           rather than stacked as a second bar under it; the 6rem start padding clears the dots.
           Geometry is inline so it needs no safelisted utilities. *@
        <div class="pointer-events-none absolute flex items-center justify-center"
             style="inset-inline:0;top:1.25rem;height:.75rem;padding-inline:6rem 1rem">
            <span class="text-sm font-medium truncate">@Title</span>
        </div>
    }
    @if (ChildContent is not null)
    {
        <div class="flex justify-center px-4 py-8">
            @ChildContent
        </div>
    }
</div>

@code {
    /// <summary>Content rendered inside the window body.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Optional window title shown in the title bar.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Optional border color token applied as <c>border-{token}</c> on a 1px border; defaults to base-300.</summary>
    [Parameter] public Color BorderColor { get; set; } = Color.Default;

    /// <summary>Extra CSS classes merged onto the <c>.mockup-window</c> element.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline CSS style applied to the <c>.mockup-window</c> element.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    private string _cls => CssClass.Merge(
        "mockup-window border",
        CssClass.ColorToken(BorderColor) is { } t ? $"border-{t}" : "border-base-300",
        Class);
}
