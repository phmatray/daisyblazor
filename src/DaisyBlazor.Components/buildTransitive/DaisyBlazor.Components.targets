<Project>
  <!--
    DaisyBlazor CSS, NuGet only (no npm, no Node):
    1. Every build copies the preset (preset.css, preset-core.css, kit.css, safelist.css and the
       vendored daisyUI bundles) into $(DaisyBlazorStylesDir), by default obj/daisyblazor/, so a
       stylesheet in Styles/ imports it as "../obj/daisyblazor/preset.css".
    2. With <DaisyBlazorBuildCss>true</DaisyBlazorBuildCss>, it also downloads the Tailwind CSS
       standalone CLI (once, into a per-user cache) and compiles $(DaisyBlazorCssInput) to
       $(DaisyBlazorCssOutput). Set $(DaisyBlazorTailwindPath) to use a Tailwind binary of your own
       (e.g. offline builds or musl Linux).
  -->
  <PropertyGroup>
    <DaisyBlazorStylesDir Condition="'$(DaisyBlazorStylesDir)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'daisyblazor'))</DaisyBlazorStylesDir>
    <DaisyBlazorBuildCss Condition="'$(DaisyBlazorBuildCss)' == ''">false</DaisyBlazorBuildCss>
    <DaisyBlazorCssInput Condition="'$(DaisyBlazorCssInput)' == ''">Styles/main.css</DaisyBlazorCssInput>
    <DaisyBlazorCssOutput Condition="'$(DaisyBlazorCssOutput)' == ''">wwwroot/css/app.css</DaisyBlazorCssOutput>
    <DaisyBlazorTailwindVersion Condition="'$(DaisyBlazorTailwindVersion)' == ''">4.3.0</DaisyBlazorTailwindVersion>
  </PropertyGroup>

  <ItemGroup>
    <_DaisyBlazorStyleFile Include="$(MSBuildThisFileDirectory)../staticwebassets/styles/*.css;$(MSBuildThisFileDirectory)../staticwebassets/styles/*.mjs" />
  </ItemGroup>

  <Target Name="DaisyBlazorCopyStyles" BeforeTargets="BeforeBuild">
    <Copy SourceFiles="@(_DaisyBlazorStyleFile)" DestinationFolder="$(DaisyBlazorStylesDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="DaisyBlazorBuildCss" AfterTargets="DaisyBlazorCopyStyles" BeforeTargets="BeforeBuild"
          Condition="'$(DaisyBlazorBuildCss)' == 'true'">
    <PropertyGroup>
      <_DaisyBlazorOs Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows</_DaisyBlazorOs>
      <_DaisyBlazorOs Condition="$([MSBuild]::IsOSPlatform('OSX'))">macos</_DaisyBlazorOs>
      <_DaisyBlazorOs Condition="'$(_DaisyBlazorOs)' == ''">linux</_DaisyBlazorOs>
      <_DaisyBlazorArch Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">arm64</_DaisyBlazorArch>
      <_DaisyBlazorArch Condition="'$(_DaisyBlazorArch)' == ''">x64</_DaisyBlazorArch>
      <_DaisyBlazorExe Condition="'$(_DaisyBlazorOs)' == 'windows'">.exe</_DaisyBlazorExe>
      <_DaisyBlazorAsset>tailwindcss-$(_DaisyBlazorOs)-$(_DaisyBlazorArch)$(_DaisyBlazorExe)</_DaisyBlazorAsset>
      <_DaisyBlazorCache>$([MSBuild]::NormalizeDirectory($([System.Environment]::GetFolderPath(SpecialFolder.LocalApplicationData)), 'daisyblazor', 'tailwind', '$(DaisyBlazorTailwindVersion)'))</_DaisyBlazorCache>
      <DaisyBlazorTailwindPath Condition="'$(DaisyBlazorTailwindPath)' == ''">$(_DaisyBlazorCache)$(_DaisyBlazorAsset)</DaisyBlazorTailwindPath>
    </PropertyGroup>

    <DownloadFile Condition="!Exists('$(DaisyBlazorTailwindPath)')"
                  SourceUrl="https://github.com/tailwindlabs/tailwindcss/releases/download/v$(DaisyBlazorTailwindVersion)/$(_DaisyBlazorAsset)"
                  DestinationFolder="$(_DaisyBlazorCache)" />
    <Exec Condition="'$(_DaisyBlazorOs)' != 'windows'" Command="chmod +x &quot;$(DaisyBlazorTailwindPath)&quot;" />
    <Exec Command="&quot;$(DaisyBlazorTailwindPath)&quot; -i &quot;$(DaisyBlazorCssInput)&quot; -o &quot;$(DaisyBlazorCssOutput)&quot; --minify"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
