<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DaisyBlazor.Charts</RootNamespace>
    <AssemblyName>DaisyBlazor.Charts</AssemblyName>

    <IsPackable>true</IsPackable>
    <PackageId>DaisyBlazor.Charts</PackageId>
    <Description>Theme-aware SVG charts for Blazor: line, area, bar, pie, donut, sparkline, Sankey and more. Every chart computes its geometry with a D3 module bundled in the package, so there is nothing to install from npm; the charts need JavaScript and show a same-size placeholder under static server rendering. Colors follow the active daisyUI v5 theme via CSS custom properties (--color-primary, etc.).</Description>
    <PackageTags>$(PackageTags);charts;svg;sparkline;d3;sankey</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuses the public Color enum and CssClass helper from the component kit; no charting runtime. -->
    <ProjectReference Include="..\DaisyBlazor.Components\DaisyBlazor.Components.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
  </ItemGroup>

</Project>
