@namespace DaisyBlazor.Charts

@* Donut chart. A thin, discoverable wrapper over PieChart with a hole (InnerRadiusRatio, default
   0.6) and an optional centered label. Same data API; colors follow the active daisyUI theme. *@

<PieChart Data="Data"
          ShowLegend="ShowLegend"
          Width="@Width"
          Height="@Height"
          Title="@Title"
          InnerRadiusRatio="InnerRadiusRatio"
          CenterLabel="@CenterLabel"
          OthersThreshold="OthersThreshold"
          OthersLabel="@OthersLabel"
          Exploded="Exploded"
          ExplodeOffset="ExplodeOffset"
          Rings="Rings"
          ShowPercent="ShowPercent"
          Class="@Class"
          Style="@Style"
          @attributes="UserAttributes" />

@code {
    /// <summary>Slice data; each point's value contributes to the whole.</summary>
    [Parameter] public IReadOnlyList<ChartDataPoint> Data { get; set; } = new List<ChartDataPoint>();

    /// <summary>Show a legend with labels and percentages.</summary>
    [Parameter] public bool ShowLegend { get; set; } = true;

    /// <summary>CSS width of the chart wrapper.</summary>
    [Parameter] public string? Width { get; set; } = "100%";

    /// <summary>CSS height of the SVG.</summary>
    [Parameter] public string? Height { get; set; } = "16rem";

    /// <summary>Optional heading rendered above the chart.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Inner radius as a fraction of the outer radius (the donut hole size; 0 draws a full pie).</summary>
    [Parameter] public double InnerRadiusRatio { get; set; } = 0.6;

    /// <summary>Optional label rendered in the center of the hole.</summary>
    [Parameter] public string? CenterLabel { get; set; }

    /// <summary>Merge the slices whose share is below this fraction (0.05 = 5 %) into one <see cref="OthersLabel"/> slice; 0 (default) keeps every slice.</summary>
    [Parameter] public double OthersThreshold { get; set; }

    /// <summary>Label of the slice that gathers the slices below <see cref="OthersThreshold"/>.</summary>
    [Parameter] public string OthersLabel { get; set; } = "Other";

    /// <summary>Labels of the slices to pull out of the ring.</summary>
    [Parameter] public IReadOnlyList<string>? Exploded { get; set; }

    /// <summary>How far exploded slices move out along their bisector, as a fraction of the radius (0 to 0.5).</summary>
    [Parameter] public double ExplodeOffset { get; set; } = 0.08;

    /// <summary>Concentric rings instead of <see cref="Data"/>, outermost first, sharing the hole; a label keeps one colour in every ring.</summary>
    [Parameter] public IReadOnlyList<DonutRing>? Rings { get; set; }

    /// <summary>Show each slice's share of the whole in the legend, its tooltip and the description (default true).</summary>
    [Parameter] public bool ShowPercent { get; set; } = true;

    /// <summary>Extra CSS classes added to the chart wrapper.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline styles appended to the chart wrapper, after the width from <see cref="Width"/>.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }
}
