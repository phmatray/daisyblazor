@namespace DaisyBlazor.Charts
@inherits D3Chart<BulletLayout>

@* Bullet chart: one row per measure, a thin value bar over shaded qualitative bands, with a line
   at the target. Each row has its own scale, so measures in different units sit together, unless
   the rows share one axis (SharedAxis). D3
   computes the scales, ticks and boxes; this component draws them in theme colours. *@

<D3ChartFrame TLayout="BulletLayout" Chart="this" Label="@_label" Description="@_description">
    @if (Layout is { } layout)
    {
        @foreach (BulletLayoutRow row in layout.Rows)
        {
            @foreach (BulletLayoutRange band in row.Ranges)
            {
                <rect x="@N(band.X)" y="@N(band.Y)" width="@N(Math.Max(0, band.Width))" height="@N(Math.Max(0, band.Height))"
                      fill="var(--color-base-content)" fill-opacity="@N(0.06 + 0.07 * (row.Ranges.Count - 1 - band.Level))" />
            }

            <rect x="@N(row.Bar.X)" y="@N(row.Bar.Y)" width="@N(Math.Max(1, row.Bar.Width))" height="@N(Math.Max(1, row.Bar.Height))" fill="@_barColor">
                <title>@_tip(row)</title>
            </rect>

            @if (row.Marker is { } marker)
            {
                <line x1="@N(marker.X1)" y1="@N(marker.Y1)" x2="@N(marker.X2)" y2="@N(marker.Y2)" stroke="@TargetColor" stroke-width="3">
                    <title>@_tip(row)</title>
                </line>
            }

            <ChartAxes Plot="row.Plot" XTicks="row.XTicks" YTicks="row.YTicks" XTickMarks="Horizontal" YTickMarks="!Horizontal" XCategories="!Horizontal" YCategories="Horizontal" />
        }
    }
</D3ChartFrame>

@code {
    /// <summary>The measures, one bullet each. Rows whose Value is not a finite number are skipped.</summary>
    [Parameter] public IReadOnlyList<BulletItem> Items { get; set; } = [];

    /// <summary>Lay the bullets out as rows (the default); false stands them up as columns.</summary>
    [Parameter] public bool Horizontal { get; set; } = true;

    /// <summary>
    /// Put every row on one scale with a single axis: under the last row, or beside the first column
    /// when not <see cref="Horizontal"/>. False gives each row its own scale and axis. Null (the
    /// default) shares the axis only when every row's own scale already spans the same range.
    /// </summary>
    [Parameter] public bool? SharedAxis { get; set; }

    /// <summary>Colour of the value bar (any CSS colour). Defaults to the theme's primary colour.</summary>
    [Parameter] public string? BarColor { get; set; }

    /// <summary>Colour of the target line (any CSS colour).</summary>
    [Parameter] public string TargetColor { get; set; } = "var(--color-base-content)";

    /// <summary>Format string for values in tooltips and the description, e.g. "{0:N0} seats".</summary>
    [Parameter] public string ValueFormat { get; set; } = "{0:#,0.##}";

    /// <inheritdoc />
    protected override string Kind => "bullet";

    // layouts/bullet.mjs: rows of (height − 4) ÷ n, each keeping its own tick line, or (height − 20) ÷ n
    // over one shared axis line. Exact when SharedAxis is set; left unset, the layout shares the axis
    // only when every row's scale comes out the same, and its rows are then 16 ÷ n units shorter.
    private protected override ChartRows? RowBands => Horizontal
        ? new ChartRows(Items.Count(i => double.IsFinite(i.Value)), 0, SharedAxis == true ? 20 : 4)
        : null;

    /// <inheritdoc />
    protected override object BuildSpec() => new
    {
        Rows = Items.Select(i => new
        {
            i.Label,
            i.Value,
            i.Target,
            Ranges = (i.Ranges ?? []).Where(double.IsFinite).ToArray(),
        }).ToArray(),
        Width = ViewWidth,
        Height = ViewHeight,
        Vertical = !Horizontal,
        SharedAxis,
    };

    private string _barColor => ChartPalette.At(0, BarColor);

    private string _format(double value) => string.Format(CultureInfo.CurrentCulture, ValueFormat, value);

    private string _tip(BulletLayoutRow row) =>
        row.Target is { } target ? $"{row.Label}: {_format(row.Value)} (target {_format(target)})" : $"{row.Label}: {_format(row.Value)}";

    private string _label => Title ?? "Bullet chart";

    private string _description => string.Join("; ", Items.Where(i => double.IsFinite(i.Value)).Select(i =>
        i.Target is { } t && double.IsFinite(t) ? $"{i.Label}: {_format(i.Value)} of a {_format(t)} target" : $"{i.Label}: {_format(i.Value)}"));
}
