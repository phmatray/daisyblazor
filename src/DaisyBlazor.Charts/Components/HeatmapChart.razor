@namespace DaisyBlazor.Charts
@inherits D3Chart<HeatmapLayout>

@* Heatmap: a value for each row and column, as a grid of cells shaded on a sequential scale from
   zero (or Min) to the largest value (or Max). D3 lays out the bands and the scale; this component mixes
   the shade from a theme colour and the page background. *@

<D3ChartFrame TLayout="HeatmapLayout" Chart="this" Label="@_label" Description="@_description">
    <ChildContent>
        @if (Layout is { } geo)
        {
            @* Column names over the plot, smaller so more of them fit, in the row names' colour. *@
            @foreach (AxisTick column in geo.Columns.Where(c => c.Label.Length > 0))
            {
                <SvgText X="@column.Pos" Y="@(geo.Plot.Top - 6)" Anchor="middle" FontSize="10" FillOpacity="0.8" Text="@column.Label" />
            }
            <ChartAxes Plot="geo.Plot" YTicks="geo.Rows" YCategories="true" />
            @foreach (HeatmapLayoutCell cell in geo.Cells)
            {
                <rect x="@N(cell.X)" y="@N(cell.Y)" width="@N(cell.W)" height="@N(cell.H)" rx="2" fill="@_shade(cell.T)">
                    <title>@($"{cell.Row}, {cell.Column}: {_format(cell.Value)}")</title>
                </rect>
                @if (ShowValues && cell.W >= ChartText.Width(_format(cell.Value), 10) + 4 && cell.H >= 12)
                {
                    <SvgText X="@(cell.X + cell.W / 2)" Y="@(cell.Y + cell.H / 2)" Dy="0.35em" Anchor="middle" FontSize="10"
                             Fill="@(cell.T > 0.55 ? ChartPalette.ContentOf(_color, "var(--color-base-100)") : "var(--color-base-content)")" Text="@_format(cell.Value)" />
                }
            }
        }
    </ChildContent>
    <Legend>
        @if (ShowLegend && Layout is { Cells.Count: > 0, Thresholds: { } thresholds } stepped)
        {
            @* Discrete levels: one swatch per step, with the range of values it covers. *@
            <div class="flex flex-wrap gap-3 mt-2 text-xs">
                @* A flat domain is one step, named by its value. *@
                @for (int level = 0; level <= thresholds.Count; level++)
                {
                    double low = level == 0 ? stepped.Min : thresholds[level - 1];
                    double high = level < thresholds.Count ? thresholds[level] : stepped.Max;
                    <span class="inline-flex items-center gap-1.5">
                        <span class="inline-block w-3 h-3 rounded-sm" style="@($"background:{_shade(thresholds.Count == 0 ? 1 : (double)level / thresholds.Count)};")"></span>
                        <span class="text-base-content/80">@(thresholds.Count == 0 ? _step(low, stepped) : $"{_step(low, stepped)} – {_step(high, stepped)}")</span>
                    </span>
                }
            </div>
        }
        else if (ShowLegend && Layout is { Cells.Count: > 0 } geo)
        {
            <div class="flex flex-wrap gap-3 mt-2 text-xs" aria-hidden="true">
                <span class="inline-flex items-center gap-1.5">
                    <span class="text-base-content/80">@_format(geo.Min)</span>
                    <span style="@($"display:inline-block;width:8rem;height:0.625rem;border-radius:2px;background:linear-gradient(to right, {_shade(0)}, {_shade(0.5)}, {_shade(1)});")"></span>
                    <span class="text-base-content/80">@_format(geo.Max)</span>
                </span>
            </div>
        }
    </Legend>
</D3ChartFrame>

@code {
    /// <summary>The values. Each HeatmapCell puts a Value at a Row and Column; a repeated pair is summed.</summary>
    [Parameter] public IReadOnlyList<HeatmapCell> Cells { get; set; } = [];

    /// <summary>Row order, top to bottom. Defaults to the row names in order of first appearance; rows not listed are left out.</summary>
    [Parameter] public IReadOnlyList<string>? Rows { get; set; }

    /// <summary>Column order, left to right. Defaults to the column names in order of first appearance; columns not listed are left out.</summary>
    [Parameter] public IReadOnlyList<string>? Columns { get; set; }

    /// <summary>CSS colour of the largest value; smaller values blend it into the page background. Defaults to the theme's primary colour.</summary>
    [Parameter] public string? Color { get; set; }

    /// <summary>Write each value inside its cell, where it fits.</summary>
    [Parameter] public bool ShowValues { get; set; }

    /// <summary>Show the colour scale, from <see cref="Min"/> to <see cref="Max"/>, under the chart.</summary>
    [Parameter] public bool ShowLegend { get; set; } = true;

    /// <summary>
    /// Value drawn as the faintest shade; smaller values are clamped to it. Defaults to 0, or to the
    /// smallest value when one is negative.
    /// </summary>
    [Parameter] public double? Min { get; set; }

    /// <summary>Value drawn as the full colour; larger values are clamped to it. Defaults to the largest value.</summary>
    [Parameter] public double? Max { get; set; }

    /// <summary>
    /// Number of discrete colour steps (2 to 10). When set, the values are split into that many equal
    /// ranges between <see cref="Min"/> and <see cref="Max"/>, each drawn in one shade, and the legend
    /// shows one swatch per range. When null (the default) the shading is continuous.
    /// </summary>
    [Parameter] public int? Levels { get; set; }

    /// <summary>
    /// Format string for values in cells, tooltips and the legend, e.g. "{0:N0} requests". With the
    /// default and <see cref="Levels"/>, the legend shows as many decimals as the step size needs.
    /// </summary>
    [Parameter] public string ValueFormat { get; set; } = DefaultFormat;

    private const string DefaultFormat = "{0:#,0.##}";

    /// <inheritdoc />
    protected override string Kind => "heatmap";

    /// <inheritdoc />
    protected override object BuildSpec()
    {
        object[] cells = Cells.Select(c => (object)new { c.Row, c.Column, c.Value }).ToArray();

        // Levels only when set, so the spec (and the layout cache key) of an existing chart stays as it was.
        return Levels is { } levels
            ? new { Cells = cells, Rows, Columns, Min, Max, Width = ViewWidth, Height = ViewHeight, Levels = Math.Clamp(levels, 2, 10) }
            : new { Cells = cells, Rows, Columns, Min, Max, Width = ViewWidth, Height = ViewHeight };
    }

    private string _color => ChartPalette.At(0, Color);

    // The scale runs from a faint tint (Min) to the full colour (Max).
    private string _shade(double t) =>
        $"color-mix(in oklab, {_color} {Math.Round(8 + 92 * t).ToString(Ci)}%, var(--color-base-100))";

    private string _format(double value) => string.Format(CultureInfo.CurrentCulture, ValueFormat, value);

    // A legend bound: the default format keeps two decimals, or one more than the step's first significant digit.
    private string _step(double value, HeatmapLayout geo)
    {
        double step = (geo.Max - geo.Min) / ((geo.Thresholds?.Count ?? 0) + 1);
        if (ValueFormat != DefaultFormat || step <= 0)
        {
            return _format(value);
        }

        int decimals = Math.Clamp((int)Math.Ceiling(-Math.Log10(step)) + 1, 2, 15);
        return value.ToString("#,0." + new string('#', decimals), CultureInfo.CurrentCulture);
    }

    private string _label => Title ?? "Heatmap";

    private string _description => Layout is { Cells.Count: > 0 } geo
        ? $"{geo.Rows.Count} rows by {geo.Columns.Count} columns, values from {_format(geo.Cells.Min(c => c.Value))} to {_format(geo.Cells.Max(c => c.Value))}. Highest: {string.Join(", ", geo.Cells.OrderByDescending(c => c.Value).Take(3).Select(c => $"{c.Row}, {c.Column} ({_format(c.Value)})"))}."
        : "No data.";
}
