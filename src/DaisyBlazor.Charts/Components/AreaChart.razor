@namespace DaisyBlazor.Charts

@* Filled area chart. A thin, discoverable wrapper over LineChart with the area fill enabled.
   Same series/labels API; colors follow the active daisyUI theme. *@

<LineChart Series="Series"
           Labels="Labels"
           Area="true"
           Stacked="Stacked"
           Percent="Percent"
           Smooth="Smooth"
           Step="Step"
           Horizontal="Horizontal"
           References="References"
           Bands="Bands"
           Markers="Markers"
           Trendline="Trendline"
           TrendlineOrder="TrendlineOrder"
           TrendlinePeriod="TrendlinePeriod"
           ShowGrid="ShowGrid"
           ShowPoints="ShowPoints"
           ShowLegend="ShowLegend"
           Width="@Width"
           Height="@Height"
           Title="@Title"
           ShowTitle="@ShowTitle"
           Class="@Class"
           Style="@Style"
           @attributes="UserAttributes" />

@code {
    /// <summary>One or more named series to plot.</summary>
    [Parameter] public IReadOnlyList<ChartSeries> Series { get; set; } = new List<ChartSeries>();

    /// <summary>X-axis category labels (index-aligned with each series' values).</summary>
    [Parameter] public IReadOnlyList<string>? Labels { get; set; }

    /// <summary>
    /// Stack the series so each fill sits on top of the previous ones instead of overlapping,
    /// for part-of-whole data. Fills are near-opaque so they match the legend swatches.
    /// </summary>
    [Parameter] public bool Stacked { get; set; }

    /// <summary>
    /// 100% stacked areas (implies <see cref="Stacked"/>): each fill shows its share of the total
    /// at its index, on a percent axis. Negative or missing values count as 0. Tooltips show the
    /// value and the share.
    /// </summary>
    [Parameter] public bool Percent { get; set; }

    /// <summary>Smooth the line with cubic curves instead of straight segments.</summary>
    [Parameter] public bool Smooth { get; set; }

    /// <summary>
    /// Draw the line and the fill as steps (step-after: each value holds until the next one). If
    /// both <see cref="Step"/> and <see cref="Smooth"/> are set, Step wins.
    /// </summary>
    [Parameter] public bool Step { get; set; }

    /// <summary>
    /// Rotate the chart: the labels run down the vertical axis and the values along the horizontal
    /// one, the areas filling from the left. Works with Smooth, Step, Stacked and Percent.
    /// </summary>
    [Parameter] public bool Horizontal { get; set; }

    /// <summary>Reference lines across the plot at a value, drawn over the areas with their label inside the plot; the value axis grows to show them.</summary>
    [Parameter] public IReadOnlyList<ChartReference>? References { get; set; }

    /// <summary>Shaded value ranges (plot bands) drawn behind the areas, each with an optional label.</summary>
    [Parameter] public IReadOnlyList<ChartBand>? Bands { get; set; }

    /// <summary>Markers on the category axis: a line at a category, or a shaded span over categories, each with an optional label (see <see cref="LineChart.Markers"/>).</summary>
    [Parameter] public IReadOnlyList<ChartMarker>? Markers { get; set; }

    /// <summary>
    /// Fit and draw a dashed trend line per series, over the category index (0, 1, …) on the series'
    /// own values, through the category positions (also when <see cref="Horizontal"/>); its tooltip
    /// gives the equation and R², or the period of a moving average. Ignored when <see cref="Stacked"/>
    /// or <see cref="Percent"/> is on: a fit of the own values would not follow the stacked areas.
    /// </summary>
    [Parameter] public ChartTrendline Trendline { get; set; } = ChartTrendline.None;

    /// <summary>Degree of a <see cref="ChartTrendline.Polynomial"/> trend line, from 2 to 6 (other values are clamped).</summary>
    [Parameter] public int TrendlineOrder { get; set; } = 2;

    /// <summary>Number of points a <see cref="ChartTrendline.MovingAverage"/> trend line averages (at least 2).</summary>
    [Parameter] public int TrendlinePeriod { get; set; } = 3;

    /// <summary>Draw horizontal gridlines and value labels.</summary>
    [Parameter] public bool ShowGrid { get; set; } = true;

    /// <summary>Draw a marker at each data point.</summary>
    [Parameter] public bool ShowPoints { get; set; }

    /// <summary>Show a legend when more than one series is present.</summary>
    [Parameter] public bool ShowLegend { get; set; } = true;

    /// <summary>CSS width of the chart wrapper.</summary>
    [Parameter] public string? Width { get; set; } = "100%";

    /// <summary>CSS height of the SVG plot area.</summary>
    [Parameter] public string? Height { get; set; } = "16rem";

    /// <summary>Optional heading rendered above the chart.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Draw <c>Title</c> as a visible heading above the chart (the default); false keeps it only as the chart's accessible name, for a chart inside a card that already has a heading.</summary>
    [Parameter] public bool ShowTitle { get; set; } = true;

    /// <summary>Extra CSS classes forwarded to the underlying LineChart.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline CSS styles forwarded to the underlying LineChart.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }
}
