@namespace DaisyBlazor.Charts
@inherits D3ChartBase<BarLayout>

@* Bar chart. Renders vertical (default) or horizontal bars from either a flat ChartDataPoint list or
   grouped ChartSeries. D3 computes the bands, the nice value axis and the bars (from the zero line,
   in either direction) at the box's real pixel size (measured mode), so text is drawn 1:1. Colors
   follow the active daisyUI theme via the cycling ChartPalette. *@

<div class="@CssClass.Merge("w-full", Class)" style="@(string.IsNullOrEmpty(Width) ? Style : $"width:{Width};{Style}")" @attributes="UserAttributes">
    @if (!string.IsNullOrEmpty(Title))
    {
        <div class="text-sm font-medium mb-2 text-base-content/80">@Title</div>
    }

    <div @ref="MeasuredElement" style="@($"position:relative;height:{ChartText.Size(Height, "16rem")};")">
        @if (Error is { } error)
        {
            <div role="alert" class="flex items-center justify-center rounded-box border border-dashed border-error/50 text-error text-sm p-4 text-center" style="height:100%;">
                The chart could not be drawn: @error
            </div>
        }
        else if (Layout is not { } geo)
        {
            <div aria-busy="true" aria-label="@($"{_ariaLabel} (loading)")" class="rounded-box bg-base-200 animate-pulse motion-reduce:animate-none" style="height:100%;"></div>
        }
        else
        {
            <svg viewBox="@($"0 0 {N(geo.Width)} {N(geo.Height)}")" role="img" aria-label="@_ariaLabel" aria-describedby="@_descId"
                 style="position:absolute;inset:0;display:block;width:100%;height:100%;overflow:visible;font-family:inherit;">
                <title>@_ariaLabel</title>
                <desc id="@_descId">@_description</desc>

                <ChartAxes Plot="geo.Plot" XTicks="geo.XTicks" YTicks="geo.YTicks" XGrid="Horizontal" YGrid="!Horizontal"
                           XCategories="!Horizontal" YCategories="Horizontal" ViewWidth="geo.Width" />

                @* A layout still being replaced may name bars the new data no longer has. *@
                @foreach (BarLayoutBar bar in geo.Bars.Where(b => b.C < _categories.Count && b.S < _seriesCount))
                {
                    <rect x="@N(bar.X)" y="@N(bar.Y)" width="@N(bar.Width)" height="@N(bar.Height)"
                          fill="@_color(bar.C, bar.S)"><title>@_tooltip(bar.C, bar.S)</title></rect>
                }
            </svg>
        }
    </div>

    @if (ShowLegend && _seriesCount > 1)
    {
        <div class="flex flex-wrap gap-3 mt-2 text-xs">
            @for (int s = 0; s < _seriesCount; s++)
            {
                <span class="inline-flex items-center gap-1.5">
                    <span class="inline-block w-3 h-3 rounded-sm" style="@($"background:{ChartPalette.At(s, _series![s].Color)};")"></span>
                    <span class="text-base-content/80">@(_series![s].Name)</span>
                </span>
            }
        </div>
    }
</div>

@code {
    /// <summary>Flat data points; used when no <see cref="Series"/> are supplied.</summary>
    [Parameter] public IReadOnlyList<ChartDataPoint>? Data { get; set; }

    /// <summary>Grouped series (one bar per series within each category). Takes precedence over <see cref="Data"/>.</summary>
    [Parameter] public IReadOnlyList<ChartSeries>? Series { get; set; }

    /// <summary>Category labels for grouped <see cref="Series"/> mode (index-aligned with series values).</summary>
    [Parameter] public IReadOnlyList<string>? Labels { get; set; }

    /// <summary>Render bars horizontally instead of vertically.</summary>
    [Parameter] public bool Horizontal { get; set; }

    /// <summary>
    /// Stack the series in one bar per category instead of side by side: positive values stack up
    /// from zero and negative ones down, so mixed signs diverge. Series with different
    /// <see cref="ChartSeries.Stack"/> names form stacks standing side by side. Tooltips still show
    /// each series' own value.
    /// </summary>
    [Parameter] public bool Stacked { get; set; }

    /// <summary>
    /// 100% stacked bars (implies <see cref="Stacked"/>): each bar shows the shares of its stack's
    /// total (of absolute values) in the category, on a percent axis. Tooltips show the value and
    /// the share. Meant for grouped <see cref="Series"/>; a flat list fills every bar.
    /// </summary>
    [Parameter] public bool Percent { get; set; }

    /// <summary>Draw value gridlines and labels.</summary>
    [Parameter] public bool ShowGrid { get; set; } = true;

    /// <summary>Show a legend when more than one series is present.</summary>
    [Parameter] public bool ShowLegend { get; set; } = true;

    /// <summary>CSS width of the chart wrapper.</summary>
    [Parameter] public string? Width { get; set; } = "100%";

    /// <summary>CSS height of the SVG plot area.</summary>
    [Parameter] public string? Height { get; set; } = "16rem";

    /// <summary>Optional heading rendered above the chart.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Extra CSS classes added to the chart wrapper.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline CSS style appended to the chart wrapper.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    /// <inheritdoc />
    protected override string Kind => "bar";

    /// <inheritdoc />
    protected override bool Measured => true;

    private IReadOnlyList<ChartSeries>? _series;
    private IReadOnlyList<ChartDataPoint> _points = [];
    private List<string> _categories = new();
    private List<string> _stackNames = new();

    // Per-instance id for the SVG <desc> that exposes the plotted values to screen readers.
    private readonly string _descId = "bar-desc-" + Guid.NewGuid().ToString("N")[..8];

    private bool _grouped => _series is { Count: > 0 };
    private int _seriesCount => _grouped ? _series!.Count : 1;

    private string _ariaLabel =>
        string.IsNullOrEmpty(Title)
            ? (Horizontal ? "Horizontal bar chart" : "Bar chart")
            : Title!;

    /// <inheritdoc />
    protected override object BuildSpec()
    {
        _series = Series is { Count: > 0 } ? Series : null;
        _points = Data ?? [];
        if (_grouped)
        {
            int count = Math.Max(_series!.Max(s => s.Data?.Count ?? 0), Labels?.Count ?? 0);
            _categories = Enumerable.Range(0, count)
                .Select(i => Labels is not null && i < Labels.Count ? Labels[i] : (i + 1).ToString(Ci))
                .ToList();
        }
        else
        {
            _categories = _points.Select(p => p.Label).ToList();
        }

        _stackNames = _grouped ? _series!.Select(s => s.Stack ?? string.Empty).Distinct().ToList() : [];

        IReadOnlyList<double>[] series = _grouped
            ? _series!.Select(s => s.Data ?? []).ToArray()
            : [_points.Select(p => p.Value).ToArray()];

        // The stacking keys only when stacking, so the spec (and the layout cache key) of a
        // side-by-side chart stays as it was.
        if (!Stacked && !Percent)
        {
            return new { Categories = _categories, Series = series, Horizontal, ShowGrid };
        }

        return new
        {
            Categories = _categories,
            Series = series,
            Horizontal,
            ShowGrid,
            Stacked,
            Percent,
            Stacks = _grouped ? _series!.Select(s => _stackNames.IndexOf(s.Stack ?? string.Empty)).ToArray() : [],
        };
    }

    private double _value(int category, int series)
    {
        if (_grouped)
        {
            IReadOnlyList<double>? d = _series![series].Data;
            return d is not null && category < d.Count ? d[category] : double.NaN;
        }

        return category < _points.Count ? _points[category].Value : double.NaN;
    }

    // Grouped: one colour per series. Flat: each point cycles the palette unless it overrides.
    private string _color(int category, int series) => _grouped
        ? ChartPalette.At(series, _series![series].Color)
        : ChartPalette.At(category, category < _points.Count ? _points[category].Color : null);

    private string _tooltip(int category, int series)
    {
        string prefix = _grouped && _seriesCount > 1 && !string.IsNullOrEmpty(_series![series].Name)
            ? $"{_series![series].Name} · "
            : string.Empty;
        double value = _value(category, series);
        return $"{prefix}{_categories[category]}: {ChartText.Value(value)}{(Percent ? $" ({ChartText.Percent(_share(category, series, value))})" : string.Empty)}";
    }

    // The value's share of the absolute total of its stack in the category, in percent.
    private double _share(int category, int series, double value)
    {
        string? stack = _grouped ? _series![series].Stack ?? string.Empty : null;
        double total = Enumerable.Range(0, _seriesCount)
            .Where(s => !_grouped || (_series![s].Stack ?? string.Empty) == stack) // null and "" are one stack, as in the spec
            .Select(s => _value(category, s))
            .Where(double.IsFinite)
            .Sum(Math.Abs);
        return total > 0 ? value / total * 100 : 0;
    }

    private string _description
    {
        get
        {
            IEnumerable<string> Values(int s) => _categories.Select((label, c) =>
            {
                double v = _value(c, s);
                return $"{label} {(double.IsFinite(v) ? ChartText.Value(v) : "no data")}";
            });

            if (!_grouped)
            {
                return string.Join(", ", Values(0));
            }

            return string.Join("; ", Enumerable.Range(0, _seriesCount).Select(s =>
                string.IsNullOrEmpty(_series![s].Name) ? string.Join(", ", Values(s)) : $"{_series![s].Name}: {string.Join(", ", Values(s))}"));
        }
    }
}
