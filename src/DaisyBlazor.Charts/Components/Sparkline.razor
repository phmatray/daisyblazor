@namespace DaisyBlazor.Charts
@inherits D3ChartBase<SparkLayout>

@* Tiny, axis-less trend line for inline use (table cells, KPI tiles). Renders a single list of
   values as a line with an optional area fill and end-point dot. D3 computes the path at the box's
   real pixel size (measured mode), so the stroke and the dot keep their shape at any size;
   overflow:visible keeps the dot whole at the edges. Color follows the active daisyUI theme
   unless overridden. *@

<span @ref="MeasuredElement" class="@CssClass.Merge("inline-block align-middle", Class)" style="@_style" @attributes="UserAttributes">
    @if (Layout is not { } geo)
    {
        <span aria-busy="@(Error is null ? "true" : null)" role="@(Error is null ? null : "img")"
              aria-label="@(Error is null ? $"{_ariaLabel} (loading)" : $"{_ariaLabel}: {Error}")"
              class="rounded-box bg-base-200 animate-pulse motion-reduce:animate-none" style="display:block;width:100%;height:100%;"></span>
    }
    else
    {
        <svg viewBox="@($"0 0 {N(geo.Width)} {N(geo.Height)}")" role="img" aria-label="@_ariaLabel" aria-describedby="@_descId"
             style="display:block;width:100%;height:100%;overflow:visible;">
            <title>@_ariaLabel</title>
            <desc id="@_descId">@_description</desc>

            @if (geo.Band is { } band)
            {
                <rect x="0" y="@N(band.Y)" width="@N(geo.Width)" height="@N(band.Height)" fill="var(--color-base-content)" fill-opacity="0.08"><title>@($"Normal range {ChartText.Value(Math.Min(NormalMin ?? 0, NormalMax ?? 0))} to {ChartText.Value(Math.Max(NormalMin ?? 0, NormalMax ?? 0))}")</title></rect>
            }

            @if (geo.Bars is { } bars)
            {
                @foreach (SparkLayoutBar bar in bars)
                {
                    <rect x="@N(bar.X)" y="@N(bar.Y)" width="@N(bar.Width)" height="@N(bar.Height)" fill="@(bar.Value < 0 ? _negative : _color)"><title>@ChartText.Value(bar.Value)</title></rect>
                }
            }
            else if (geo.End is { } end)
            {
                @if (Area)
                {
                    <path d="@geo.Area" fill="@_color" fill-opacity="0.15" stroke="none" />
                }

                <path d="@geo.Line" fill="none" stroke="@_color" stroke-width="@N(StrokeWidth)"
                      stroke-linejoin="round" stroke-linecap="round" />

                @if (ShowEndDot)
                {
                    <circle cx="@N(end.X)" cy="@N(end.Y)" r="@N(StrokeWidth + 1)" fill="@_color" />
                }
            }

            @if (geo.Trend is { } trend)
            {
                <line x1="@N(trend.X1)" y1="@N(trend.Y1)" x2="@N(trend.X2)" y2="@N(trend.Y2)" stroke="var(--color-base-content)" stroke-opacity="0.6"
                      stroke-width="1" stroke-dasharray="3 2" />
            }
        </svg>
    }
</span>

@code {
    /// <summary>The values to plot, oldest-to-newest.</summary>
    [Parameter] public IReadOnlyList<double> Data { get; set; } = System.Array.Empty<double>();

    /// <summary>Draw a line (default), a column per value, or win/loss bars by sign.</summary>
    [Parameter] public SparklineKind Type { get; set; } = SparklineKind.Line;

    /// <summary>CSS colour of the bars of negative values (Column and WinLoss); defaults to the error theme token.</summary>
    [Parameter] public string? NegativeColor { get; set; }

    /// <summary>Draw the least-squares line across the values, dashed (Line and Column).</summary>
    [Parameter] public bool ShowTrendline { get; set; }

    /// <summary>Low end of the normal range, shaded behind the values with <see cref="NormalMax"/> (Line and Column).</summary>
    [Parameter] public double? NormalMin { get; set; }

    /// <summary>High end of the normal range, shaded behind the values with <see cref="NormalMin"/> (Line and Column).</summary>
    [Parameter] public double? NormalMax { get; set; }

    /// <summary>Fill the area beneath the line.</summary>
    [Parameter] public bool Area { get; set; }

    /// <summary>Draw a dot on the most recent value.</summary>
    [Parameter] public bool ShowEndDot { get; set; } = true;

    /// <summary>Line stroke width in user units.</summary>
    [Parameter] public double StrokeWidth { get; set; } = 2;

    /// <summary>Optional explicit CSS color; defaults to the primary theme token.</summary>
    [Parameter] public string? Color { get; set; }

    /// <summary>CSS width (inline; defaults to a compact cell size).</summary>
    [Parameter] public string? Width { get; set; } = "5rem";

    /// <summary>CSS height (inline; defaults to a compact cell size).</summary>
    [Parameter] public string? Height { get; set; } = "1.5rem";

    /// <summary>Accessible description; defaults to a generic sparkline label.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Extra CSS classes merged onto the sparkline's inline box.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline CSS style appended after the <see cref="Width"/>/<see cref="Height"/> declarations on the sparkline's inline box.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    /// <inheritdoc />
    protected override string Kind => "spark";

    /// <inheritdoc />
    protected override bool Measured => true;

    // The inset keeps the stroke inside the box; the end dot may extend past it (overflow:visible).
    /// <inheritdoc />
    // Only the options in use are sent, so a plain line keeps its original spec.
    protected override object BuildSpec()
    {
        Dictionary<string, object> spec = new() { ["data"] = Data ?? [], ["pad"] = StrokeWidth / 2 + 0.5 };
        if (Type != SparklineKind.Line)
        {
            spec["kind"] = Type.ToString().ToLowerInvariant();
        }

        if (ShowTrendline && Type != SparklineKind.WinLoss)
        {
            spec["trend"] = true;
        }

        if (NormalMin is { } lo && NormalMax is { } hi && double.IsFinite(lo) && double.IsFinite(hi) && Type != SparklineKind.WinLoss)
        {
            spec["normal"] = new[] { lo, hi };
        }

        return spec;
    }

    private readonly string _descId = "spark-desc-" + Guid.NewGuid().ToString("N")[..8];

    private string _color => string.IsNullOrWhiteSpace(Color) ? "var(--color-primary)" : Color!;
    private string _negative => string.IsNullOrWhiteSpace(NegativeColor) ? "var(--color-error)" : NegativeColor!;
    private string _ariaLabel => string.IsNullOrEmpty(Title) ? (Type == SparklineKind.WinLoss ? "Win/loss sparkline" : "Sparkline trend") : Title!;

    private string _description
    {
        get
        {
            List<double> values = (Data ?? []).Where(double.IsFinite).ToList();
            return values.Count == 0
                ? "No data."
                : Type == SparklineKind.WinLoss
                ? $"{values.Count(v => v > 0)} up, {values.Count(v => v < 0)} down, {values.Count(v => v == 0)} even."
                : $"{values.Count} values from {ChartText.Value(values[0])} to {ChartText.Value(values[^1])}; " +
                  $"low {ChartText.Value(values.Min())}, high {ChartText.Value(values.Max())}.";
        }
    }

    private string _style =>
        $"overflow:visible;width:{ChartText.Size(Width, "5rem")};height:{ChartText.Size(Height, "1.5rem")};{Style}";
}
