@namespace DaisyBlazor.Charts

@* Ticks and labels placed by a compare-chart layout: each tick's line (a grid line or a short tick
   mark) and label, then the category or other texts, turned when the layout says so. Drawn inside
   the chart's SVG. *@

@foreach (CompareTick tick in Ticks)
{
    <line x1="@N(tick.X1)" y1="@N(tick.Y1)" x2="@N(tick.X2)" y2="@N(tick.Y2)" stroke="var(--color-base-content)" stroke-opacity="@LineOpacity" />
    <SvgText X="@tick.X" Y="@tick.Y" Anchor="@tick.Anchor" FontSize="11" FillOpacity="0.6" Text="@tick.Label" />
}

@foreach (CompareText label in Labels)
{
    @if (label.Rotate != 0)
    {
        <g transform="@($"rotate({N(label.Rotate)} {N(label.X)} {N(label.Y)})")">
            <SvgText X="@label.X" Y="@label.Y" Anchor="@label.Anchor" FontSize="@LabelSize" FillOpacity="0.8" Text="@label.Text" />
        </g>
    }
    else
    {
        <SvgText X="@label.X" Y="@label.Y" Anchor="@label.Anchor" FontSize="@LabelSize" FillOpacity="0.8" Text="@label.Text" />
    }
}

@code {
    /// <summary>The ticks to draw.</summary>
    [Parameter] public IReadOnlyList<CompareTick> Ticks { get; set; } = [];

    /// <summary>Other texts to draw, such as category names.</summary>
    [Parameter] public IReadOnlyList<CompareText> Labels { get; set; } = [];

    /// <summary>Opacity of the tick lines.</summary>
    [Parameter] public string LineOpacity { get; set; } = "0.1";

    /// <summary>Font size of the labels, in chart units.</summary>
    [Parameter] public double LabelSize { get; set; } = 12;

    private static string N(double value) => Math.Round(value, 2).ToString(CultureInfo.InvariantCulture);
}
