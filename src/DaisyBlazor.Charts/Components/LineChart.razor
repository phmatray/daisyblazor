@namespace DaisyBlazor.Charts

@* Dependency-free line chart. Renders one or more ChartSeries as inline SVG polylines (optionally
   smoothed and/or area-filled) over a gridded, labelled axis area. Colors follow the active daisyUI
   theme via the cycling ChartPalette unless a series sets its own Color. *@

<div class="@_cls" style="@_style" @attributes="UserAttributes">
    @if (!string.IsNullOrEmpty(Title))
    {
        <div class="text-sm font-medium mb-2 text-base-content/80">@Title</div>
    }

    @* Layout: a CSS grid with a y-label gutter (sized by its widest label), the plot, and an
       x-label row. Only the plot's lines and fills live in the stretched SVG (with non-scaling
       strokes); text and point markers are HTML, so they keep a fixed CSS size at any aspect ratio. *@
    <div style="@_gridStyle">
        <div style="@_yAxisStyle" aria-hidden="true">
            @if (ShowGrid)
            {
                @foreach ((double y, string label) in _yGrid)
                {
                    <div style="height:0;overflow:hidden;visibility:hidden;white-space:nowrap;">@label</div>
                }
                @foreach ((double y, string label) in _yGrid)
                {
                    <span class="text-base-content/60" style="@($"position:absolute;right:6px;top:{_pct(y)}%;transform:translateY(-50%);white-space:nowrap;")">@label</span>
                }
            }
        </div>

        <div style="position:relative;min-width:0;">
            <svg viewBox="0 0 100 100"
                 preserveAspectRatio="none"
                 role="img"
                 aria-label="@_ariaLabel"
                 aria-describedby="@_descId"
                 style="position:absolute;inset:0;width:100%;height:100%;overflow:visible;">
                <title>@_ariaLabel</title>
                <desc id="@_descId">@_description</desc>

                @if (ShowGrid)
                {
                    @foreach ((double y, string label) in _yGrid)
                    {
                        <line x1="0" y1="@y.ToString(_ci)" x2="100" y2="@y.ToString(_ci)"
                              stroke="var(--color-base-content)" stroke-opacity="0.12" stroke-width="1"
                              vector-effect="non-scaling-stroke" />
                    }
                }

                @for (int s = 0; s < _series.Count; s++)
                {
                    string color = ChartPalette.At(s, _series[s].Color);
                    List<List<(double X, double Y)>> segments = _segments(_plot[s]);

                    @if (Area && Stacked)
                    {
                        <path d="@_bandPath(segments, s)" fill="@color" fill-opacity="0.7" stroke="none" />
                    }
                    else if (Area)
                    {
                        <path d="@_areaPath(segments)" fill="@color" fill-opacity="0.15" stroke="none" />
                    }

                    <path d="@_linePath(segments)" fill="none" stroke="@color" stroke-width="2"
                          stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />
                }
            </svg>

            @for (int s = 0; s < _series.Count; s++)
            {
                string color = ChartPalette.At(s, _series[s].Color);
                IReadOnlyList<double> data = _series[s].Data ?? new List<double>();
                @for (int i = 0; i < data.Count; i++)
                {
                    @* Markers on every point when ShowPoints; otherwise only on isolated points
                       (a single value or one between gaps), which a line alone cannot show. *@
                    @if (_finite(data[i]) && (ShowPoints || _isolated(Stacked ? _plot[s] : data, i)))
                    {
                        <span title="@_tooltip(s, i, data[i])"
                              style="@($"position:absolute;left:{_pct(_xAt(i))}%;top:{_pct(_yAt(_plot[s][i]))}%;width:8px;height:8px;border-radius:9999px;transform:translate(-50%,-50%);box-sizing:border-box;border:2px solid {color};background:var(--color-base-100);")"></span>
                    }
                }
            }
        </div>

        <div></div>
        <div style="@_xAxisStyle" aria-hidden="true">
            @if (Labels is { Count: > 0 })
            {
                @for (int i = 0; i < Labels.Count; i += _labelStep)
                {
                    <span class="text-base-content/60" style="@($"position:absolute;top:6px;left:{_pct(_xAt(i))}%;width:{_pct(_slot * _labelStep)}%;transform:translateX(-50%);text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;")">@Labels[i]</span>
                }
            }
        </div>
    </div>

    @if (ShowLegend && _series.Count > 1)
    {
        <div class="flex flex-wrap gap-3 mt-2 text-xs">
            @for (int s = 0; s < _series.Count; s++)
            {
                <span class="inline-flex items-center gap-1.5">
                    <span class="inline-block w-3 h-3 rounded-sm" style="@($"background:{ChartPalette.At(s, _series[s].Color)};")"></span>
                    <span class="text-base-content/80">@(_series[s].Name)</span>
                </span>
            }
        </div>
    }
</div>

@code {
    /// <summary>One or more named series to plot.</summary>
    [Parameter] public IReadOnlyList<ChartSeries> Series { get; set; } = new List<ChartSeries>();

    /// <summary>X-axis category labels (index-aligned with each series' values).</summary>
    [Parameter] public IReadOnlyList<string>? Labels { get; set; }

    /// <summary>Fill the area under each line.</summary>
    [Parameter] public bool Area { get; set; }

    /// <summary>
    /// Stack the series: each one is drawn on top of the running total of the previous ones, and
    /// with <see cref="Area"/> each fill spans only its own band. Missing or non-finite values count
    /// as 0; tooltips still show each series' own value.
    /// </summary>
    [Parameter] public bool Stacked { get; set; }

    /// <summary>Smooth the line with cubic curves instead of straight segments.</summary>
    [Parameter] public bool Smooth { get; set; }

    /// <summary>Draw horizontal gridlines and value labels.</summary>
    [Parameter] public bool ShowGrid { get; set; } = true;

    /// <summary>Draw a marker at each data point.</summary>
    [Parameter] public bool ShowPoints { get; set; } = true;

    /// <summary>Show a legend when more than one series is present.</summary>
    [Parameter] public bool ShowLegend { get; set; } = true;

    /// <summary>CSS width of the chart wrapper.</summary>
    [Parameter] public string? Width { get; set; } = "100%";

    /// <summary>CSS height of the SVG plot area.</summary>
    [Parameter] public string? Height { get; set; } = "16rem";

    /// <summary>Optional heading rendered above the chart.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Extra CSS classes merged onto the chart wrapper.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline CSS styles appended to the chart wrapper after the width.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    // The plot SVG uses a 0..100 coordinate system on both axes, stretched to the plot box; HTML
    // overlays position text and markers with the same numbers as percentages.
    private static readonly CultureInfo _ci = CultureInfo.InvariantCulture;

    // Per-instance id for the SVG <desc> that exposes the plotted values to screen readers.
    private readonly string _descId = "line-desc-" + Guid.NewGuid().ToString("N")[..8];

    private IReadOnlyList<ChartSeries> _series => Series ?? new List<ChartSeries>();

    private double _min;
    private double _max;
    private int _count;
    // The y values actually drawn: each series' own data, or the running totals when Stacked.
    private List<IReadOnlyList<double>> _plot = new();
    private List<(double Y, string Label)> _yGrid = new();

    private string _ariaLabel =>
        string.IsNullOrEmpty(Title) ? $"Line chart with {_series.Count} series" : Title!;

    protected override void OnParametersSet()
    {
        // Category count: enough slots for every point and every label.
        int dataCount = _series.Count == 0 ? 0 : _series.Max(s => s.Data?.Count ?? 0);
        _count = Math.Max(dataCount, Labels?.Count ?? 0);

        // Determine value range across all series, guarding empty/equal data.
        _plot = Stacked ? _stack(dataCount) : _series.Select(s => s.Data ?? new List<double>()).ToList();
        List<double> all = _plot.SelectMany(d => d).Where(_finite).ToList();
        double min = all.Count > 0 ? all.Min() : 0;
        double max = all.Count > 0 ? all.Max() : 1;

        // Always include the zero baseline so areas and negative values read naturally.
        min = Math.Min(min, 0);
        max = Math.Max(max, 0);

        (double niceMin, double niceMax, double step) = SvgGeometry.NiceScale(min, max);
        _min = niceMin;
        _max = niceMax;

        _yGrid.Clear();
        foreach (double value in SvgGeometry.Ticks(_min, _max, step))
        {
            _yGrid.Add((_yAt(value), SvgGeometry.FormatTick(value, _ci)));
        }
    }

    private static bool _finite(double v) => !double.IsNaN(v) && !double.IsInfinity(v);

    private static string _pct(double v) => v.ToString("0.###", _ci);

    // Width of one category slot; points sit in the middle of their slot so the first and last
    // ones never collide with the y labels or the right edge.
    private double _slot => _count == 0 ? 100 : 100.0 / _count;

    private double _xAt(int index) => _slot * (index + 0.5);

    private double _yAt(double value) => 100 - 100 * (value - _min) / (_max - _min);

    // Show at most ~12 x labels; wider steps on long series so labels never overlap.
    private int _labelStep => Math.Max(1, (int)Math.Ceiling((Labels?.Count ?? 0) / 12.0));

    private bool _isolated(IReadOnlyList<double> data, int i) =>
        (i == 0 || !_finite(data[i - 1])) && (i == data.Count - 1 || !_finite(data[i + 1]));

    // Splits a series into runs of finite values; NaN/Infinity break the line instead of
    // poisoning the whole path.
    private List<List<(double X, double Y)>> _segments(IReadOnlyList<double>? data)
    {
        List<List<(double X, double Y)>> segments = new();
        List<(double X, double Y)>? current = null;
        for (int i = 0; i < (data?.Count ?? 0); i++)
        {
            if (!_finite(data![i]))
            {
                current = null;
                continue;
            }

            if (current is null)
            {
                current = new List<(double X, double Y)>();
                segments.Add(current);
            }

            current.Add((_xAt(i), _yAt(data[i])));
        }

        return segments;
    }

    private string _segmentPath(List<(double X, double Y)> pts) =>
        Smooth ? SvgGeometry.SmoothPath(pts, _ci) : SvgGeometry.PolyPath(pts, _ci);

    private string _linePath(List<List<(double X, double Y)>> segments) =>
        string.Join(" ", segments.Where(seg => seg.Count > 1).Select(_segmentPath));

    private string _areaPath(List<List<(double X, double Y)>> segments)
    {
        // Close each run at the zero line (always inside the axis range).
        string baseY = _yAt(0).ToString(_ci);
        return string.Join(" ", segments.Where(seg => seg.Count > 1).Select(seg =>
            $"{_segmentPath(seg)} L {seg[^1].X.ToString(_ci)} {baseY} L {seg[0].X.ToString(_ci)} {baseY} Z"));
    }

    // Running totals per index; missing/non-finite values count as 0. Negative values simply lower
    // the total, so a negative series' band sits below the previous line.
    private List<IReadOnlyList<double>> _stack(int count)
    {
        List<IReadOnlyList<double>> result = new();
        double[] running = new double[count];
        foreach (ChartSeries series in _series)
        {
            IReadOnlyList<double> data = series.Data ?? new List<double>();
            for (int i = 0; i < count; i++)
            {
                running[i] += i < data.Count && _finite(data[i]) ? data[i] : 0;
            }

            result.Add((double[])running.Clone());
        }

        return result;
    }

    // Stacked fill: along this series' line, then back along the previous running total (or the
    // zero line for the first series). Stacked data has no gaps, so there is a single segment.
    private string _bandPath(List<List<(double X, double Y)>> segments, int s)
    {
        if (segments.Count == 0 || segments[0].Count < 2)
        {
            return string.Empty;
        }

        List<(double X, double Y)> top = segments[0];
        List<(double X, double Y)> back = top
            .Select((p, i) => (p.X, s == 0 ? _yAt(0) : _yAt(_plot[s - 1][i])))
            .Reverse()
            .ToList();
        return $"{_segmentPath(top)} L{_segmentPath(back)[1..]} Z";
    }

    private string _label(int i) => Labels is not null && i < Labels.Count ? Labels[i] : (i + 1).ToString(_ci);

    private string _tooltip(int s, int i, double value)
    {
        string prefix = _series.Count > 1 && !string.IsNullOrEmpty(_series[s].Name) ? $"{_series[s].Name} · " : string.Empty;
        return $"{prefix}{_label(i)}: {SvgGeometry.FormatValue(value, _ci)}";
    }

    private string _description => string.Join("; ", _series.Select(series =>
    {
        IReadOnlyList<double> data = series.Data ?? new List<double>();
        string values = string.Join(", ", data.Select((v, i) =>
            $"{_label(i)} {(_finite(v) ? SvgGeometry.FormatValue(v, _ci) : "no data")}"));
        return string.IsNullOrEmpty(series.Name) ? values : $"{series.Name}: {values}";
    }));

    private string _gridStyle =>
        "display:grid;grid-template-columns:fit-content(40%) minmax(0,1fr);grid-template-rows:minmax(0,1fr) auto;" +
        $"box-sizing:border-box;height:{Height};padding:0.75em 0.5em 0 0;font-size:0.6875rem;line-height:1.2;";

    private string _yAxisStyle => ShowGrid ? "position:relative;padding-right:6px;" : "position:relative;";

    private string _xAxisStyle => Labels is { Count: > 0 } ? "position:relative;height:calc(1.2em + 6px);" : "position:relative;";

    private string _cls => CssClass.Merge("w-full", Class);

    private string _style
    {
        get
        {
            string dim = string.Empty;
            if (!string.IsNullOrEmpty(Width))
            {
                dim += $"width:{Width};";
            }

            return $"{dim}{Style}";
        }
    }
}
