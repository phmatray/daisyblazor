@namespace DaisyBlazor.Charts
@inherits D3ChartBase<LineLayout>

@* Line chart. Renders one or more ChartSeries as lines (optionally smoothed, area-filled or
   stacked) over a gridded, labelled axis. D3 computes the scales, nice ticks and paths at the
   box's real pixel size (measured mode), so text and strokes are drawn 1:1 at any shape. Colors
   follow the active daisyUI theme via the cycling ChartPalette unless a series sets its own Color. *@

<div class="@CssClass.Merge("w-full", Class)" style="@(string.IsNullOrEmpty(Width) ? Style : $"width:{Width};{Style}")" @attributes="UserAttributes">
    @if (!string.IsNullOrEmpty(Title))
    {
        <div class="text-sm font-medium mb-2 text-base-content/80">@Title</div>
    }

    <div @ref="MeasuredElement" style="@($"position:relative;height:{ChartText.Size(Height, "16rem")};")">
        @if (Error is { } error)
        {
            <div role="alert" class="flex items-center justify-center rounded-box border border-dashed border-error/50 text-error text-sm p-4 text-center" style="height:100%;">
                The chart could not be drawn: @error
            </div>
        }
        else if (Layout is not { } geo)
        {
            <div aria-busy="true" aria-label="@($"{_ariaLabel} (loading)")" class="rounded-box bg-base-200 animate-pulse motion-reduce:animate-none" style="height:100%;"></div>
        }
        else
        {
            <svg viewBox="@($"0 0 {N(geo.Width)} {N(geo.Height)}")" role="img" aria-label="@_ariaLabel" aria-describedby="@_descId"
                 style="position:absolute;inset:0;display:block;width:100%;height:100%;overflow:visible;font-family:inherit;">
                <title>@_ariaLabel</title>
                <desc id="@_descId">@_description</desc>

                <ChartAxes Plot="geo.Plot" XTicks="geo.XTicks" YTicks="geo.YTicks" YGrid="true" ViewWidth="geo.Width" />

                @for (int s = 0; s < Math.Min(_series.Count, geo.Series.Count); s++)
                {
                    LineLayoutSeries geometry = geo.Series[s];
                    string color = ChartPalette.At(s, _series[s].Color);
                    @if (Area)
                    {
                        <path d="@geometry.Area" fill="@color" fill-opacity="@(Stacked || Percent ? "0.7" : "0.15")" stroke="none" />
                    }

                    <path d="@geometry.Line" fill="none" stroke="@color" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
                }

                @for (int s = 0; s < Math.Min(_series.Count, geo.Series.Count); s++)
                {
                    string color = ChartPalette.At(s, _series[s].Color);
                    @foreach (LineLayoutPoint point in geo.Series[s].Points)
                    {
                        @* Markers on every point when ShowPoints; otherwise only on isolated points (a
                           single value or one between gaps), which a line alone cannot show. *@
                        @if (ShowPoints || point.Isolated)
                        {
                            <circle cx="@N(point.X)" cy="@N(point.Y)" r="3" fill="var(--color-base-100)" stroke="@color" stroke-width="2">
                                <title>@_tooltip(s, point.Index)</title>
                            </circle>
                        }
                    }
                }
            </svg>
        }
    </div>

    @if (ShowLegend && _series.Count > 1)
    {
        <div class="flex flex-wrap gap-3 mt-2 text-xs">
            @for (int s = 0; s < _series.Count; s++)
            {
                <span class="inline-flex items-center gap-1.5">
                    <span class="inline-block w-3 h-3 rounded-sm" style="@($"background:{ChartPalette.At(s, _series[s].Color)};")"></span>
                    <span class="text-base-content/80">@(_series[s].Name)</span>
                </span>
            }
        </div>
    }
</div>

@code {
    /// <summary>One or more named series to plot.</summary>
    [Parameter] public IReadOnlyList<ChartSeries> Series { get; set; } = new List<ChartSeries>();

    /// <summary>X-axis category labels (index-aligned with each series' values).</summary>
    [Parameter] public IReadOnlyList<string>? Labels { get; set; }

    /// <summary>Fill the area under each line.</summary>
    [Parameter] public bool Area { get; set; }

    /// <summary>
    /// Stack the series: each one is drawn on top of the running total of the previous ones, and
    /// with <see cref="Area"/> each fill spans only its own band. Missing or non-finite values count
    /// as 0; tooltips still show each series' own value.
    /// </summary>
    [Parameter] public bool Stacked { get; set; }

    /// <summary>
    /// 100% stacked lines (implies <see cref="Stacked"/>): each value is drawn as its share of the
    /// total at its index, on a percent axis. Negative or missing values count as 0. Tooltips show
    /// the value and the share.
    /// </summary>
    [Parameter] public bool Percent { get; set; }

    /// <summary>Smooth the line with cubic curves instead of straight segments.</summary>
    [Parameter] public bool Smooth { get; set; }

    /// <summary>
    /// Draw the line as steps (step-after: each value holds until the next one). If both
    /// <see cref="Step"/> and <see cref="Smooth"/> are set, Step wins.
    /// </summary>
    [Parameter] public bool Step { get; set; }

    /// <summary>Draw horizontal gridlines and value labels.</summary>
    [Parameter] public bool ShowGrid { get; set; } = true;

    /// <summary>Draw a marker at each data point.</summary>
    [Parameter] public bool ShowPoints { get; set; } = true;

    /// <summary>Show a legend when more than one series is present.</summary>
    [Parameter] public bool ShowLegend { get; set; } = true;

    /// <summary>CSS width of the chart wrapper.</summary>
    [Parameter] public string? Width { get; set; } = "100%";

    /// <summary>CSS height of the SVG plot area.</summary>
    [Parameter] public string? Height { get; set; } = "16rem";

    /// <summary>Optional heading rendered above the chart.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Extra CSS classes merged onto the chart wrapper.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline CSS styles appended to the chart wrapper after the width.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    /// <inheritdoc />
    protected override string Kind => "line";

    /// <inheritdoc />
    protected override bool Measured => true;

    /// <inheritdoc />
    protected override object BuildSpec()
    {
        IReadOnlyList<double>[] series = _series.Select(s => s.Data ?? []).ToArray();
        IReadOnlyList<string> labels = Labels ?? [];

        // Percent and Step only when set, so the spec (and the layout cache key) of an existing
        // chart stays as it was.
        return Percent || Step
            ? (object)new { Series = series, Labels = labels, Stacked, Percent, Smooth, Step, ShowGrid }
            : new { Series = series, Labels = labels, Stacked, Smooth, ShowGrid };
    }

    // Per-instance id for the SVG <desc> that exposes the plotted values to screen readers.
    private readonly string _descId = "line-desc-" + Guid.NewGuid().ToString("N")[..8];

    private IReadOnlyList<ChartSeries> _series => Series ?? new List<ChartSeries>();

    private string _ariaLabel =>
        string.IsNullOrEmpty(Title) ? $"Line chart with {_series.Count} series" : Title!;

    private string _label(int i) => Labels is not null && i < Labels.Count ? Labels[i] : (i + 1).ToString(Ci);

    // Each series' own value, also when Stacked draws it on the running total.
    private string _tooltip(int s, int i)
    {
        string prefix = _series.Count > 1 && !string.IsNullOrEmpty(_series[s].Name) ? $"{_series[s].Name} · " : string.Empty;
        IReadOnlyList<double> data = _series[s].Data ?? new List<double>();
        // A layout still being replaced may name points the new data no longer has.
        if (i >= data.Count || !double.IsFinite(data[i]))
        {
            return $"{prefix}{_label(i)}: no data";
        }

        return $"{prefix}{_label(i)}: {ChartText.Value(data[i])}{(Percent ? $" ({ChartText.Percent(_share(i, data[i]))})" : string.Empty)}";
    }

    // Percent mode: the value's share of the positive total at index i, as the layout draws it.
    private double _share(int i, double value)
    {
        double total = _series.Select(s => s.Data is { } d && i < d.Count && double.IsFinite(d[i]) && d[i] > 0 ? d[i] : 0).Sum();
        return total > 0 ? Math.Max(0, value) / total * 100 : 0;
    }

    private string _description => string.Join("; ", _series.Select(series =>
    {
        IReadOnlyList<double> data = series.Data ?? new List<double>();
        string values = string.Join(", ", data.Select((v, i) =>
            $"{_label(i)} {(double.IsFinite(v) ? ChartText.Value(v) : "no data")}"));
        return string.IsNullOrEmpty(series.Name) ? values : $"{series.Name}: {values}";
    }));
}
