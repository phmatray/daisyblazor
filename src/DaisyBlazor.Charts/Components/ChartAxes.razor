@namespace DaisyBlazor.Charts

@* Axes for a D3-backed chart, drawn inside its SVG from the ticks its layout computed: grid lines
   across the plot, tick marks, tick labels and axis titles. X labels hang under the x axis, y labels
   sit left of the y axis (and, for a second scale, right of the plot). Category labels are drawn
   stronger than value ticks. An x label near either edge of the chart is anchored to that edge so
   it never leaves the viewBox. *@

@if (XGrid)
{
    @foreach (AxisTick tick in XTicks)
    {
        <line x1="@N(tick.Pos)" x2="@N(tick.Pos)" y1="@N(Plot.Top)" y2="@N(Plot.Bottom)" stroke="var(--color-base-content)" stroke-opacity="@_gridOpacity(tick)" />
    }
}
@if (YGrid)
{
    @foreach (AxisTick tick in YTicks)
    {
        <line x1="@N(Plot.Left)" x2="@N(Plot.Right)" y1="@N(tick.Pos)" y2="@N(tick.Pos)" stroke="var(--color-base-content)" stroke-opacity="@_gridOpacity(tick)" />
    }
}
@if (Baseline)
{
    <line x1="@N(Plot.Left)" x2="@N(Plot.Right)" y1="@N(_xAt)" y2="@N(_xAt)" stroke="var(--color-base-content)" stroke-opacity="0.3" />
}
@if (XTickMarks)
{
    @foreach (AxisTick tick in XTicks)
    {
        <line x1="@N(tick.Pos)" x2="@N(tick.Pos)" y1="@N(_xAt)" y2="@N(_xAt + 4)" stroke="var(--color-base-content)" stroke-opacity="0.3" />
    }
}
@if (YTickMarks)
{
    @foreach (AxisTick tick in YTicks)
    {
        <line x1="@N(_yAt - 4)" x2="@N(_yAt)" y1="@N(tick.Pos)" y2="@N(tick.Pos)" stroke="var(--color-base-content)" stroke-opacity="0.3" />
    }
}

@foreach (AxisTick tick in XTicks.Where(t => t.Label.Length > 0))
{
    <g>
        @if (tick.Full is { } full && full != tick.Label)
        {
            <title>@full</title>
        }
        @if (XLabelAngle != 0)
        {
            <g transform="@($"rotate({N(XLabelAngle)} {N(tick.Pos)} {N(_xAt + 16)})")">
                <SvgText X="@tick.Pos" Y="@(_xAt + 16)" Anchor="end" FontSize="11" FillOpacity="@_xOpacity" Text="@tick.Label" />
            </g>
        }
        else
        {
            <SvgText X="@tick.Pos" Y="@(_xAt + 16)" Anchor="@_anchor(tick)" FontSize="11" FillOpacity="@_xOpacity" Text="@tick.Label" />
        }
    </g>
}
@foreach (AxisTick tick in YTicks.Where(t => t.Label.Length > 0))
{
    <g>
        @if (tick.Full is { } full && full != tick.Label)
        {
            <title>@full</title>
        }
        <SvgText X="@(_yAt - 6)" Y="@tick.Pos" Dy="0.35em" Anchor="end" FontSize="11" FillOpacity="@_yOpacity" Text="@tick.Label" />
    </g>
}
@foreach (AxisTick tick in Y2Ticks.Where(t => t.Label.Length > 0))
{
    <SvgText X="@(Plot.Right + 6)" Y="@tick.Pos" Dy="0.35em" FontSize="11" FillOpacity="0.7" Text="@tick.Label" />
}

@if (!string.IsNullOrEmpty(XTitle))
{
    <SvgText X="@((Plot.Left + Plot.Right) / 2)" Y="@(Height - 6)" Anchor="middle" FontSize="11" FontWeight="600" FillOpacity="0.8" Text="@XTitle" />
}
@if (!string.IsNullOrEmpty(YTitle))
{
    <SvgText X="0" Y="12" FontSize="11" FontWeight="600" FillOpacity="0.8" Text="@YTitle" />
}

@code {
    /// <summary>The plot rectangle the axes frame.</summary>
    [Parameter, EditorRequired] public PlotArea Plot { get; set; } = null!;

    /// <summary>Ticks along the x axis (positions are x coordinates).</summary>
    [Parameter] public IReadOnlyList<AxisTick> XTicks { get; set; } = [];

    /// <summary>Ticks along the y axis (positions are y coordinates).</summary>
    [Parameter] public IReadOnlyList<AxisTick> YTicks { get; set; } = [];

    /// <summary>Ticks of a second value scale, labelled right of the plot (positions are y coordinates).</summary>
    [Parameter] public IReadOnlyList<AxisTick> Y2Ticks { get; set; } = [];

    /// <summary>Draw a vertical grid line across the plot at each x tick.</summary>
    [Parameter] public bool XGrid { get; set; }

    /// <summary>Draw a horizontal grid line across the plot at each y tick.</summary>
    [Parameter] public bool YGrid { get; set; }

    /// <summary>Draw the grid line at the value 0 stronger, as the line bars grow from.</summary>
    [Parameter] public bool ZeroLine { get; set; }

    /// <summary>Draw the x axis line under the plot.</summary>
    [Parameter] public bool Baseline { get; set; }

    /// <summary>Draw a short mark under the x axis at each x tick.</summary>
    [Parameter] public bool XTickMarks { get; set; }

    /// <summary>Draw a short mark left of the y axis at each y tick.</summary>
    [Parameter] public bool YTickMarks { get; set; }

    /// <summary>The x ticks name categories (bars, boxes, rows): their labels are drawn stronger than value ticks.</summary>
    [Parameter] public bool XCategories { get; set; }

    /// <summary>The y ticks name categories (bars, boxes, rows): their labels are drawn stronger than value ticks.</summary>
    [Parameter] public bool YCategories { get; set; }

    /// <summary>Where the x axis sits, when not along the bottom of the plot (a y coordinate).</summary>
    [Parameter] public double? XAxisAt { get; set; }

    /// <summary>Where the y axis sits, when not along the left of the plot (an x coordinate).</summary>
    [Parameter] public double? YAxisAt { get; set; }

    /// <summary>Turn the x labels by this many degrees around their tick, hanging from their end (e.g. -40 for crowded categories).</summary>
    [Parameter] public double XLabelAngle { get; set; }

    /// <summary>Title under the x tick labels, at the bottom of the chart.</summary>
    [Parameter] public string? XTitle { get; set; }

    /// <summary>Title above the y tick labels, at the top left of the chart.</summary>
    [Parameter] public string? YTitle { get; set; }

    /// <summary>Height of the chart's coordinate space, to place the x title.</summary>
    [Parameter] public double Height { get; set; }

    /// <summary>Width of the chart's coordinate space, to keep edge labels inside it.</summary>
    [Parameter] public double ViewWidth { get; set; } = 640;

    private double _xAt => XAxisAt ?? Plot.Bottom;

    private double _yAt => YAxisAt ?? Plot.Left;

    private double _xOpacity => XCategories ? 0.8 : 0.7;

    private double _yOpacity => YCategories ? 0.8 : 0.7;

    private string _gridOpacity(AxisTick tick) => ZeroLine && tick.Value == 0 ? "0.35" : "0.1";

    private static string N(double value) => Math.Round(value, 2).ToString(CultureInfo.InvariantCulture);

    private string _anchor(AxisTick tick)
    {
        double half = ChartText.Width(tick.Label) / 2;
        return tick.Pos - half < 0 ? "start" : tick.Pos + half > ViewWidth ? "end" : "middle";
    }
}
