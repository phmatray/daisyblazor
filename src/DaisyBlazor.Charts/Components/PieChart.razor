@namespace DaisyBlazor.Charts
@inherits D3ChartBase<PieLayout>

@* Pie chart (a ring when InnerRadiusRatio is above 0). D3 (d3.pie, d3.arc) computes the slice
   angles, arcs and percentages in a fixed 200-unit square that the SVG scales to its CSS height.
   Colors follow the active daisyUI theme via the cycling ChartPalette. Small slices can be merged
   into one "Other" slice, chosen slices pulled out, and Rings draws several concentric rings. *@

<div class="@CssClass.Merge("w-full", Class)" style="@(string.IsNullOrEmpty(Width) ? Style : $"width:{Width};{Style}")" @attributes="UserAttributes">
    @if (!string.IsNullOrEmpty(Title))
    {
        <div class="text-sm font-medium mb-2 text-base-content/80">@Title</div>
    }

    <div class="flex flex-wrap items-center gap-4">
        @if (Error is { } error)
        {
            <div role="alert" class="flex items-center justify-center rounded-box border border-dashed border-error/50 text-error text-sm p-4 text-center" style="@_squareStyle">
                The chart could not be drawn: @error
            </div>
        }
        else if (Layout is not { } geo)
        {
            <div aria-busy="true" aria-label="@($"{_ariaLabel} (loading)")" class="rounded-box bg-base-200 animate-pulse motion-reduce:animate-none" style="@_squareStyle"></div>
        }
        else
        {
            // A layout still being replaced may name points the new Data no longer has.
            IReadOnlyList<PieLayoutSlice> slices = [.. geo.Slices.Where(slice => slice.Ring < _rings.Count && slice.Index < _rings[slice.Ring].Items.Count)];
            <svg viewBox="0 0 @N(_size) @N(_size)" role="img" style="@($"height:{Height};max-width:100%;")"
                 aria-label="@_ariaLabel" aria-describedby="@_descId">
                <title>@_ariaLabel</title>
                @* Screen-reader data description: the slice breakdown the legend conveys visually. *@
                <desc id="@_descId">@_description(slices)</desc>

                <g transform="@($"translate({N(geo.Cx)},{N(geo.Cy)})")">
                    @if (slices.Count == 0)
                    {
                        <circle r="@N((geo.Radius + geo.InnerRadius) / 2)" fill="none"
                                stroke="var(--color-base-content)" stroke-opacity="0.15"
                                stroke-width="@N(geo.InnerRadius > 0 ? geo.Radius - geo.InnerRadius : 2)" />
                    }

                    @for (int k = 0; k < slices.Count; k++)
                    {
                        PieLayoutSlice slice = slices[k];
                        <path d="@slice.Path" fill="@_color(slice, k)" transform="@(slice.Dx != 0 || slice.Dy != 0 ? $"translate({N(slice.Dx)},{N(slice.Dy)})" : null)"
                              stroke="var(--color-base-100)" stroke-width="1"><title>@_sliceTitle(slice)</title></path>
                    }
                </g>

                @if (geo.InnerRadius > 0 && !string.IsNullOrEmpty(CenterLabel))
                {
                    <SvgText X="@geo.Cx" Y="@(geo.Cy + geo.CenterFontSize * 0.35)" Anchor="middle" FontSize="@geo.CenterFontSize" FontWeight="600" Text="@CenterLabel" />
                }
            </svg>

            @if (ShowLegend && slices.Count > 0 && _multi)
            {
                <ul class="flex flex-wrap gap-3 text-xs">
                    @foreach (string label in _labelOrder)
                    {
                        <li class="flex items-center gap-1.5">
                            <span class="inline-block w-3 h-3 rounded-sm" style="@($"background:{_labelColor(label)};")"></span>
                            <span class="text-base-content/80">@label</span>
                        </li>
                    }
                </ul>
            }
            else if (ShowLegend && slices.Count > 0)
            {
                <ul class="flex flex-wrap gap-3 text-xs">
                    @for (int k = 0; k < slices.Count; k++)
                    {
                        PieLayoutSlice slice = slices[k];
                        <li class="flex items-center gap-1.5">
                            <span class="inline-block w-3 h-3 rounded-sm" style="@($"background:{_color(slice, k)};")"></span>
                            <span class="text-base-content/80">@_point(slice).Label</span>
                            <span class="text-base-content/50">@_percent(slice)%</span>
                        </li>
                    }
                </ul>
            }
        }
    </div>
</div>

@code {
    /// <summary>Slice data; each point's value contributes to the whole.</summary>
    [Parameter] public IReadOnlyList<ChartDataPoint> Data { get; set; } = new List<ChartDataPoint>();

    /// <summary>Show a legend with labels and percentages.</summary>
    [Parameter] public bool ShowLegend { get; set; } = true;

    /// <summary>CSS width of the chart wrapper.</summary>
    [Parameter] public string? Width { get; set; } = "100%";

    /// <summary>CSS height of the SVG.</summary>
    [Parameter] public string? Height { get; set; } = "16rem";

    /// <summary>Optional heading rendered above the chart.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Inner radius as a fraction of the outer radius (0 = pie; above 0 renders a ring like <see cref="DonutChart"/>).</summary>
    [Parameter] public double InnerRadiusRatio { get; set; }

    /// <summary>Optional label rendered in the centre of the hole; shown only when <see cref="InnerRadiusRatio"/> is above 0.</summary>
    [Parameter] public string? CenterLabel { get; set; }

    /// <summary>
    /// Merge the slices whose share of the whole is below this fraction (0.05 = 5 %) into one slice
    /// named <see cref="OthersLabel"/>, drawn last; its tooltip lists what it holds. 0 (default) keeps
    /// every slice, and a single small slice is never merged on its own.
    /// </summary>
    [Parameter] public double OthersThreshold { get; set; }

    /// <summary>Label of the slice that gathers the slices below <see cref="OthersThreshold"/>.</summary>
    [Parameter] public string OthersLabel { get; set; } = "Other";

    /// <summary>Labels of the slices to pull out of the pie; the merged slice is named by <see cref="OthersLabel"/>.</summary>
    [Parameter] public IReadOnlyList<string>? Exploded { get; set; }

    /// <summary>How far exploded slices move out along their bisector, as a fraction of the radius (0 to 0.5).</summary>
    [Parameter] public double ExplodeOffset { get; set; } = 0.08;

    /// <summary>
    /// Concentric rings instead of <see cref="Data"/>, outermost first, sharing the hole; each ring's
    /// slices make up its own whole. A label keeps one colour in every ring and the legend lists each
    /// label once. <see cref="OthersThreshold"/> applies to each ring, <see cref="Exploded"/> only to <see cref="Data"/>.
    /// </summary>
    [Parameter] public IReadOnlyList<DonutRing>? Rings { get; set; }

    /// <summary>Additional CSS classes merged onto the <c>w-full</c> wrapper.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Inline styles appended after the width on the wrapper.</summary>
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? UserAttributes { get; set; }

    /// <inheritdoc />
    protected override string Kind => "pie";

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _multi = Rings is { Count: > 0 };
        _rings = _multi
            ? [.. Rings!.Select(r => _merge(r.Name, r.Data ?? []))]
            : [_merge(null, Data ?? new List<ChartDataPoint>())];
        _labelOrder = [.. _rings.SelectMany(r => r.Items).Select(p => p.Label).Distinct()];
        base.OnParametersSet();
    }

    // Defaults send the original spec, so existing charts lay out exactly as before.
    /// <inheritdoc />
    protected override object BuildSpec()
    {
        string center = CenterLabel ?? string.Empty;
        if (_multi)
        {
            double[][] rings = [.. _rings.Select(r => r.Items.Select(p => p.Value).ToArray())];
            return new { Values = Array.Empty<double>(), Size = _size, InnerRatio = InnerRadiusRatio, CenterLabel = center, Rings = rings };
        }

        double[] values = [.. _rings[0].Items.Select(p => p.Value)];
        int[] explode = Exploded is { Count: > 0 } labels
            ? [.. _rings[0].Items.Select((p, i) => (p.Label, i)).Where(x => labels.Contains(x.Label)).Select(x => x.i)]
            : [];
        return explode.Length == 0
            ? new { Values = values, Size = _size, InnerRatio = InnerRadiusRatio, CenterLabel = center }
            : new { Values = values, Size = _size, InnerRatio = InnerRadiusRatio, CenterLabel = center, Explode = explode, ExplodeOffset };
    }

    private const double _size = 200;

    private readonly string _descId = "pie-desc-" + Guid.NewGuid().ToString("N")[..8];

    private sealed record Ring(string? Name, IReadOnlyList<ChartDataPoint> Items, IReadOnlyList<ChartDataPoint> Merged);

    private List<Ring> _rings = [];
    private List<string> _labelOrder = [];
    private bool _multi;

    // Two or more slices below the threshold become one slice at the end; the rest keep their order.
    private Ring _merge(string? name, IReadOnlyList<ChartDataPoint> data)
    {
        double total = data.Where(p => double.IsFinite(p.Value) && p.Value > 0).Sum(p => p.Value);
        List<ChartDataPoint> small = OthersThreshold > 0 && total > 0
            ? [.. data.Where(p => double.IsFinite(p.Value) && p.Value > 0 && p.Value / total < OthersThreshold)]
            : [];
        if (small.Count < 2)
        {
            return new Ring(name, data, []);
        }

        List<ChartDataPoint> items = [.. data.Where(p => !small.Contains(p)), new ChartDataPoint(OthersLabel, small.Sum(p => p.Value))];
        return new Ring(name, items, small);
    }

    private ChartDataPoint _point(PieLayoutSlice slice) => _rings[slice.Ring].Items[slice.Index];

    // The placeholder and error take the square the SVG will fill.
    private string _squareStyle => $"height:{Height};aspect-ratio:1;max-width:100%;";

    // The palette cycles over the drawn slices (k), so skipped values do not leave a colour out. With
    // rings it cycles over the labels instead, so a label keeps its colour in every ring.
    private string _color(PieLayoutSlice slice, int k) =>
        _multi ? _labelColor(_point(slice).Label) : ChartPalette.At(k, _point(slice).Color);

    private string _labelColor(string label) =>
        ChartPalette.At(_labelOrder.IndexOf(label), _rings.SelectMany(r => r.Items).FirstOrDefault(p => p.Label == label && p.Color is not null)?.Color);

    private static string _percent(PieLayoutSlice slice) => slice.Percent.ToString("0.#", CultureInfo.InvariantCulture);

    private string _sliceTitle(PieLayoutSlice slice)
    {
        Ring ring = _rings[slice.Ring];
        ChartDataPoint point = ring.Items[slice.Index];
        string title = $"{(ring.Name is null ? string.Empty : ring.Name + ", ")}{point.Label}: {ChartText.Value(point.Value)} ({_percent(slice)}%)";
        return ring.Merged.Count > 0 && slice.Index == ring.Items.Count - 1
            ? $"{title}: {string.Join(", ", ring.Merged.Select(p => $"{p.Label} {ChartText.Value(p.Value)}"))}"
            : title;
    }

    private string _description(IReadOnlyList<PieLayoutSlice> slices) => slices.Count == 0
        ? "No data."
        : string.Join("; ", slices.Select(_sliceTitle));

    private string _ariaLabel =>
        string.IsNullOrEmpty(Title)
            ? (InnerRadiusRatio > 0 ? "Donut chart" : "Pie chart")
            : Title!;
}
