@implements IDisposable
@inject NavigationManager Nav

@* The top bar: logotype, primary navigation, search and the theme picker. Sits on the primary ground. *@

<header class="sleeve relative z-30">
    <div class="mx-auto flex max-w-[1500px] items-center gap-2 px-4 py-4 sm:gap-3 sm:px-8 lg:px-14">
        <a href="" class="group flex items-center gap-2.5 rounded-full pr-2" aria-label="DaisyBlazor home">
            <DaisyMark Class="size-8 sm:size-10 transition-transform duration-700 ease-out group-hover:rotate-[120deg]" />
            <span class="font-display text-[1.35rem] font-bold sm:text-[1.7rem] leading-none tracking-[-0.02em]">
                daisy<span class="sleeve-soft">Blazor</span>
            </span>
        </a>

        <nav class="ml-2 hidden items-center gap-0.5 whitespace-nowrap font-bold md:flex lg:ml-6 lg:gap-1" aria-label="Primary">
            <a class="@Pill(_section == "guides")" href="getting-started" aria-current="@Current("guides")">Guides</a>
            <a class="@Pill(_section == "components")" href="components" aria-current="@Current("components")">Components</a>
            <a class="@Pill(_section == "charts")" href="charts" aria-current="@Current("charts")">Charts</a>
            <a class="@Pill(_section == "themes")" href="themes" aria-current="@Current("themes")">Themes</a>
            <a class="@Pill(false)" href="https://github.com/phmatray/daisyblazor" target="_blank" rel="noopener">GitHub</a>
        </nav>

        <div class="ml-auto flex items-center gap-1.5 sm:gap-2">
            <button type="button" @onclick="OnSearch"
                    class="flex h-11 items-center gap-3 rounded-full bg-base-100 px-3 xl:pl-4 xl:pr-1.5 text-base-content/70 shadow-[0_1px_0_rgb(0_0_0/0.08)] transition hover:text-base-content xl:min-w-60"
                    aria-label="Search the docs (Ctrl K)">
                <Icon Name="@Icons.Material.Filled.Search" Size="Size.Small" />
                <span class="hidden whitespace-nowrap font-semibold xl:inline">Search the docs</span>
                <span class="ml-auto hidden gap-1 xl:flex"><Kbd Size="Size.Small">Ctrl</Kbd><Kbd Size="Size.Small">K</Kbd></span>
            </button>
            <ThemeSwitcher />
            <button type="button" class="btn btn-circle btn-ghost text-primary-content md:hidden" aria-label="Open navigation"
                    @onclick="() => _menu = !_menu" aria-expanded="@(_menu ? "true" : "false")">
                <Icon Name="@(_menu ? Icons.Material.Filled.Close : Icons.Material.Filled.Menu)" />
            </button>
        </div>
    </div>

    @if (_menu)
    {
        <div class="border-t border-primary-content/20 px-4 pb-6 md:hidden" @onclick="() => _menu = false">
            <MobileNav />
        </div>
    }
</header>

@code {
    [Parameter] public EventCallback OnSearch { get; set; }

    private bool _menu;
    private string? _section;

    private static string Pill(bool active) =>
        "rounded-full px-2.5 py-1.5 hover:bg-primary-content/10 lg:px-3.5 [&.active]:bg-primary-content [&.active]:text-primary" + (active ? " active" : "");

    protected override void OnInitialized()
    {
        _section = Section(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
    }

    private string? Current(string section) => _section == section ? "page" : null;

    // The tab a page belongs to: a chart's page sits under Charts, every other component under Components.
    private string? Section(string uri)
    {
        string path = Nav.ToBaseRelativePath(uri).Split('?', '#')[0].TrimEnd('/');
        if (path is "charts" or "themes") return path;
        if (path == "components") return "components";
        if (path.StartsWith("components/", StringComparison.Ordinal))
        {
            return DocRegistry.Find(path["components/".Length..])?.Category == Category.Charts ? "charts" : "components";
        }
        return Guides.All.Any(g => g.Url == path) ? "guides" : null;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _section = Section(e.Location);
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
