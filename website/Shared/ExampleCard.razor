@* One live example: the demo on base-100, its exact source one click away, and where it lives in the repo. *@

<section id="@Example.Id" class="scroll-mt-6">
    <div class="mb-3 flex flex-wrap items-end justify-between gap-x-6 gap-y-1">
        <h3 class="font-display text-2xl font-semibold">
            <a href="@($"{Path}#{Example.Id}")" class="hover:underline hover:decoration-primary hover:decoration-2 hover:underline-offset-4">@Example.Title</a>
        </h3>
        <div class="flex rounded-full border-2 border-base-content p-0.5 text-sm font-bold" role="tablist" aria-label="@Example.Title view">
            <button type="button" role="tab" aria-selected="@(!_code ? "true" : "false")" @onclick="() => _code = false"
                    class="rounded-full px-3 py-1 transition @(!_code ? "bg-base-content text-base-100" : "hover:bg-base-200")">Preview</button>
            <button type="button" role="tab" aria-selected="@(_code ? "true" : "false")" @onclick="() => _code = true"
                    class="rounded-full px-3 py-1 transition @(_code ? "bg-base-content text-base-100" : "hover:bg-base-200")">Code</button>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(Example.Description))
    {
        <p class="mb-4 max-w-[70ch] text-base-content/80">@Example.Description</p>
    }

    <div class="overflow-hidden rounded-2xl border-2 border-base-content">
        @if (_code)
        {
            <CodeBlock Code="@_source" Flush="true" />
        }
        else
        {
            <div class="bg-base-100 p-6 sm:p-8">
                <DynamicComponent Type="Example.Component" />
            </div>
        }
        <div class="flex items-center justify-between gap-3 border-t-2 border-base-content bg-base-200/60 px-4 py-2 text-xs">
            <span class="truncate font-mono text-base-content/70">@ExampleSource.Path(Example.Component)</span>
            <a href="@ExampleSource.GitHubUrl(Example.Component)" target="_blank" rel="noopener"
               class="flex shrink-0 items-center gap-1 font-bold hover:underline hover:underline-offset-4">
                Source <Icon Name="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Class="!text-sm" />
            </a>
        </div>
    </div>
</section>

@code {
    [Inject] private NavigationManager Nav { get; set; } = null!;

    [Parameter, EditorRequired] public ExampleDoc Example { get; set; } = null!;

    private bool _code;
    private string _source = "";

    private string Path => Nav.ToBaseRelativePath(Nav.Uri).Split('#')[0];

    protected override void OnParametersSet() => _source = ExampleSource.Get(Example.Component);
}
