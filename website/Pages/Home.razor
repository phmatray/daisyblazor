@page "/"
@implements IDisposable
@inject DocsJs Js

<PageTitle>DaisyBlazor — daisyUI components for Blazor</PageTitle>

<Sleeve Title="daisyUI, pressed for Blazor." Large="true" Tracks="_tracks" Portrait="Cover" PortraitCaption="Cover · a few of the components">
    <Lede>
        <p>
            @DocRegistry.All.Count typed components with a MudBlazor-compatible API, @ThemeDeck.Themes.Count live themes and SVG
            charts that follow them. Tailwind CSS v4 and daisyUI v5, shipped as one NuGet package.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-3">
            <a href="getting-started" class="btn btn-lg rounded-full border-0 bg-primary-content px-7 text-primary hover:bg-primary-content/90">Get started</a>
            <a href="components" class="btn btn-lg rounded-full border-2 border-primary-content bg-transparent px-7 text-primary-content hover:bg-primary-content hover:text-primary">Browse components</a>
        </div>
        <button type="button" @onclick="CopyInstall"
                class="mt-5 inline-flex max-w-full items-center gap-3 rounded-full bg-primary-content/12 py-2 pl-4 pr-2 font-mono text-sm transition hover:bg-primary-content/20"
                aria-label="Copy the install command">
            <span class="sleeve-muted select-none">$</span>
            <span class="truncate">dotnet add package DaisyBlazor.Components</span>
            <span class="grid size-7 shrink-0 place-items-center rounded-full bg-primary-content text-primary">
                <Icon Name="@(_copied ? Icons.Material.Filled.Check : Icons.Material.Filled.ContentCopy)" Size="Size.Small" Class="!text-base" />
            </span>
        </button>
    </Lede>
</Sleeve>

<main id="content" tabindex="-1">
    @* ── The catalogue, live ─────────────────────────────────────────────── *@
    <section id="components" class="mx-auto max-w-[1500px] scroll-mt-6 px-4 py-20 sm:px-8 lg:px-14 lg:py-28">
        <div class="mb-10 grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,28rem)] lg:items-end">
            <h2 class="font-display text-[clamp(2.4rem,5vw,4rem)] font-bold leading-[0.95]">The whole catalogue, playing live.</h2>
            <p class="text-lg text-base-content/80">
                Every tile is a real component running in your browser through WebAssembly, organised by daisyUI's own
                taxonomy. Click through for examples, source, a playground and the API.
            </p>
        </div>

        <div class="grid gap-px overflow-hidden rounded-2xl border-2 border-base-content bg-base-content sm:grid-cols-2 lg:grid-cols-4">
            <WallTile Label="Button" Href="components/button">
                <div class="flex flex-wrap gap-2">
                    <Button Color="Color.Primary" Variant="Variant.Filled">Play</Button>
                    <Button Color="Color.Secondary" Variant="Variant.Outlined">Queue</Button>
                </div>
            </WallTile>
            <WallTile Label="Switch" Href="components/switch">
                <div class="space-y-2">
                    <Switch @bind-Value="_shuffle" Color="Color.Primary" Label="Shuffle" />
                    <Switch @bind-Value="_repeat" Color="Color.Secondary" Label="Repeat" />
                </div>
            </WallTile>
            <WallTile Label="Rating" Href="components/rating">
                <Rating @bind-Value="_stars" Size="Size.Large" />
            </WallTile>
            <WallTile Label="Range" Href="components/range">
                <div class="w-full">
                    <Range @bind-Value="_volume" Color="Color.Tertiary" />
                    <span class="mt-1 block text-sm font-semibold tabular-nums">Volume @_volume.ToString("0")</span>
                </div>
            </WallTile>
            <WallTile Label="Steps" Href="components/steps">
                <Steps Class="w-full text-xs">
                    <Step Color="Color.Primary" Completed="true">Record</Step>
                    <Step Color="Color.Primary" Completed="true">Mix</Step>
                    <Step Active="true">Press</Step>
                </Steps>
            </WallTile>
            <WallTile Label="Alert" Href="components/alert">
                <Alert Severity="Severity.Success" Dense="true" Class="w-full">Pressing finished.</Alert>
            </WallTile>
            <WallTile Label="Radial progress" Href="components/radialprogress">
                <div class="flex items-center gap-4">
                    <RadialProgress Value="72" Color="Color.Primary" SizeRem="4.5rem">72%</RadialProgress>
                    <Loading Type="LoadingType.Bars" Color="Color.Secondary" Size="Size.Large" />
                </div>
            </WallTile>
            <WallTile Label="Chip" Href="components/chip">
                <div class="flex flex-wrap gap-2">
                    <Chip Color="Color.Primary" Text="Yé-yé" />
                    <Chip Color="Color.Secondary" Variant="Variant.Outlined" Text="Pop" />
                    <Chip Color="Color.Tertiary" Text="1965" />
                </div>
            </WallTile>
        </div>
        <a href="components" class="mt-6 inline-flex items-center gap-2 font-bold underline decoration-primary decoration-2 underline-offset-4">
            All @DocRegistry.All.Count components <Icon Name="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
        </a>
    </section>

    @* ── Playground ─────────────────────────────────────────────────────── *@
    <section id="playground" class="scroll-mt-6 border-y-2 border-base-content bg-base-200">
        <div class="mx-auto grid max-w-[1500px] gap-10 px-4 py-20 sm:px-8 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-16 lg:px-14 lg:py-28">
            <div>
                <h2 class="font-display text-[clamp(2.4rem,5vw,4rem)] font-bold leading-[0.95]">Turn every knob.</h2>
                <p class="mt-5 text-lg text-base-content/80">
                    Each component page carries a playground. Its controls are built from DaisyBlazor's own inputs, generated
                    from the component's parameters, and the Razor underneath rewrites itself as you go. Copy it when it sounds right.
                </p>
            </div>
            @if (_buttonPlayground is not null)
            {
                <div class="min-w-0 [&_#playground-title]:sr-only">
                    <Playground Spec="_buttonPlayground" />
                </div>
            }
        </div>
    </section>

    @* ── The crate ──────────────────────────────────────────────────────── *@
    <section id="themes" class="scroll-mt-6 py-20 lg:py-28">
        <div class="mx-auto mb-10 grid max-w-[1500px] gap-4 px-4 sm:px-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,28rem)] lg:items-end lg:px-14">
            <h2 class="font-display text-[clamp(2.4rem,5vw,4rem)] font-bold leading-[0.95]">@ThemeDeck.Themes.Count releases in the crate.</h2>
            <p class="text-lg text-base-content/80">
                Every daisyUI theme ships in the preset, plus two of our own. Put one on: this whole site follows, and so does your
                app through <code class="font-mono text-[0.9em]">ThemeProvider</code>.
            </p>
        </div>
        <ul class="flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-6 sm:px-8 lg:px-14" aria-label="Themes">
            @foreach (string t in ThemeDeck.Themes)
            {
                string theme = t;
                <li class="w-56 shrink-0 snap-start sm:w-64">
                    <ThemeSleeve Theme="@theme" Playing="@(theme == Current)" OnClick="e => PutOn(theme, e)" />
                </li>
            }
        </ul>
        <div class="mx-auto max-w-[1500px] px-4 sm:px-8 lg:px-14">
            <a href="themes" class="inline-flex items-center gap-2 font-bold underline decoration-primary decoration-2 underline-offset-4">
                Browse the crate <Icon Name="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
            </a>
        </div>
    </section>

    @* ── MudBlazor ──────────────────────────────────────────────────────── *@
    <section id="migration" class="scroll-mt-6 border-t-2 border-base-content">
        <div class="mx-auto grid max-w-[1500px] gap-10 px-4 py-20 sm:px-8 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-16 lg:px-14 lg:py-28">
            <div>
                <h2 class="font-display text-[clamp(2.4rem,5vw,4rem)] font-bold leading-[0.95]">Leave MudBlazor one rename at a time.</h2>
                <p class="mt-5 text-lg text-base-content/80">
                    The same parameter names, the same <code class="font-mono text-[0.9em]">Color</code>, <code class="font-mono text-[0.9em]">Variant</code>
                    and <code class="font-mono text-[0.9em]">Size</code> enums, <code class="font-mono text-[0.9em]">Icons.Material.*</code>,
                    <code class="font-mono text-[0.9em]">IDialogService</code> and <code class="font-mono text-[0.9em]">ISnackbar</code>. Move a page,
                    ship it, move the next.
                </p>
                <a href="migration" class="btn mt-7 rounded-full border-2 border-base-content bg-transparent px-6 hover:bg-base-content hover:text-base-100">Read the migration guide</a>
            </div>
            <div class="grid min-w-0 gap-4 xl:grid-cols-2">
                <CodeBlock Title="Before · MudBlazor" Code="@MudSample" />
                <CodeBlock Title="After · DaisyBlazor" Code="@DaisySample" />
            </div>
        </div>
    </section>

    @* ── Charts ─────────────────────────────────────────────────────────── *@
    <section id="charts" class="scroll-mt-6 border-t-2 border-base-content bg-base-200">
        <div class="mx-auto max-w-[1500px] px-4 py-20 sm:px-8 lg:px-14 lg:py-28">
            <div class="mb-10 grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,28rem)] lg:items-end">
                <h2 class="font-display text-[clamp(2.4rem,5vw,4rem)] font-bold leading-[0.95]">Charts that change with the record.</h2>
                <p class="text-lg text-base-content/80">
                    Line, area, bar, pie, donut and sparkline, rendered as plain SVG with theme colours. No JavaScript charting
                    runtime. Switch the theme and watch them follow.
                </p>
            </div>
            <div class="grid gap-4 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
                <div class="rounded-2xl border-2 border-base-content bg-base-100 p-5">
                    <LineChart Series="_streams" Labels="_months" Smooth="true" Area="true" Height="17rem" Title="Monthly streams (thousands, sample data)" />
                </div>
                <div class="rounded-2xl border-2 border-base-content bg-base-100 p-5">
                    <DonutChart Data="_formats" CenterLabel="Sales" Height="17rem" Title="Sales by format (sample data)" />
                </div>
            </div>
            <a href="charts" class="mt-6 inline-flex items-center gap-2 font-bold underline decoration-primary decoration-2 underline-offset-4">
                The charts guide <Icon Name="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
            </a>
        </div>
    </section>

    @* ── No npm ─────────────────────────────────────────────────────────── *@
    <section id="no-npm" class="scroll-mt-6 border-t-2 border-base-content">
        <div class="mx-auto grid max-w-[1500px] gap-10 px-4 py-20 sm:px-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-16 lg:px-14 lg:py-28">
            <div>
                <h2 class="font-display text-[clamp(2.4rem,5vw,4rem)] font-bold leading-[0.95]">No Node. No npm.</h2>
                <p class="mt-5 max-w-xl text-lg text-base-content/80">
                    The NuGet package carries the preset (daisyUI, the themes, a safelist of every class the components emit) and
                    can run the Tailwind standalone CLI on build. One property in your project file, one import in your stylesheet.
                    This site builds its own CSS exactly that way.
                </p>
                <a href="css-preset" class="btn mt-7 rounded-full border-2 border-base-content bg-transparent px-6 hover:bg-base-content hover:text-base-100">How the preset works</a>
            </div>
            <div class="min-w-0 space-y-4">
                <CodeBlock Title="MyApp.csproj" Language="xml" Code="@CsprojSample" />
                <CodeBlock Title="Styles/main.css" Language="css" Code="@CssSample" />
                <MockupCode Class="bg-neutral text-neutral-content" Lines="_buildLines" />
            </div>
        </div>
    </section>

    @* ── Close ──────────────────────────────────────────────────────────── *@
    <section class="sleeve">
        <div class="mx-auto flex max-w-[1500px] flex-col items-start gap-8 px-4 py-20 sm:px-8 lg:flex-row lg:items-end lg:justify-between lg:px-14 lg:py-24">
            <h2 class="max-w-3xl font-display text-[clamp(2.8rem,7vw,6rem)] font-bold leading-[0.9]">Put it on.</h2>
            <div class="flex flex-wrap gap-3">
                <a href="getting-started" class="btn btn-lg rounded-full border-0 bg-primary-content px-7 text-primary hover:bg-primary-content/90">Get started</a>
                <a href="https://github.com/phmatray/daisyblazor" target="_blank" rel="noopener"
                   class="btn btn-lg rounded-full border-2 border-primary-content bg-transparent px-7 text-primary-content hover:bg-primary-content hover:text-primary">Star on GitHub</a>
            </div>
        </div>
    </section>
</main>

@code {
    [CascadingParameter] public ThemeProvider? Provider { get; set; }

    private readonly List<Track> _tracks =
    [
        new("components", "The catalogue"), new("playground", "Playground"), new("themes", "37 themes"),
        new("migration", "From MudBlazor"), new("charts", "Charts"), new("no-npm", "No npm"),
    ];

    private bool _shuffle = true;
    private bool _repeat;
    private int _stars = 4;
    private double _volume = 64;
    private bool _copied;
    private PlaygroundSpec? _buttonPlayground;

    private readonly List<string> _months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug"];
    private readonly List<ChartSeries> _streams =
    [
        new("Side A", [12, 19, 17, 26, 31, 29, 38, 44]),
        new("Side B", [8, 11, 14, 13, 18, 22, 21, 27]),
    ];
    private readonly List<ChartDataPoint> _formats = [new("Vinyl", 46), new("Digital", 38), new("CD", 16)];
    private readonly List<string> _buildLines = ["dotnet build", "DaisyBlazor: tailwindcss -i Styles/main.css -o wwwroot/css/app.css", "Build succeeded."];

    private string Current => Provider?.Theme ?? ThemeDeck.Light;

    private const string MudSample = """
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Download"
                   OnClick="Save">
            Download
        </MudButton>
        """;

    private const string DaisySample = """
        <Button Color="Color.Primary"
                Variant="Variant.Filled"
                StartIcon="@Icons.Material.Filled.Download"
                OnClick="Save">
            Download
        </Button>
        """;

    private const string CsprojSample = """
        <PackageReference Include="DaisyBlazor.Components" Version="*" />

        <PropertyGroup>
          <DaisyBlazorBuildCss>true</DaisyBlazorBuildCss>
        </PropertyGroup>
        """;

    private const string CssSample = """
        @import "tailwindcss";
        @import "../obj/daisyblazor/preset.css";
        """;

    private RenderFragment Cover => __builder =>
    {
        <div class="space-y-3">
            <div class="flex items-center gap-3">
                <Avatar Color="Color.Primary" Size="Size.Medium">SG</Avatar>
                <div class="min-w-0">
                    <span class="block truncate font-display text-lg font-semibold leading-tight">Poupée de cire</span>
                    <span class="block text-xs text-base-content/70">Side A · track 1</span>
                </div>
                <Status Color="Color.Success" Animated="true" AriaLabel="Playing" Class="ml-auto" />
            </div>
            <ProgressLinear Value="38" Color="Color.Primary" Rounded="true" />
            <div class="flex items-center justify-between">
                <Kbd Size="Size.Small">1:03</Kbd>
                <div class="flex gap-1">
                    <IconButton Icon="@Icons.Material.Filled.SkipPrevious" Title="Previous" Size="Size.Small" />
                    <IconButton Icon="@Icons.Material.Filled.Pause" Title="Pause" Color="Color.Primary" />
                    <IconButton Icon="@Icons.Material.Filled.SkipNext" Title="Next" Size="Size.Small" />
                </div>
                <Kbd Size="Size.Small">2:31</Kbd>
            </div>
            <div class="flex flex-wrap gap-1.5">
                <Chip Color="Color.Primary" Size="Size.Small" Text="Yé-yé" />
                <Chip Color="Color.Secondary" Size="Size.Small" Variant="Variant.Outlined" Text="1965" />
            </div>
            <Sparkline Data="_wave" Area="true" Width="100%" Height="2.5rem" Title="Waveform" />
        </div>
    };

    private readonly List<double> _wave = [3, 5, 4, 8, 6, 9, 7, 11, 9, 13, 10, 12, 8, 10, 7, 9, 6, 8];

    protected override void OnInitialized()
    {
        if (Provider is not null) Provider.ThemeChanged += Refresh;
        _buttonPlayground = DocRegistry.Find("button")?.Playground;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private async Task PutOn(string theme, MouseEventArgs e)
    {
        if (Provider is null) return;
        await ThemeDeck.PutOnAsync(Provider, Js, theme, e.ClientX, e.ClientY);
    }

    private async Task CopyInstall()
    {
        _copied = await Js.Copy("dotnet add package DaisyBlazor.Components");
        if (!_copied) return;
        StateHasChanged();
        await Task.Delay(1600);
        _copied = false;
    }

    public void Dispose()
    {
        if (Provider is not null) Provider.ThemeChanged -= Refresh;
    }
}
