@page "/"
@implements IDisposable
@inject DocsJs Js

<PageTitle>DaisyBlazor: daisyUI components and charts for Blazor</PageTitle>
<SeoHead Title="DaisyBlazor: daisyUI components and charts for Blazor" />

<Sleeve Title="daisyUI components and charts for Blazor." Large="true" Releases="true" Tracks="_tracks" Portrait="Cover" PortraitCaption="A few DaisyBlazor components composing a dashboard card">
    <Lede>
        <p>
            @DocRegistry.ComponentCount typed Blazor components and @DocRegistry.ChartCount chart types on Tailwind CSS v4 and daisyUI v5.
            The API mirrors MudBlazor, so an existing app can move one component at a time. @ThemeDeck.Themes.Count themes, and the
            CSS build ships inside the NuGet package.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-3">
            <a href="getting-started" class="btn btn-lg rounded-full border-0 bg-primary-content px-7 text-primary hover:bg-primary-content/90">Get started</a>
            <a href="components" class="btn btn-lg rounded-full border-2 border-primary-content bg-transparent px-7 text-primary-content hover:bg-primary-content hover:text-primary">See the @DocRegistry.ChartCount charts</a>
        </div>
        <button type="button" @onclick="CopyInstall"
                class="mt-5 inline-flex max-w-full items-center gap-3 rounded-full border-2 border-primary-content/40 py-1.5 pl-4 pr-1.5 font-mono text-sm transition hover:border-primary-content"
                aria-label="Copy the install command">
            <span class="sleeve-muted select-none">$</span>
            <span class="truncate">dotnet add package DaisyBlazor.Components</span>
            <span class="grid size-7 shrink-0 place-items-center rounded-full bg-primary-content text-primary">
                <Icon Name="@(_copied ? Icons.Material.Filled.Check : Icons.Material.Filled.ContentCopy)" Size="Size.Small" Class="!text-base" />
            </span>
        </button>
    </Lede>
</Sleeve>

<main id="content" tabindex="-1">
    @* ── The catalogue, live ─────────────────────────────────────────────── *@
    <section id="components" class="mx-auto max-w-[1500px] scroll-mt-6 px-4 py-20 sm:px-8 lg:px-14 lg:py-28">
        <div class="mb-10 grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,28rem)] lg:items-end">
            <h2 class="font-display text-[clamp(2.4rem,5vw,4rem)] font-bold leading-[0.95]">Every component, running live.</h2>
            <p class="text-lg text-base-content/80">
                Every tile is a real component running in your browser through WebAssembly, organised by daisyUI's own
                taxonomy. Click through for examples, source, a playground and the API.
            </p>
        </div>

        <div class="grid gap-px overflow-hidden rounded-2xl border-2 border-base-content bg-base-content sm:grid-cols-2 lg:grid-cols-4">
            <WallTile Label="Button" Href="components/button">
                <div class="flex flex-wrap gap-2">
                    <Button Color="Color.Primary" Variant="Variant.Filled">Save</Button>
                    <Button Color="Color.Secondary" Variant="Variant.Outlined">Cancel</Button>
                </div>
            </WallTile>
            <WallTile Label="Switch" Href="components/switch">
                <div class="space-y-2">
                    <Switch @bind-Value="_shuffle" Color="Color.Primary" Label="Email alerts" />
                    <Switch @bind-Value="_repeat" Color="Color.Secondary" Label="Two-factor auth" />
                </div>
            </WallTile>
            <WallTile Label="Rating" Href="components/rating">
                <Rating @bind-Value="_stars" Size="Size.Large" />
            </WallTile>
            <WallTile Label="Range" Href="components/range">
                <div class="w-full">
                    <Range @bind-Value="_volume" Color="Color.Tertiary" />
                    <span class="mt-1 block text-sm font-semibold tabular-nums">Usage @_volume.ToString("0") %</span>
                </div>
            </WallTile>
            <WallTile Label="Steps" Href="components/steps">
                <Steps Class="w-full text-xs">
                    <Step Color="Color.Primary" Completed="true">Cart</Step>
                    <Step Color="Color.Primary" Completed="true">Shipping</Step>
                    <Step Active="true">Payment</Step>
                </Steps>
            </WallTile>
            <WallTile Label="Alert" Href="components/alert">
                <Alert Severity="Severity.Success" Dense="true" Class="w-full">Deployment succeeded.</Alert>
            </WallTile>
            <WallTile Label="Radial progress" Href="components/radialprogress">
                <div class="flex items-center gap-4">
                    <RadialProgress Value="72" Color="Color.Primary" SizeRem="4.5rem">72%</RadialProgress>
                    <Loading Type="LoadingType.Bars" Color="Color.Secondary" Size="Size.Large" />
                </div>
            </WallTile>
            <WallTile Label="Chip" Href="components/chip">
                <div class="flex flex-wrap gap-2">
                    <Chip Color="Color.Primary" Text="Blazor" />
                    <Chip Color="Color.Secondary" Variant="Variant.Outlined" Text=".NET 10" />
                    <Chip Color="Color.Tertiary" Text="daisyUI" />
                </div>
            </WallTile>
        </div>
        <a href="components" class="mt-6 inline-flex items-center gap-2 font-bold underline decoration-primary decoration-2 underline-offset-4">
            All @DocRegistry.ComponentCount components <Icon Name="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
        </a>
    </section>

    @* ── Charts ─────────────────────────────────────────────────────────── *@
    <section id="charts" class="scroll-mt-6 border-t-2 border-base-content bg-base-200">
        <div class="mx-auto max-w-[1500px] px-4 py-20 sm:px-8 lg:px-14 lg:py-28">
            <div class="mb-10 grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,28rem)] lg:items-end">
                <h2 class="font-display text-[clamp(2.4rem,5vw,4rem)] font-bold leading-[0.95]">@DocRegistry.ChartCount charts, every one in your theme.</h2>
                <p class="text-lg text-base-content/80">
                    From line and bar to Sankey, treemaps, candlesticks, calendars and maps. D3 computes the layout, Razor draws
                    the SVG in theme colours, and the server package can send the finished chart in the first HTML.
                </p>
            </div>
            <ul class="grid grid-cols-2 gap-3 md:grid-cols-3 xl:grid-cols-6" aria-label="A few of the charts">
                @foreach (ComponentDoc doc in _showcase)
                {
                    <li><DocTile Doc="doc" Compact /></li>
                }
            </ul>
            <nav class="mt-8 flex flex-wrap items-center gap-2" aria-label="Chart families">
                @foreach (ChartFamily family in DocRegistry.ChartFamilies)
                {
                    <a href="@($"charts#family-{family.Slug}")" class="rounded-full border-2 border-base-content px-4 py-1.5 text-sm font-bold transition hover:bg-base-content hover:text-base-100">
                        @family.Title <span class="tabular-nums opacity-75">@family.Docs.Count</span>
                    </a>
                }
            </nav>
            <a href="charts" class="mt-8 inline-flex items-center gap-2 font-bold underline decoration-primary decoration-2 underline-offset-4">
                All @DocRegistry.ChartCount charts <Icon Name="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
            </a>
        </div>
    </section>

    @* ── Playground ─────────────────────────────────────────────────────── *@
    <section id="playground" class="scroll-mt-6 border-y-2 border-base-content bg-base-200">
        <div class="mx-auto grid max-w-[1500px] gap-10 px-4 py-20 sm:px-8 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-16 lg:px-14 lg:py-28">
            <div>
                <h2 class="font-display text-[clamp(2.4rem,5vw,4rem)] font-bold leading-[0.95]">Try every parameter.</h2>
                <p class="mt-5 text-lg text-base-content/80">
                    Most component pages, and the main charts, carry a playground. Its controls are built from DaisyBlazor's own
                    inputs, generated from the component's parameters, and the Razor underneath rewrites itself as you go. Copy it once it looks right.
                </p>
            </div>
            @if (_buttonPlayground is not null)
            {
                <div class="min-w-0 [&_#playground-title]:sr-only">
                    <Playground Spec="_buttonPlayground" />
                </div>
            }
        </div>
    </section>

    @* ── Themes ──────────────────────────────────────────────────────── *@
    <section id="themes" class="scroll-mt-6 bg-neutral py-20 text-neutral-content lg:py-28">
        <div class="mx-auto mb-10 grid max-w-[1500px] gap-4 px-4 sm:px-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,28rem)] lg:items-end lg:px-14">
            <h2 class="font-display text-[clamp(2.4rem,5vw,4rem)] font-bold leading-[0.95]">@ThemeDeck.Themes.Count themes, one switch.</h2>
            <p class="text-lg text-neutral-content/85">
                Every daisyUI theme ships in the preset, plus two of our own. Click one: this whole site switches, and your app
                does the same through <code class="font-mono text-[0.9em]">ThemeProvider</code>.
            </p>
        </div>
        <ul class="flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 pb-6 pt-3 sm:scroll-px-8 sm:px-8 lg:scroll-px-14 lg:px-14" aria-label="Themes">
            @foreach (string t in ThemeDeck.Themes)
            {
                string theme = t;
                <li class="w-56 shrink-0 snap-start sm:w-64">
                    <ThemeSleeve Theme="@theme" Playing="@(theme == Current)" OnClick="e => PutOn(theme, e)" />
                </li>
            }
        </ul>
        <div class="mx-auto max-w-[1500px] px-4 sm:px-8 lg:px-14">
            <a href="themes" class="inline-flex items-center gap-2 font-bold underline decoration-2 underline-offset-4">
                All themes <Icon Name="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
            </a>
        </div>
    </section>

    @* ── MudBlazor ──────────────────────────────────────────────────────── *@
    <section id="migration" class="scroll-mt-6 border-t-2 border-base-content">
        <div class="mx-auto grid max-w-[1500px] gap-10 px-4 py-20 sm:px-8 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-16 lg:px-14 lg:py-28">
            <div>
                <h2 class="font-display text-[clamp(2.4rem,5vw,4rem)] font-bold leading-[0.95]">Leave MudBlazor one rename at a time.</h2>
                <p class="mt-5 text-lg text-base-content/80">
                    The same parameter names, the same <code class="font-mono text-[0.9em]">Color</code>, <code class="font-mono text-[0.9em]">Variant</code>
                    and <code class="font-mono text-[0.9em]">Size</code> enums, <code class="font-mono text-[0.9em]">Icons.Material.*</code>,
                    <code class="font-mono text-[0.9em]">IDialogService</code> and <code class="font-mono text-[0.9em]">ISnackbar</code>. Move a page,
                    ship it, move the next.
                </p>
                <a href="migration" class="btn mt-7 rounded-full border-2 border-base-content bg-transparent px-6 hover:bg-base-content hover:text-base-100">Read the migration guide</a>
            </div>
            <div class="grid min-w-0 items-start gap-4 self-start xl:grid-cols-2">
                <CodeBlock Title="Before · MudBlazor" Code="@MudSample" />
                <CodeBlock Title="After · DaisyBlazor" Code="@DaisySample" />
            </div>
        </div>
    </section>

    @* ── No npm ─────────────────────────────────────────────────────────── *@
    <section id="no-npm" class="scroll-mt-6 border-t-2 border-base-content">
        <div class="mx-auto grid max-w-[1500px] gap-10 px-4 py-20 sm:px-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-16 lg:px-14 lg:py-28">
            <div>
                <h2 class="font-display text-[clamp(2.4rem,5vw,4rem)] font-bold leading-[0.95]">No Node. No npm.</h2>
                <p class="mt-5 max-w-xl text-lg text-base-content/80">
                    The NuGet package carries the preset (daisyUI, the themes, a safelist of every class the components emit) and
                    can run the Tailwind standalone CLI on build. One property in your project file, one import in your stylesheet.
                    This site builds its own CSS exactly that way.
                </p>
                <a href="css-preset" class="btn mt-7 rounded-full border-2 border-base-content bg-transparent px-6 hover:bg-base-content hover:text-base-100">How the preset works</a>
            </div>
            <div class="min-w-0 space-y-4">
                <CodeBlock Title="MyApp.csproj" Language="xml" Code="@CsprojSample" />
                <CodeBlock Title="Styles/main.css" Language="css" Code="@CssSample" />
                <MockupCode Class="bg-neutral text-neutral-content" Lines="_buildLines" />
            </div>
        </div>
    </section>

    @* ── Close ──────────────────────────────────────────────────────────── *@
    <section class="sleeve">
        <div class="mx-auto flex max-w-[1500px] flex-col items-start gap-8 px-4 py-20 sm:px-8 lg:flex-row lg:items-end lg:justify-between lg:px-14 lg:py-24">
            <h2 class="max-w-3xl font-display text-[clamp(2.8rem,7vw,6rem)] font-bold leading-[0.9]">Start building.</h2>
            <div class="flex flex-wrap gap-3">
                <a href="getting-started" class="btn btn-lg rounded-full border-0 bg-primary-content px-7 text-primary hover:bg-primary-content/90">Get started</a>
                <a href="https://github.com/phmatray/daisyblazor" target="_blank" rel="noopener"
                   class="btn btn-lg rounded-full border-2 border-primary-content bg-transparent px-7 text-primary-content hover:bg-primary-content hover:text-primary">Star on GitHub</a>
            </div>
        </div>
    </section>
</main>

@code {
    [CascadingParameter] public ThemeProvider? Provider { get; set; }

    private readonly List<Track> _tracks =
    [
        new("components", "Components"), new("charts", "Charts"), new("playground", "Playground"),
        new("themes", "Themes"), new("migration", "From MudBlazor"), new("no-npm", "No npm"),
    ];

    private bool _shuffle = true;
    private bool _repeat;
    private int _stars = 4;
    private double _volume = 64;
    private bool _copied;
    private PlaygroundSpec? _buttonPlayground;

    private static readonly ComponentDoc[] _showcase =
    [
        .. new[] { "sankeychart", "treemapchart", "candlestickchart", "calendarheatmap", "sunburstchart", "waterfallchart",
                   "radarchart", "violinchart", "chordchart", "gaugechart", "streamchart", "choroplethmap" }
            .Select(slug => DocRegistry.Find(slug)!),
    ];
    private readonly List<string> _buildLines = ["dotnet build", "DaisyBlazor: tailwindcss -i Styles/main.css -o wwwroot/css/app.css", "Build succeeded."];

    private string Current => Provider?.Theme ?? ThemeDeck.Light;


    private const string MudSample = """
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Download"
                   OnClick="Save">
            Download
        </MudButton>
        """;

    private const string DaisySample = """
        <Button Color="Color.Primary"
                Variant="Variant.Filled"
                StartIcon="@Icons.Material.Filled.Download"
                OnClick="Save">
            Download
        </Button>
        """;

    private const string CsprojSample = """
        <PackageReference Include="DaisyBlazor.Components" Version="*" />

        <PropertyGroup>
          <DaisyBlazorBuildCss>true</DaisyBlazorBuildCss>
        </PropertyGroup>
        """;

    private const string CssSample = """
        @import "tailwindcss";
        @import "../obj/daisyblazor/preset.css";
        """;

    private RenderFragment Cover => __builder =>
    {
        <div class="space-y-4">
            <div class="flex items-center justify-between">
                <span class="font-display text-lg font-semibold leading-tight">Acme Cloud</span>
                <Chip Color="Color.Success" Size="Size.Small" Text="Production" />
            </div>
            <div>
                <span class="block text-xs font-semibold text-base-content/70">Active users</span>
                <div class="flex items-end justify-between gap-3">
                    <span class="font-display text-3xl font-bold tabular-nums">48.2k</span>
                    <Sparkline Data="_wave" Area="true" Width="7rem" Height="2.25rem" Title="Active users trend" />
                </div>
            </div>
            <div>
                <div class="mb-1 flex justify-between text-xs font-semibold"><span>Sprint 14</span><span class="tabular-nums">68%</span></div>
                <ProgressLinear Value="68" Color="Color.Primary" Rounded="true" />
            </div>
            <div class="flex items-center gap-3 border-t border-base-300 pt-3">
                <Avatar Color="Color.Secondary" Size="Size.Small">AS</Avatar>
                <div class="min-w-0 text-sm">
                    <span class="block truncate font-bold">Ana Silva</span>
                    <span class="block text-xs text-base-content/70">Admin · online</span>
                </div>
                <Status Color="Color.Success" Animated="true" AriaLabel="Online" Class="ml-auto" />
            </div>
            <div class="grid grid-cols-2 gap-2">
                <Button Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" StartIcon="@Icons.Material.Filled.RocketLaunch" Class="w-full px-2">Deploy</Button>
                <Button Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small" Class="w-full px-2">Logs</Button>
            </div>
        </div>
    };

    private readonly List<double> _wave = [3, 5, 4, 8, 6, 9, 7, 11, 9, 13, 10, 12, 8, 10, 7, 9, 6, 8];

    protected override void OnInitialized()
    {
        if (Provider is not null) Provider.ThemeChanged += Refresh;
        _buttonPlayground = DocRegistry.Find("button")?.Playground;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private async Task PutOn(string theme, MouseEventArgs e)
    {
        if (Provider is null) return;
        await ThemeDeck.PutOnAsync(Provider, Js, theme, e.ClientX, e.ClientY);
    }

    private async Task CopyInstall()
    {
        _copied = await Js.Copy("dotnet add package DaisyBlazor.Components");
        if (!_copied) return;
        StateHasChanged();
        await Task.Delay(1600);
        _copied = false;
    }

    public void Dispose()
    {
        if (Provider is not null) Provider.ThemeChanged -= Refresh;
    }
}
