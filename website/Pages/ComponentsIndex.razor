@page "/components"

<DocShell Title="Components" PageTitle="All components" Canonical="components/" Description="@($"{DocRegistry.ComponentCount} daisyUI components and {DocRegistry.ChartCount} SVG chart types for Blazor, each running live with its code, a playground and its API.")" Tracks="_tracks" Portrait="Cover" PortraitCaption="Cover · the whole catalogue">
    <Lede>
        @DocRegistry.ComponentCount daisyUI-native components and @DocRegistry.ChartCount chart types for Blazor, grouped by daisyUI's own
        taxonomy and the charts by family. Every tile below is rendered live, in the active theme.
    </Lede>
    <ChildContent>
        @foreach (IGrouping<Category, ComponentDoc> group in DocRegistry.ByCategory())
        {
            <section id="@group.Key.Slug()" class="mb-16 scroll-mt-6">
                <div class="mb-6 flex flex-wrap items-baseline justify-between gap-2 border-b-2 border-base-content pb-3">
                    <h2 class="font-display text-[2rem] font-bold leading-tight">@group.Key.Title()</h2>
                    <p class="text-base-content/70">@group.Key.Blurb()</p>
                </div>
                @if (group.Key == Category.Charts)
                {
                    foreach (ChartFamily family in DocRegistry.ChartFamilies)
                    {
                        <div id="@family.Slug" class="mb-12 scroll-mt-6">
                            <h3 class="mb-1 font-display text-2xl font-semibold">@family.Title <span class="text-base font-semibold tabular-nums text-base-content/75">@family.Docs.Count</span></h3>
                            <p class="mb-5 text-base-content/80">@family.Blurb</p>
                            <ul class="grid grid-cols-2 gap-3 md:grid-cols-3 xl:grid-cols-4">
                                @foreach (ComponentDoc d in family.Docs)
                                {
                                    <li><DocTile Doc="d" Compact /></li>
                                }
                            </ul>
                        </div>
                    }
                }
                else
                {
                    <ul class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
                        @foreach (ComponentDoc d in group)
                        {
                            <li><DocTile Doc="d" /></li>
                        }
                    </ul>
                }
            </section>
        }
    </ChildContent>
</DocShell>

@code {
    private readonly List<Track> _tracks = [.. DocRegistry.ByCategory().Select(g => new Track(g.Key.Slug(), g.Key.Title()))];

    private static readonly RenderFragment Cover = __builder =>
    {
        <div class="grid grid-cols-3 gap-2">
            @foreach (IGrouping<Category, ComponentDoc> g in DocRegistry.ByCategory())
            {
                <span class="flex aspect-square flex-col justify-between rounded-lg bg-base-200 p-2">
                    <span class="font-display text-2xl font-bold tabular-nums">@g.Count()</span>
                    <span class="text-xs font-bold leading-tight">@g.Key.Title()</span>
                </span>
            }
        </div>
    };
}
