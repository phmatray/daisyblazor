@page "/getting-started"

<DocShell Title="Getting started" Description="@G.Summary" Tracks="G.Tracks" Trail="G.Trail" Portrait="Portrait" PortraitCaption="Your first component">
    <Lede>
        DaisyBlazor is a Tailwind CSS v4 + daisyUI v5 component kit for Blazor, Server or WebAssembly.
        This guide adds it to an existing app in six steps; no Node or npm needed.
    </Lede>
    <ChildContent>
        <div class="prose-doc">
            @H(0)
            <p>Starting a new app? The template wires Tailwind, daisyUI and the providers for you, so you can skip the rest of this page.</p>
            <CodeBlock Language="bash" Code="@Template" />
            <p>Adding DaisyBlazor to an app you already have? Read on.</p>

            @H(1)
            <p>Install the components, and optionally the dependency-free SVG <a href="charts">charts</a>.</p>
            <CodeBlock Language="bash" Code="@Install" />

            @H(2)
            <p>
                DaisyBlazor styles are generated by Tailwind at build time. The package ships the preset (with daisyUI bundled)
                and an MSBuild target that runs the Tailwind standalone CLI. Enable it in the web project's <code>.csproj</code>:
            </p>
            <CodeBlock Language="xml" Title="MyApp.csproj" Code="@Csproj" />

            @H(3)
            <p>Create <code>Styles/main.css</code>:</p>
            <CodeBlock Language="css" Title="Styles/main.css" Code="@MainCss" />
            <Alert Severity="Severity.Info" Dense="true">
                Use <code>preset-core.css</code> instead to skip the 35 built-in daisyUI themes. The <a href="css-preset">CSS preset</a>
                guide has the details and the MSBuild properties.
            </Alert>
            <p>
                <code>dotnet build</code> compiles it to <code>wwwroot/css/app.css</code> (the first build downloads the Tailwind CLI once).
                Link the output in your host page (<code>App.razor</code> or <code>index.html</code>), together with the icon font and the
                pre-paint theme script:
            </p>
            <CodeBlock Language="xml" Title="App.razor" Code="@Head" />

            @H(4)
            <p>Register the services in <code>Program.cs</code>:</p>
            <CodeBlock Language="csharp" Title="Program.cs" Code="@ProgramCs" />
            <p>and add the namespaces to <code>_Imports.razor</code>:</p>
            <CodeBlock Language="razor" Title="_Imports.razor" Code="@Imports" />

            @H(5)
            <p>
                In your main layout, add the <code>ThemeProvider</code> (dark mode and theme switching) and the dialog and snackbar
                hosts, so the services have somewhere to render:
            </p>
            <CodeBlock Language="razor" Title="MainLayout.razor" Code="@Layout" />

            @H(6)
            <p>That's it. Components are ready to use; this is the one in the preview, live:</p>
        </div>
        <div class="mt-5 max-w-[70ch] rounded-2xl border border-base-300 bg-base-100 p-6 [&_.tab-content]:block">@FirstCard</div>
        <div class="prose-doc mt-5">
            <CodeBlock Language="razor" Code="@First" />
            <p>
                Next: <a href="theming">Theming</a> · <a href="css-preset">CSS preset</a> · <a href="components">Components</a>
            </p>
        </div>
    </ChildContent>
</DocShell>

@code {
    private static readonly GuideDoc G = Guides.Get("getting-started");

    private static RenderFragment H(int i) => __builder =>
    {
        <h2 id="@G.Tracks[i].Id" class="scroll-mt-6 font-display">@G.Tracks[i].Title</h2>
    };

    // ponytail: the site does not link the scoped-CSS bundle, so force the Tabs panel visible here (see libraryIssues).
    private RenderFragment Portrait => __builder => { <div class="[&_.tab-content]:block">@FirstCard</div> };

    private static readonly RenderFragment FirstCard = __builder =>
    {
        <Card>
            <CardContent>
                <h2 class="card-title">Hello DaisyBlazor</h2>
                <p>@DocRegistry.ComponentCount daisyUI components and @DocRegistry.ChartCount charts with a MudBlazor-compatible API.</p>
                <Tabs>
                    <Tab Title="One">First panel</Tab>
                    <Tab Title="Two">Second panel</Tab>
                </Tabs>
                <CardActions>
                    <Button Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Check">OK</Button>
                </CardActions>
            </CardContent>
        </Card>
    };

    private const string Template = """
        dotnet new install DaisyBlazor.Templates
        dotnet new daisyblazor -o MyApp
        """;

    private const string Install = """
        dotnet add package DaisyBlazor.Components
        # optional: dependency-free SVG charts
        dotnet add package DaisyBlazor.Charts
        """;

    private const string Csproj = """
        <PropertyGroup>
          <DaisyBlazorBuildCss>true</DaisyBlazorBuildCss>
        </PropertyGroup>
        """;

    private const string MainCss = """
        @import "tailwindcss";
        @import "../obj/daisyblazor/preset.css";  /* daisyUI + themes + class safelist, copied by the package */

        /* Your own markup. The packaged components need no glob: the preset safelists their classes. */
        @source "./Components/**/*.{razor,cs}";
        """;

    private const string Head = """
        <link rel="stylesheet" href="@Assets["css/app.css"]" />
        <!-- Icons rendered by the Icon component + Icons.Material.* -->
        <link rel="stylesheet"
              href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />
        <!-- Applies the saved/OS theme before first paint (no flash, works on static SSR pages) -->
        <script src="_content/DaisyBlazor.Components/theme-init.js"></script>
        <!-- Static SSR pages only: Drawer toggle, Escape and focus handling without a circuit -->
        <script src="_content/DaisyBlazor.Components/drawer.js" defer></script>
        """;

    private const string ProgramCs = """
        using DaisyBlazor;

        builder.Services.AddDaisyBlazor();   // ISnackbar + IDialogService
        """;

    private const string Imports = """
        @using DaisyBlazor
        @using DaisyBlazor.Theming
        """;

    private const string Layout = """
        <ThemeProvider>
            @Body

            <DialogProvider />
            <SnackbarProvider />
        </ThemeProvider>
        """;

    private const string First = """
        <Card>
            <CardContent>
                <h2 class="card-title">Hello DaisyBlazor</h2>
                <p>daisyUI components with a MudBlazor-compatible API.</p>
                <Tabs>
                    <Tab Title="One">First panel</Tab>
                    <Tab Title="Two">Second panel</Tab>
                </Tabs>
                <CardActions>
                    <Button Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Check">OK</Button>
                </CardActions>
            </CardContent>
        </Card>
        """;
}
