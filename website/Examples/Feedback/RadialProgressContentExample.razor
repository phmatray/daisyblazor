<div class="flex flex-wrap items-center gap-6">
    <RadialProgress Value="@(_elapsed * 100 / 214)" Color="Color.Secondary" SizeRem="7rem" Thickness="8px">
        <span class="font-mono text-sm">@TimeSpan.FromSeconds(_elapsed).ToString(@"m\:ss")</span>
    </RadialProgress>
    <div class="flex gap-2">
        <Button Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => _elapsed = Math.Max(0, _elapsed - 30))">−30 s</Button>
        <Button Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => _elapsed = Math.Min(214, _elapsed + 30))">+30 s</Button>
    </div>
</div>

@code {
    // A 3:34 build; the ring shows how much time has elapsed.
    private int _elapsed = 96;
}
