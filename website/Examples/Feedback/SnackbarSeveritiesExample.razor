@inject ISnackbar Snackbar

<div class="flex flex-wrap gap-3">
    <Button Variant="Variant.Outlined" OnClick="@(() => Snackbar.Add("Task added to the sprint"))">Normal</Button>
    <Button Color="Color.Info" Variant="Variant.Filled" OnClick="@(() => Snackbar.Add("Deploy starts in 5 minutes", Severity.Info))">Info</Button>
    <Button Color="Color.Success" Variant="Variant.Filled" OnClick="@(() => Snackbar.Add("Invoice INV-1042 paid", Severity.Success))">Success</Button>
    <Button Color="Color.Warning" Variant="Variant.Filled" OnClick="@(() => Snackbar.Add("Storage almost full", Severity.Warning))">Warning</Button>
    <Button Color="Color.Error" Variant="Variant.Filled" OnClick="@(() => Snackbar.Add("Payment declined", Severity.Error))">Error</Button>
</div>
