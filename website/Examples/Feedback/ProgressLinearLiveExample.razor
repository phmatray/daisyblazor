<div class="flex flex-col gap-3">
    <div class="flex justify-between text-sm">
        <span>side-a-master.wav</span>
        <span>@_progress%</span>
    </div>
    <ProgressLinear Value="_progress" Color="@(_progress == 100 ? Color.Success : Color.Primary)" Rounded="true" />
    <div>
        <Button Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Disabled="_running" OnClick="UploadAsync">
            Upload master
        </Button>
    </div>
</div>

@code {
    private int _progress;
    private bool _running;

    private async Task UploadAsync()
    {
        _running = true;
        for (_progress = 0; _progress < 100; _progress += 5)
        {
            StateHasChanged();
            await Task.Delay(80);
        }
        _running = false;
    }
}
