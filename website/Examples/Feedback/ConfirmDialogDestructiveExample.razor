@inject IDialogService DialogService

<div class="flex flex-wrap items-center gap-3">
    <Button Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteAsync">Delete playlist</Button>
    <span class="text-sm text-base-content/70">@_status</span>
</div>

@code {
    private string _status = "“Summer ’67” · 24 tracks";

    private async Task DeleteAsync()
    {
        IDialogReference dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete “Summer ’67”?", new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, "The playlist and its 24 tracks will be gone for good." },
            { x => x.ButtonText, "Delete" },
            { x => x.Color, Color.Error },
        });

        DialogResult result = await dialog.Result;
        _status = result.Canceled ? "Kept it." : "Deleted.";
    }
}
