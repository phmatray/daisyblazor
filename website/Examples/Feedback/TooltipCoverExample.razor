<div class="flex flex-col items-center gap-16 pt-10">
    <Tooltip Text="Now playing: Comic Strip" Class="tooltip-open tooltip-primary">
        <Button Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large" StartIcon="@Icons.Material.Filled.PlayArrow">Play</Button>
    </Tooltip>
    <div class="flex gap-12 pb-8">
        <Tooltip Text="Shuffle" Placement="Placement.Bottom" Class="tooltip-open tooltip-secondary">
            <IconButton Icon="@Icons.Material.Filled.Shuffle" aria-label="Shuffle" />
        </Tooltip>
        <Tooltip Text="Repeat" Placement="Placement.Bottom" Class="tooltip-open tooltip-accent">
            <IconButton Icon="@Icons.Material.Filled.Repeat" aria-label="Repeat" />
        </Tooltip>
    </div>
</div>
