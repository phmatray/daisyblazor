<div class="flex flex-col gap-3">
    <ErrorAlert Message="@_error" Class="" />
    <TextField Label="Project key" @bind-Value="_projectKey" Immediate="true" Margin="Margin.None" />
    <div>
        <Button Color="Color.Primary" Variant="Variant.Filled" Loading="_saving" OnClick="SaveAsync">Save</Button>
    </div>
</div>

@code {
    private string? _projectKey = "ACME";
    private string? _error;
    private bool _saving;

    private async Task SaveAsync()
    {
        _error = null;
        _saving = true;
        try
        {
            await Task.Delay(600);
            throw new InvalidOperationException($"Project key “{_projectKey}” is already taken.");
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
