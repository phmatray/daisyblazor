@inject IDialogService DialogService

<div class="flex flex-wrap gap-3">
    <Button Variant="Variant.Outlined" OnClick="WideAsync">Wide, with close button</Button>
    <Button Variant="Variant.Outlined" OnClick="StrictAsync">No backdrop or Escape dismiss</Button>
</div>

@code {
    private Task WideAsync() => DialogService.ShowAsync<MessageBoxDialog>("Liner notes",
        new DialogParameters { ["Message"] = "Recorded at Studio Barclay, Paris, in the spring of 1968. Arrangements by Jean-Claude Vannier." },
        new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });

    private Task StrictAsync() => DialogService.ShowAsync<MessageBoxDialog>("Terms of sale",
        new DialogParameters { ["Message"] = "Please read and accept before checkout.", ["YesText"] = "I accept" },
        new DialogOptions { BackdropClick = false, CloseOnEscapeKey = false });
}
