@* A static stand-in for the box DialogProvider renders, so the cover can show a dialog without opening one. *@
<div class="w-full rounded-box bg-base-100 p-6 shadow-xl ring-1 ring-base-300">
    <Dialog Title="Deploy v2.4.0 to production?">
        <DialogContent>
            <p>12 services restart in all 3 regions on Friday at midnight.</p>
        </DialogContent>
        <DialogActions>
            <Button Variant="Variant.Text">Later</Button>
            <Button Color="Color.Primary" Variant="Variant.Filled">Deploy</Button>
        </DialogActions>
    </Dialog>
</div>
