@inject IDialogService DialogService

<div class="flex flex-wrap items-center gap-3">
    <Button Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Edit" OnClick="RenameAsync">Rename task</Button>
    <span>Task 4: <strong>@_title</strong></span>
</div>

@code {
    private string _title = "Update billing page";

    private async Task RenameAsync()
    {
        DialogParameters<DialogTaskEditorExample> parameters = new() { { x => x.Title, _title } };
        IDialogReference dialog = await DialogService.ShowAsync<DialogTaskEditorExample>("Rename task", parameters);
        DialogResult result = await dialog.Result;

        if (!result.Canceled && result.Data is string title)
        {
            _title = title;
        }
    }
}
