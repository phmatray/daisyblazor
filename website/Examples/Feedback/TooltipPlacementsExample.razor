<div class="flex flex-wrap items-center justify-center gap-4 py-10">
    <Tooltip Text="Above" Placement="Placement.Top">
        <Button Variant="Variant.Outlined">Top</Button>
    </Tooltip>
    <Tooltip Text="Below" Placement="Placement.Bottom">
        <Button Variant="Variant.Outlined">Bottom</Button>
    </Tooltip>
    <Tooltip Text="To the left" Placement="Placement.Left">
        <Button Variant="Variant.Outlined">Left</Button>
    </Tooltip>
    <Tooltip Text="To the right" Placement="Placement.Right">
        <Button Variant="Variant.Outlined">Right</Button>
    </Tooltip>
</div>
