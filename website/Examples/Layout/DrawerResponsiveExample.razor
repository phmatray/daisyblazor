@* Docked from the lg breakpoint up; below it, the toggle button takes over. *@
<div class="h-72 overflow-hidden rounded-box border-2 border-base-300">
    <Drawer @bind-Open="_open" Class="h-full lg:drawer-open" ToggleClass="btn btn-sm m-4 lg:hidden">
        <ToggleContent>
            <Icon Name="@Icons.Material.Filled.Menu" Size="Size.Small" /> Menu
        </ToggleContent>
        <SideContent>
            <div class="flex min-h-full w-48 flex-col gap-1 bg-neutral p-3 text-neutral-content">
                <p class="px-2 pb-2 font-display text-lg font-bold">Acme Cloud</p>
                <Button Variant="Variant.Text" Class="justify-start text-neutral-content">Overview</Button>
                <Button Variant="Variant.Text" Class="justify-start text-neutral-content">Deployments</Button>
                <Button Variant="Variant.Text" Class="justify-start text-neutral-content">Billing</Button>
            </div>
        </SideContent>
        <ChildContent>
            <div class="p-4">
                <p class="font-display text-xl font-bold">Overview</p>
                <p class="text-sm text-base-content/70">Resize the window below 1024px to collapse the sidebar.</p>
            </div>
        </ChildContent>
    </Drawer>
</div>

@code {
    private bool _open;
}
