<div class="grid gap-6 sm:grid-cols-2">
    <div>
        <p class="mb-2 text-sm font-semibold">Column (default)</p>
        <Stack Spacing="2" AlignItems="AlignItems.Start">
            <Chip Text="Dev" Color="Color.Primary" />
            <Chip Text="Staging" Color="Color.Secondary" />
            <Chip Text="Production" Color="Color.Tertiary" />
        </Stack>
    </div>
    <div>
        <p class="mb-2 text-sm font-semibold">Row="true"</p>
        <Stack Row="true" Spacing="2">
            <Chip Text="Dev" Color="Color.Primary" />
            <Chip Text="Staging" Color="Color.Secondary" />
            <Chip Text="Production" Color="Color.Tertiary" />
        </Stack>
    </div>
</div>
