    <aside>
        <Icon Name="@Icons.Material.Filled.Album" Size="Size.Large" />
        <p class="font-display text-lg font-bold">Disques Soleil</p>
        <p>Pressing records in Lyon since 1964</p>
    </aside>
    <nav class="flex gap-2">
        <IconButton Icon="@Icons.Material.Filled.Email" Title="Newsletter" />
        <IconButton Icon="@Icons.Material.Filled.Radio" Title="Radio" />
        <IconButton Icon="@Icons.Material.Filled.Share" Title="Share" />
    </nav>
</Footer>
