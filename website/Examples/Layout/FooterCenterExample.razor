@* grid-flow-row stacks the sections; footer-center alone lays them out in a row. *@
<Footer Center="true" Color="Color.Primary" Class="grid-flow-row rounded-box text-primary-content">
    <aside>
        <Icon Name="@Icons.Material.Filled.Cloud" Size="Size.Large" />
        <p class="font-display text-lg font-bold">Acme Cloud</p>
        <p>Hosting apps for teams since 2014</p>
    </aside>
    <nav class="flex gap-2">
        <IconButton Icon="@Icons.Material.Filled.Email" Title="Newsletter" />
        <IconButton Icon="@Icons.Material.Filled.Article" Title="Blog" />
        <IconButton Icon="@Icons.Material.Filled.Share" Title="Share" />
    </nav>
</Footer>
