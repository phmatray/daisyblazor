<div class="grid gap-4 sm:grid-cols-2">
    <SectionCard Title="Tighter" Icon="@Icons.Material.Filled.Tune" ShowDivider="false" Elevation="1">
        <p class="text-sm">ShowDivider="false" drops the rule under the header.</p>
    </SectionCard>
    <SectionCard Title="Larger title" TitleTypo="Typo.h5" Elevation="0" Class="border border-base-300">
        <p class="text-sm">TitleTypo sets the title scale; Elevation="0" plus a border gives a flat card.</p>
    </SectionCard>
</div>
