<div class="space-y-3 rounded-box bg-base-200 py-4">
    <Container MaxWidth="MaxWidth.Small" Class="rounded-box bg-base-100 py-3 text-sm">
        <strong>MaxWidth.Small</strong>: an article column, capped at the sm breakpoint (640px).
    </Container>
    <Container MaxWidth="MaxWidth.Large" Class="rounded-box bg-base-100 py-3 text-sm">
        <strong>MaxWidth.Large</strong> (default): the usual page column, capped at 1024px.
    </Container>
    <Container MaxWidth="MaxWidth.False" Class="max-w-xs rounded-box bg-base-100 py-3 text-sm">
        <strong>MaxWidth.False</strong> plus your own <code>max-w-xs</code>.
    </Container>
</div>
