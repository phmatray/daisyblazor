<Paper Elevation="3" OnClick="() => _runs++" Class="flex max-w-sm cursor-pointer items-center gap-4 p-4 transition hover:shadow-lg">
    <div class="grid size-12 place-items-center rounded-box bg-primary text-primary-content">
        <Icon Name="@Icons.Material.Filled.PlayArrow" />
    </div>
    <div>
        <p class="font-semibold">Nightly build</p>
        <p class="text-sm text-base-content/70">Ran @_runs @(_runs == 1 ? "time" : "times")</p>
    </div>
</Paper>

@code {
    private int _runs;
}
