<div class="flex flex-wrap items-center gap-6">
    @foreach ((string initials, string name, string tone) in _members)
    {
        <div class="flex items-center gap-3">
            <Mask Shape="MaskShape.Squircle" Class="@($"grid size-14 place-items-center font-display text-lg font-bold {tone}")">@initials</Mask>
            <span class="font-semibold">@name</span>
        </div>
    }
</div>

@code {
    private readonly (string Initials, string Name, string Tone)[] _members =
    [
        ("AS", "Ana Silva", "bg-primary text-primary-content"),
        ("TB", "Tom Becker", "bg-secondary text-secondary-content"),
        ("PN", "Priya Nair", "bg-accent text-accent-content"),
    ];
}
