<Stack Spacing="3">
    @foreach (Justify justify in new[] { Justify.FlexStart, Justify.Center, Justify.SpaceBetween, Justify.SpaceEvenly })
    {
        <div>
            <p class="mb-1 font-mono text-xs">Justify.@justify</p>
            <Stack Row="true" Justify="justify" Spacing="2" Class="rounded-box bg-base-200 p-2">
                <div class="size-8 rounded-box bg-primary"></div>
                <div class="size-8 rounded-box bg-secondary"></div>
                <div class="size-8 rounded-box bg-accent"></div>
            </Stack>
        </div>
    }
</Stack>
