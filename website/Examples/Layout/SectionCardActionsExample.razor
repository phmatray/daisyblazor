<SectionCard Title="Weekly sales" Icon="@Icons.Material.Filled.Album">
    <HeaderActions>
        <Button Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="Refresh">Refresh</Button>
    </HeaderActions>
    <ChildContent>
        <p class="font-display text-4xl font-bold">@_sold</p>
        <p class="text-sm text-base-content/70">records sold since Monday</p>
    </ChildContent>
</SectionCard>

@code {
    private int _sold = 1284;

    private void Refresh() => _sold += Random.Shared.Next(3, 40);
}
