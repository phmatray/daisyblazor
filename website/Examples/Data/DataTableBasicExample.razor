@inject ISnackbar Snackbar

<DataTable T="Project" Items="_projects" Dense="true" PageSizeOptions="[5, 10]">
    <Columns>
        <PropertyColumn T="Project" TProperty="string" Property="p => p.Name" Title="Project" />
        <PropertyColumn T="Project" TProperty="string" Property="p => p.Owner" Title="Owner" />
        <PropertyColumn T="Project" TProperty="int" Property="p => p.OpenTasks" Title="Open tasks" />
    </Columns>
    <Actions>
        <IconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Title="Open"
                    OnClick="@(() => Snackbar.Add($"Opening {context.Name}"))" />
        <IconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Title="Edit"
                    OnClick="@(() => Snackbar.Add($"Editing {context.Name}"))" />
    </Actions>
</DataTable>

@code {
    private record Project(string Name, string Owner, int OpenTasks);

    private readonly Project[] _projects =
    [
        new("Billing revamp", "Ana Silva", 14),
        new("Mobile app", "Tom Becker", 27),
        new("Customer portal", "Priya Nair", 9),
        new("Status page", "Lucas Martin", 3),
        new("Data export API", "Mei Chen", 18),
        new("Onboarding flow", "Omar Haddad", 6),
    ];
}
