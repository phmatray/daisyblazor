<FilterPanel ActiveFilters="_active" OnApply="Apply" OnClear="Clear" OnRemoveFilter="Remove">
    <Item xs="12" sm="6">
        <TextField Label="Customer" Placeholder="Northwind Traders" @bind-Value="_customer" />
    </Item>
    <Item xs="12" sm="6">
        <Select T="string" Label="Plan" @bind-Value="_plan">
            <SelectItem T="string" Value="@("Free")">Free</SelectItem>
            <SelectItem T="string" Value="@("Pro")">Pro</SelectItem>
            <SelectItem T="string" Value="@("Enterprise")">Enterprise</SelectItem>
        </Select>
    </Item>
</FilterPanel>

@code {
    private string? _customer;
    private string? _plan = "Pro";
    private List<ActiveFilter> _active = [new("plan", "Plan: Pro")];

    private void Apply()
    {
        _active = [];
        if (!string.IsNullOrWhiteSpace(_customer)) _active.Add(new("customer", $"Customer: {_customer}"));
        if (_plan is not null) _active.Add(new("plan", $"Plan: {_plan}"));
    }

    private void Clear()
    {
        _customer = null;
        _plan = null;
        _active = [];
    }

    private void Remove(ActiveFilter filter)
    {
        if (filter.Key == "customer") _customer = null;
        if (filter.Key == "plan") _plan = null;
        _active.Remove(filter);
    }
}
