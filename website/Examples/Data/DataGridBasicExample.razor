<DataGrid T="Customer" Items="_customers" Hover="true">
    <Columns>
        <PropertyColumn T="Customer" TProperty="string" Property="c => c.Company" Title="Company" />
        <PropertyColumn T="Customer" TProperty="string" Property="c => c.Plan" Title="Plan" />
        <PropertyColumn T="Customer" TProperty="int" Property="c => c.Seats" Title="Seats" Format="N0" CellClass="text-right whitespace-nowrap" HeaderClass="text-right" />
        <PropertyColumn T="Customer" TProperty="decimal" Property="c => c.Mrr" Title="MRR" Format="#,##0.00 €" CellClass="text-right whitespace-nowrap" HeaderClass="text-right" />
    </Columns>
</DataGrid>

@code {
    private record Customer(string Company, string Plan, int Seats, decimal Mrr);

    private readonly Customer[] _customers =
    [
        new("Northwind Traders", "Enterprise", 240, 4_890.00m),
        new("Contoso", "Pro", 58, 1_131.00m),
        new("Fabrikam", "Pro", 32, 624.00m),
        new("Globex", "Enterprise", 410, 7_995.00m),
        new("Initech", "Free", 5, 0.00m),
    ];
}
