<div class="mb-4 flex flex-wrap gap-x-6 gap-y-2">
    <Switch @bind-Value="_dense" Color="Color.Primary">Dense</Switch>
    <Switch @bind-Value="_striped" Color="Color.Primary">Striped</Switch>
    <Switch @bind-Value="_bordered" Color="Color.Primary">Bordered</Switch>
    <Switch @bind-Value="_loading" Color="Color.Primary">Loading</Switch>
</div>

<DataGrid T="Format" Items="_formats" Dense="_dense" Striped="_striped" Bordered="_bordered"
          Loading="_loading" SkeletonRows="4" Hover="true">
    <Columns>
        <PropertyColumn T="Format" TProperty="string" Property="f => f.Name" Title="Format" />
        <PropertyColumn T="Format" TProperty="int" Property="f => f.Units" Title="Units sold" Format="N0" />
        <PropertyColumn T="Format" TProperty="double" Property="f => f.Share" Title="Share" Format="P0" />
    </Columns>
</DataGrid>

@code {
    private bool _dense;
    private bool _striped = true;
    private bool _bordered = true;
    private bool _loading;

    private record Format(string Name, int Units, double Share);

    private readonly Format[] _formats =
    [
        new("Vinyl LP", 48_200, 0.41),
        new("Digital", 39_900, 0.34),
        new("CD", 21_100, 0.18),
        new("Cassette", 8_300, 0.07),
    ];
}
