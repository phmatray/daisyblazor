<FilterPanel Title="Filtres" ActiveFiltersLabel="Filtres actifs :" ResetLabel="Réinitialiser"
             ClearLabel="Effacer" ApplyLabel="Filtrer"
             ActiveFilters="_active" OnApply="() => { }" OnClear="() => _active = []"
             OnRemoveFilter="f => _active = _active.Where(x => x != f).ToList()">
    <Item xs="12">
        <TextField Label="Label" Placeholder="Disques Vogue" />
    </Item>
</FilterPanel>

@code {
    private List<ActiveFilter> _active = [new("decade", "Années 60"), new("genre", "Yé-yé")];
}
