<DataGrid T="Order" Items="_orders" Hover="true" Striped="true" RowsPerPage="4"
          RowClick="args => _selected = args.Item" RowStyle="cursor: pointer;">
    <Columns>
        <PropertyColumn T="Order" TProperty="string" Property="o => o.Number" Title="Order" />
        <PropertyColumn T="Order" TProperty="string" Property="o => o.Shop" Title="Record shop" />
        <PropertyColumn T="Order" TProperty="int" Property="o => o.Copies" Title="Copies" />
    </Columns>
    <PagerContent>
        <DataGridPager T="Order" PageSizeOptions="[4, 8, 12]" />
    </PagerContent>
</DataGrid>

<p class="mt-3 text-sm">
    Selected: <strong>@(_selected is null ? "click a row" : $"{_selected.Number} · {_selected.Shop}")</strong>
</p>

@code {
    private record Order(string Number, string Shop, int Copies);

    private static readonly string[] Shops =
        ["Disquaire Lutèce", "Sillon Bleu", "Rue des Martyrs Records", "Le Microsillon", "Pop Shop Lyon", "Vinyl Sud"];

    private readonly Order[] _orders = Enumerable.Range(1, 11)
        .Select(i => new Order($"#45-{1020 + i}", Shops[i % Shops.Length], 25 * (i % 5 + 1)))
        .ToArray();

    private Order? _selected;
}
