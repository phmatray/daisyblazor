<div class="flex w-full flex-col gap-1">
    <span class="text-sm font-bold">Screenshots (images, several at once)</span>
    <FileInput Color="Color.Primary" Accept="image/*" Multiple="true" OnChange="OnChange" Class="w-full" />
</div>
<ul class="mt-3 list-inside list-disc text-sm">
    @foreach (string name in _names)
    {
        <li class="font-mono">@name</li>
    }
</ul>
@if (_names.Count == 0)
{
    <p class="text-sm opacity-60">No images chosen yet.</p>
}

@code {
    private List<string> _names = [];

    private void OnChange(InputFileChangeEventArgs e) =>
        _names = [.. e.GetMultipleFiles(20).Select(f => f.Name)];
}
