@* The values are plain hex strings, so they can drive any style. *@
<div class="grid w-full items-center gap-4 sm:grid-cols-[1fr_auto]">
    <div class="flex flex-col">
        <ColorPicker Label="Sleeve" @bind-Value="_sleeve" />
        <ColorPicker Label="Lettering" @bind-Value="_ink" />
    </div>
    <div class="grid size-40 place-items-center rounded-md border-2 border-base-content p-3 text-center"
         style="background:@_sleeve; color:@_ink">
        <span class="font-display text-2xl font-bold leading-tight">Le Temps de l'amour</span>
    </div>
</div>

@code {
    private string? _sleeve = "#f2c14e";
    private string? _ink = "#1d3557";
}
