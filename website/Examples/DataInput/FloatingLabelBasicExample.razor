<div class="grid w-full gap-4 sm:grid-cols-2">
    <FloatingLabel Label="Full name">
        <input class="input w-full" type="text" placeholder="Full name" @bind="_name" @bind:event="oninput" />
    </FloatingLabel>
    <FloatingLabel Label="Email address">
        <input class="input w-full" type="email" placeholder="Email address" @bind="_email" @bind:event="oninput" />
    </FloatingLabel>
</div>
<p class="mt-3 font-mono text-sm">@(string.IsNullOrEmpty(_name) ? "(no name)" : _name) &lt;@(string.IsNullOrEmpty(_email) ? "no email" : _email)&gt;</p>

@code {
    private string? _name = "Ana Silva";
    private string? _email;
}
