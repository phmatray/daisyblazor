<div class="flex flex-col gap-1">
    <DatePicker Label="Kick-off" @bind-Date="_kickoff" Margin="Margin.None" DateFormat="dd/MM/yyyy" />
    <DatePicker Label="Go-live" @bind-Date="_goLive" Margin="Margin.None" DateFormat="dd/MM/yyyy" />
    <div class="mt-3 flex items-baseline justify-between border-t-2 border-base-content pt-2">
        <span class="text-sm font-bold uppercase tracking-widest">Live in</span>
        <span class="font-display text-3xl font-bold">@(((_goLive ?? DateTime.Today) - (_kickoff ?? DateTime.Today)).Days) days</span>
    </div>
</div>

@code {
    private DateTime? _kickoff = new DateTime(2026, 3, 2);
    private DateTime? _goLive = new DateTime(2026, 4, 20);
}
