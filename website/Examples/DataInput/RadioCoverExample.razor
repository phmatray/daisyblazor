<div class="flex flex-col gap-3">
    <p class="text-xs font-extrabold uppercase tracking-[0.2em]">Speed</p>
    <RadioGroup T="int" @bind-Value="_rpm">
        <Radio Option="33" Color="Color.Primary" Size="Size.Large"><span class="font-display text-3xl font-bold">33⅓</span></Radio>
        <Radio Option="45" Color="Color.Primary" Size="Size.Large"><span class="font-display text-3xl font-bold">45</span></Radio>
        <Radio Option="78" Color="Color.Primary" Size="Size.Large"><span class="font-display text-3xl font-bold">78</span></Radio>
    </RadioGroup>
</div>

@code {
    private int _rpm = 45;
}
