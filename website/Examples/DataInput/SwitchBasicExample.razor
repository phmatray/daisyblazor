<div class="flex flex-col gap-2">
    <Switch Label="Email notifications" Color="Color.Primary" @bind-Value="_email" />
    <Switch Label="Weekly digest" Color="Color.Primary" @bind-Value="_digest" />
</div>
<p class="mt-3 font-mono text-sm">email=@_email · digest=@_digest</p>

@code {
    private bool _email = true;
    private bool _digest;
}
