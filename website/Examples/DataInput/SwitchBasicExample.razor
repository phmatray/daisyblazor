<div class="flex flex-col gap-2">
    <Switch Label="Shuffle" Color="Color.Primary" @bind-Value="_shuffle" />
    <Switch Label="Repeat side" Color="Color.Primary" @bind-Value="_repeat" />
</div>
<p class="mt-3 font-mono text-sm">shuffle=@_shuffle · repeat=@_repeat</p>

@code {
    private bool _shuffle = true;
    private bool _repeat;
}
