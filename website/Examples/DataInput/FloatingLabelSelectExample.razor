<FloatingLabel Label="Genre">
    <select class="select w-full" @bind="_genre">
        <option value="yeye">Yé-yé</option>
        <option value="chanson">Chanson</option>
        <option value="jazz">Jazz</option>
    </select>
</FloatingLabel>
<p class="mt-3 text-sm">Genre: <span class="font-mono">@_genre</span></p>

@code {
    private string _genre = "yeye";
}
