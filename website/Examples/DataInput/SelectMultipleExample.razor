<Select T="string" Label="Genres" MultiSelection="true" @bind-SelectedValues="_genres"
        HelperText="Hold Ctrl (or ⌘) to pick several.">
    <SelectItem Value="@("Yé-yé")" />
    <SelectItem Value="@("Chanson")" />
    <SelectItem Value="@("Jazz")" />
    <SelectItem Value="@("Bossa nova")" />
    <SelectItem Value="@("Psychedelic")" />
</Select>
<p class="mt-3 text-sm">Selected: <span class="font-mono">@string.Join(", ", _genres)</span></p>

@code {
    private IEnumerable<string> _genres = ["Yé-yé", "Jazz"];
}
