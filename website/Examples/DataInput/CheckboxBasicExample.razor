<div class="flex flex-col gap-2">
    <Checkbox Label="Include the lyric sheet" Color="Color.Primary" @bind-Value="_lyrics" />
    <Checkbox Label="Gift wrap" Color="Color.Primary" @bind-Value="_gift" />
</div>
<p class="mt-3 font-mono text-sm">lyrics=@_lyrics · gift=@_gift</p>

@code {
    private bool _lyrics = true;
    private bool _gift;
}
