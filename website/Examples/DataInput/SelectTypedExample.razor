<div class="grid w-full gap-x-4 sm:grid-cols-2">
    <Select T="int" Label="Speed" @bind-Value="_rpm">
        <SelectItem Value="33">33⅓ rpm</SelectItem>
        <SelectItem Value="45">45 rpm</SelectItem>
        <SelectItem Value="78">78 rpm</SelectItem>
    </Select>
    <Select T="DayOfWeek" Label="Release day" @bind-Value="_day">
        <SelectItem Value="DayOfWeek.Monday" />
        <SelectItem Value="DayOfWeek.Wednesday" />
        <SelectItem Value="DayOfWeek.Friday" />
    </Select>
</div>
<p class="mt-3 font-mono text-sm">rpm=@_rpm · day=@_day</p>

@code {
    private int _rpm = 45;
    private DayOfWeek _day = DayOfWeek.Friday;
}
