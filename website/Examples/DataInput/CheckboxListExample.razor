<div class="flex flex-col gap-2">
    <Checkbox Label="Side A — all tracks" Color="Color.Secondary" Value="_tracks.All(t => t.On)" ValueChanged="SetAll" />
    <div class="ml-7 flex flex-col gap-2">
        @foreach (Track t in _tracks)
        {
            <Checkbox Label="@t.Title" Color="Color.Secondary" Size="Size.Small" @bind-Value="t.On" />
        }
    </div>
</div>
<p class="mt-3 text-sm">@_tracks.Count(t => t.On) of @_tracks.Count tracks on the playlist</p>

@code {
    private class Track(string title, bool on)
    {
        public string Title { get; } = title;
        public bool On { get; set; } = on;
    }

    private readonly List<Track> _tracks =
    [
        new("Comment te dire adieu", true),
        new("Mon amie la rose", true),
        new("Le temps de l'amour", false),
    ];

    private void SetAll(bool on) => _tracks.ForEach(t => t.On = on);
}
