<div class="grid w-full gap-4 sm:grid-cols-2">
    <TextField Label="Search projects" Placeholder="Name, owner, tag…" @bind-Value="_query" Immediate="true"
               Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
    <TextField Label="Workspace" Placeholder="your-team" @bind-Value="_site" Immediate="true"
               Adornment="Adornment.End" AdornmentText=".acme.cloud" />
</div>
<p class="mt-3 text-sm">
    Query: <span class="font-mono">@(_query ?? "(empty)")</span> ·
    Site: <span class="font-mono">@(string.IsNullOrEmpty(_site) ? "(empty)" : _site + ".acme.cloud")</span>
</p>

@code {
    private string? _query;
    private string? _site = "northwind";
}
