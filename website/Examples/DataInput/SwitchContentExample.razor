@* ChildContent replaces Label when the text needs markup. *@
<Switch Color="Color.Secondary" @bind-Value="_hifi">
    <span>
        <b>Hi-fi stereo</b>
        <span class="block text-xs opacity-60">@(_hifi ? "Stereo pressing selected" : "Mono pressing selected")</span>
    </span>
</Switch>

@code {
    private bool _hifi = true;
}
