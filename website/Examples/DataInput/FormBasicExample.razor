@* Form stacks its fields with consistent spacing; wrap it in an EditForm or a <form> when you need submit semantics. *@
@inject ISnackbar Snackbar

<Form Class="max-w-md">
    <TextField Label="Name" @bind-Value="_order.Name" Immediate="true" Margin="Margin.None" />
    <TextField Label="Email" InputType="InputType.Email" @bind-Value="_order.Email" Immediate="true" Margin="Margin.None" />
    <Select T="string" Label="Plan" @bind-Value="_order.Plan" Margin="Margin.None">
        <SelectItem Value="@("Pro")">Pro — €29/month</SelectItem>
        <SelectItem Value="@("Enterprise")">Enterprise — €99/month</SelectItem>
    </Select>
    <Switch Label="Send me the newsletter" Color="Color.Primary" @bind-Value="_order.Newsletter" />
    <div class="flex justify-end gap-2">
        <Button Variant="Variant.Text" OnClick="() => _order = new()">Reset</Button>
        <Button Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Place order</Button>
    </div>
</Form>
<p class="mt-3 font-mono text-xs opacity-70">@_order</p>

@code {
    private record Order
    {
        public string? Name { get; set; } = "Ana Silva";
        public string? Email { get; set; }
        public string? Plan { get; set; } = "Pro";
        public bool Newsletter { get; set; }
    }

    private Order _order = new();

    private void Submit() => Snackbar.Add($"Order placed for {_order.Name}: the {_order.Plan} plan.", Severity.Success);
}
