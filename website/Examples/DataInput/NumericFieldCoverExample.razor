<div class="flex flex-col gap-1">
    <NumericField T="int" Label="Speed" @bind-Value="_rpm" Margin="Margin.None" Adornment="Adornment.End" AdornmentText="rpm" />
    <NumericField T="int" Label="Copies" @bind-Value="_copies" Min="1" Max="500" Margin="Margin.None" />
    <div class="mt-3 flex items-baseline justify-between border-t-2 border-base-content pt-2">
        <span class="text-sm font-bold uppercase tracking-widest">Pressing</span>
        <span class="font-display text-3xl font-bold">@(_copies * 2) sides</span>
    </div>
</div>

@code {
    private int _rpm = 45;
    private int _copies = 250;
}
