<div class="flex flex-col gap-1">
    <NumericField T="int" Label="Price per seat" @bind-Value="_price" Margin="Margin.None" Adornment="Adornment.End" AdornmentText="€" />
    <NumericField T="int" Label="Seats" @bind-Value="_seats" Min="1" Max="500" Margin="Margin.None" />
    <div class="mt-3 flex items-baseline justify-between border-t-2 border-base-content pt-2">
        <span class="text-sm font-bold uppercase tracking-widest">Monthly</span>
        <span class="font-display text-3xl font-bold">@(_seats * _price) €</span>
    </div>
</div>

@code {
    private int _price = 12;
    private int _seats = 250;
}
