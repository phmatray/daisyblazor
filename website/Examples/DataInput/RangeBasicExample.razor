<div class="flex w-full flex-col gap-2">
    <div class="flex justify-between text-sm font-bold">
        <span>Volume</span>
        <span class="font-mono">@_volume%</span>
    </div>
    <Range @bind-Value="_volume" Color="Color.Primary" Class="w-full" />
</div>

@code {
    private double _volume = 65;
}
