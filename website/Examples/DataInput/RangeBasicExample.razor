<div class="flex w-full flex-col gap-2">
    <div class="flex justify-between text-sm font-bold">
        <span>Alert threshold</span>
        <span class="font-mono">@_threshold%</span>
    </div>
    <Range @bind-Value="_threshold" Color="Color.Primary" Class="w-full" />
</div>

@code {
    private double _threshold = 65;
}
