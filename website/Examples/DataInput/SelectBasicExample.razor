<Select T="string" Label="Format" @bind-Value="_format" Clearable="true" ClearText="Choose a format…"
        HelperText="@($"Selected: {_format ?? "none"}")">
    <SelectItem Value="@("LP")">12″ LP</SelectItem>
    <SelectItem Value="@("EP")">7″ EP</SelectItem>
    <SelectItem Value="@("Single")">7″ single</SelectItem>
    <SelectItem Value="@("Shellac")" Disabled="true">78 rpm shellac (out of print)</SelectItem>
</Select>

@code {
    private string? _format = "EP";
}
