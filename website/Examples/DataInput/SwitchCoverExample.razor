<div class="flex flex-col gap-4">
    <div class="flex items-center justify-between">
        <span class="font-display text-xl font-bold">Shuffle</span>
        <Switch Color="Color.Primary" Size="Size.Large" @bind-Value="_shuffle" />
    </div>
    <div class="flex items-center justify-between">
        <span class="font-display text-xl font-bold">Repeat</span>
        <Switch Color="Color.Secondary" Size="Size.Large" @bind-Value="_repeat" />
    </div>
    <div class="flex items-center justify-between">
        <span class="font-display text-xl font-bold">Stereo</span>
        <Switch Color="Color.Tertiary" Size="Size.Large" @bind-Value="_stereo" />
    </div>
</div>

@code {
    private bool _shuffle = true;
    private bool _repeat;
    private bool _stereo = true;
}
