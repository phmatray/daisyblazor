<div class="flex flex-col gap-4">
    <div class="flex items-center justify-between">
        <span class="font-display text-xl font-bold">Notifications</span>
        <Switch Color="Color.Primary" Size="Size.Large" @bind-Value="_notifications" />
    </div>
    <div class="flex items-center justify-between">
        <span class="font-display text-xl font-bold">Auto-deploy</span>
        <Switch Color="Color.Secondary" Size="Size.Large" @bind-Value="_autoDeploy" />
    </div>
    <div class="flex items-center justify-between">
        <span class="font-display text-xl font-bold">Backups</span>
        <Switch Color="Color.Tertiary" Size="Size.Large" @bind-Value="_backups" />
    </div>
</div>

@code {
    private bool _notifications = true;
    private bool _autoDeploy;
    private bool _backups = true;
}
