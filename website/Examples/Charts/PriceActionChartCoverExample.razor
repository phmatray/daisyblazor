<PriceActionChart Prices="_readings" ChartKind="PriceActionKind.Renko" BoxSize="4" AspectRatio="1.3" ShowLegend="false" />

@code {
    private static readonly Candle[] _readings = Enumerable.Range(0, 64)
        .Select(i =>
        {
            double v = Math.Round(45 + 18 * Math.Sin(i / 8.0) + 4 * Math.Sin(i * 1.9), 1);
            return new Candle(new DateTime(2026, 10, 19, 6, 0, 0).AddMinutes(15 * i), v, v, v, v);
        })
        .ToArray();
}
