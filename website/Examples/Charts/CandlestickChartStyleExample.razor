<div class="space-y-6">
    <CandlestickChart Title="Job queue depth per 10 minutes (Ohlc)" Candles="_slots" CandleStyle="CandlestickStyle.Ohlc"
                      UpLabel="Growing" DownLabel="Draining" AspectRatio="2.4" ValueFormat="{0:N0} jobs" />
    <CandlestickChart Title="Job queue depth per 10 minutes (HighLow)" Candles="_slots" CandleStyle="CandlestickStyle.HighLow"
                      ShowLegend="false" AspectRatio="2.4" ValueFormat="{0:N0} jobs" />
</div>

@code {
    private static readonly double[] _depth = [120, 180, 260, 240, 310, 280, 200, 150, 170, 230, 190, 140, 90, 110, 160, 130, 80, 60];

    private static readonly Candle[] _slots = _depth.Take(_depth.Length - 1)
        .Select((open, i) =>
        {
            double close = _depth[i + 1];
            return new Candle(new DateTime(2026, 10, 19, 9, 0, 0).AddMinutes(10 * i), open, Math.Max(open, close) + 15 + i % 4 * 10, Math.Min(open, close) - 10 - i % 3 * 8, close);
        })
        .ToArray();
}
