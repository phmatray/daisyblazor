<RangeAreaChart Points="_points" AspectRatio="1.3" ShowLegend="false" />

@code {
    private static readonly RangePoint[] _points = Enumerable.Range(0, 14)
        .Select(i =>
        {
            double median = 110 + 20 * Math.Sin(i / 2.5);
            return new RangePoint(new DateTime(2026, 10, 1).AddDays(i), Math.Round(median * 0.5), Math.Round(median * 2.2), Math.Round(median));
        })
        .ToArray();
}
