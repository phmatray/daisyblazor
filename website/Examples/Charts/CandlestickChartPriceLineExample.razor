<div class="space-y-6">
    <CandlestickChart Title="CPU utilisation per hour, api-01 (%), close line" Candles="_hours" CandleStyle="CandlestickStyle.Line" ValueFormat="{0:0.#} %" AspectRatio="2.4" />
    <CandlestickChart Title="Same hours as an area, with a 6-hour average" Candles="_hours" CandleStyle="CandlestickStyle.Area" ValueFormat="{0:0.#} %" AspectRatio="2.4"
                      Indicators="_average" />
</div>

@code {
    private static readonly ChartIndicator[] _average = [new(IndicatorKind.Sma, Period: 6)];

    // The last reading of each hour draws the line; the tooltips still give each hour's four values.
    private static readonly Candle[] _hours = Enumerable.Range(0, 48)
        .Select(h =>
        {
            double open = Level(h), close = Level(h + 1);
            return new Candle(new DateTime(2026, 10, 18, 0, 0, 0).AddHours(h), open, Math.Max(open, close) + 4 + h % 3, Math.Min(open, close) - 3, close);
        })
        .ToArray();

    private static double Level(int h) => Math.Round(40 + 22 * Math.Sin((h - 8) / 24.0 * 2 * Math.PI) + 4 * Math.Sin(h * 1.3), 1);
}
