<StreamChart Title="Weekly active users by product area" Series="_series" Dates="_weeks" ValueFormat="{0:N0} users" />

@code {
    private static readonly DateTime[] _weeks = Enumerable.Range(0, 16).Select(i => new DateTime(2026, 6, 29).AddDays(7 * i)).ToArray();

    private static ChartSeries Area(string name, double start, double growth, double swing, int phase) =>
        new(name, _weeks.Select((_, i) => Math.Round(start + growth * i + swing * Math.Sin((i + phase) / 2.2))).ToArray());

    private readonly ChartSeries[] _series =
    [
        Area("Dashboards", 4200, 60, 500, 0),
        Area("API", 2600, 140, 300, 3),
        Area("Alerts", 1500, 20, 650, 6),
        Area("Integrations", 900, 90, 200, 1),
        Area("Reports", 1200, -30, 350, 4),
    ];
}
