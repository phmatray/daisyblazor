        .. DistributionSamples.Cloud(seed: 2, count: 30, xMean: 45, xSd: 12, intercept: 5, slope: 0.9, noise: 6, series: "Pro"),
        .. DistributionSamples.Cloud(seed: 3, count: 12, xMean: 140, xSd: 35, intercept: 20, slope: 1.1, noise: 18, series: "Enterprise"),
    ];
}
