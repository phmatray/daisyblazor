<div class="flex flex-wrap items-center gap-8">
    <span class="inline-flex items-center gap-2">p95 latency <Sparkline Data="_latency" NormalMin="180" NormalMax="240" ShowTrendline="true" Width="8rem" Height="2rem" /></span>
    <span class="inline-flex items-center gap-2">Error rate <Sparkline Data="_errors" Type="SparklineKind.Column" ShowTrendline="true" NormalMin="0" NormalMax="0.5" Width="8rem" Height="2rem" Color="var(--color-secondary)" /></span>
</div>

@code {
    // NormalMin and NormalMax shade the expected range; ShowTrendline adds the dashed least-squares line.
    private readonly double[] _latency = [204, 198, 215, 231, 226, 242, 238, 251, 247, 262];
    private readonly double[] _errors = [0.3, 0.4, 0.2, 0.6, 0.5, 0.7, 0.4, 0.8, 0.9, 0.7];
}
