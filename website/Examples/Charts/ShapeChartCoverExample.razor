<ShapeChart Shapes="_racks" KeepAspect="true" ShowLegend="false" ShowGrid="false" AspectRatio="1.4" />

@code {
    private readonly ChartShape[] _racks =
    [
        .. Enumerable.Range(0, 8).Select(i => new ChartShape($"Rack A{i + 1}", [Rect(1 + (i % 4) * 0.9, i < 4 ? 1 : 3.4, 0.6, 1.2)], Group: i % 3 == 0 ? "Full" : "Partial")),
        new("Fibre run", [[new(1.3, 2.2), new(1.3, 2.8), new(4.0, 2.8)]], Closed: false, Color: "var(--color-info)"),
    ];

    private static ShapePoint[] Rect(double x, double y, double w, double h) => [new(x, y), new(x + w, y), new(x + w, y + h), new(x, y + h)];
}
