<SmithChart Series="_series" Mode="SmithChartMode.Admittance" ShowLine="false" />

@code {
    // Before and after the matching network: the tuned points gather around the centre (r = 1, x = 0).
    private readonly SmithSeries[] _series =
    [
        new("Before tuning",
        [
            new(0.35, 0.9, "2.40 GHz"),
            new(0.45, 1.2, "2.44 GHz"),
            new(0.6, 1.55, "2.48 GHz"),
        ]),
        new("After tuning",
        [
            new(0.86, 0.14, "2.40 GHz"),
            new(0.98, 0.03, "2.44 GHz"),
            new(1.12, -0.09, "2.48 GHz"),
        ], ChartPalette.FromColor(Color.Success)),
    ];
}
