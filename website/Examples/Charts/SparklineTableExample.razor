<SimpleTable Dense="true">
    <thead>
        <tr><th>Single</th><th>Last 7 days</th><th class="text-right">Streams</th></tr>
    </thead>
    <tbody>
        @foreach (Row row in _rows)
        {
            <tr>
                <td class="font-bold">@row.Title</td>
                <td><Sparkline Data="row.Daily" Area="true" Color="@(row.Rising ? "var(--color-success)" : "var(--color-error)")" Width="6rem" /></td>
                <td class="text-right font-mono">@row.Daily.Sum().ToString("N0")</td>
            </tr>
        }
    </tbody>
</SimpleTable>

@code {
    private record Row(string Title, double[] Daily)
    {
        public bool Rising => Daily[^1] >= Daily[0];
    }

    private readonly Row[] _rows =
    [
        new("Poupée de cire", [4_100, 4_600, 5_200, 5_050, 6_300, 7_100, 7_800]),
        new("La Javanaise", [6_200, 5_900, 6_100, 5_400, 5_200, 4_900, 4_700]),
        new("Bang Bang", [2_300, 2_500, 2_450, 2_900, 3_300, 3_200, 3_900]),
    ];
}
