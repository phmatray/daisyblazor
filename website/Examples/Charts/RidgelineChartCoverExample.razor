<RidgelineChart Groups="_days" AspectRatio="1.1" />

@code {
    private readonly ValueGroup[] _days =
    [
        .. new[] { "Mon", "Tue", "Wed", "Thu" }.Select((day, i) => new ValueGroup(day,
            [.. DistributionSamples.Normal(seed: 80 + i, count: 300, mean: 9.5, sd: 1.4, min: 0), .. DistributionSamples.Normal(seed: 90 + i, count: 220 - 30 * i, mean: 14.5, sd: 1.8)])),
        new("Sat", DistributionSamples.Normal(seed: 86, count: 160, mean: 13, sd: 3.5, min: 0)),
    ];
}
