<CandlestickChart Candles="_hours" AspectRatio="1.3" ShowLegend="false" />

@code {
    private static readonly double[] _cpu = [34, 41, 38, 52, 61, 57, 66, 59, 48, 53, 44, 39, 46];

    private static readonly Candle[] _hours = _cpu.Take(_cpu.Length - 1)
        .Select((open, i) => new Candle(new DateTime(2026, 10, 19, 8 + i, 0, 0), open, Math.Max(open, _cpu[i + 1]) + 6, Math.Min(open, _cpu[i + 1]) - 4, _cpu[i + 1]))
        .ToArray();
}
