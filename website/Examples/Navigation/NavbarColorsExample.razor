@* Color sets the background only; add the matching text-*-content class for the ink. *@
<div class="flex w-full flex-col gap-3">
    <Navbar Color="Color.Primary" Class="rounded-box text-primary-content">
        <Start><span class="px-2 text-lg font-bold">Primary</span></Start>
        <End><IconButton Icon="@Icons.Material.Filled.Menu" Title="Menu" /></End>
    </Navbar>
    <Navbar Color="Color.Secondary" Class="rounded-box text-secondary-content">
        <Start><span class="px-2 text-lg font-bold">Secondary</span></Start>
        <End><IconButton Icon="@Icons.Material.Filled.Menu" Title="Menu" /></End>
    </Navbar>
    <Navbar Color="Color.Dark" Class="rounded-box text-neutral-content">
        <Start><span class="px-2 text-lg font-bold">Neutral</span></Start>
        <End><IconButton Icon="@Icons.Material.Filled.Menu" Title="Menu" /></End>
    </Navbar>
</div>
