<div class="flex w-full flex-col gap-6">
    @foreach (TabsVariant variant in new[] { TabsVariant.Box, TabsVariant.Border, TabsVariant.Lift })
    {
        <Tabs Variant="variant" Class="[&>.tab-content]:block">
            <Tab Title="@variant.ToString()"><p class="p-4">The @variant variant, as daisyUI tabs-@variant.ToString().ToLowerInvariant().</p></Tab>
            <Tab Title="Tasks"><p class="p-4">Twelve open tasks, three due this week.</p></Tab>
            <Tab Title="Team"><p class="p-4">Led by Priya Nair.</p></Tab>
        </Tabs>
    }
</div>
