@* MenuItem also works outside a Menu, as rows of a plain daisyUI menu list. *@
<div class="flex flex-col gap-3">
    <div class="flex items-center justify-between rounded-box bg-accent px-4 py-3 text-accent-content">
        <span class="text-lg font-bold">Production</span>
        <Icon Name="@Icons.Material.Filled.MoreHoriz" />
    </div>
    <ul class="menu w-full rounded-box bg-base-200 text-base">
        <MenuItem Icon="@Icons.Material.Filled.RocketLaunch" IconColor="Color.Primary">Deploy now</MenuItem>
        <MenuItem Icon="@Icons.Material.Filled.Refresh" Class="menu-active">Restart</MenuItem>
        <MenuItem Icon="@Icons.Material.Filled.Favorite" IconColor="Color.Secondary">Pin</MenuItem>
        <MenuItem Icon="@Icons.Material.Filled.Lock" Disabled="true">Roll back</MenuItem>
    </ul>
</div>
