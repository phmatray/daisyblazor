@* MenuItem also works outside a Menu, as rows of a plain daisyUI menu list. *@
<div class="flex flex-col gap-3">
    <div class="flex items-center justify-between rounded-box bg-accent px-4 py-3 text-accent-content">
        <span class="text-lg font-bold">Côté B</span>
        <Icon Name="@Icons.Material.Filled.MoreHoriz" />
    </div>
    <ul class="menu w-full rounded-box bg-base-200 text-base">
        <MenuItem Icon="@Icons.Material.Filled.PlayArrow" IconColor="Color.Primary">Play now</MenuItem>
        <MenuItem Icon="@Icons.Material.Filled.PlaylistAdd" Class="menu-active">Add to queue</MenuItem>
        <MenuItem Icon="@Icons.Material.Filled.Favorite" IconColor="Color.Secondary">Favourite</MenuItem>
        <MenuItem Icon="@Icons.Material.Filled.Lock" Disabled="true">Lossless</MenuItem>
    </ul>
</div>
