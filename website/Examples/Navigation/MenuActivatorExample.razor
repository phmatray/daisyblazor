@* ActivatorContent receives a MenuActivator: call context.ToggleAsync from any trigger. *@
<div class="min-h-44">
    <Menu>
        <ActivatorContent>
            <Button Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="context.ToggleAsync">
                New
            </Button>
        </ActivatorContent>
        <ChildContent>
            <MenuItem Icon="@Icons.Material.Filled.QueueMusic">Playlist</MenuItem>
            <MenuItem Icon="@Icons.Material.Filled.Folder">Folder</MenuItem>
            <MenuItem Icon="@Icons.Material.Filled.Radio">Radio station</MenuItem>
        </ChildContent>
    </Menu>
</div>
