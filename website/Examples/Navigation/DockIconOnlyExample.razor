@* Without a visible Label, give each item an AriaLabel. Href renders the item as a link. *@
<div class="w-full overflow-hidden rounded-box border border-base-300">
    <Dock Class="relative" Size="DockSize.Sm">
        <DockItem Icon="@Icons.Material.Filled.Home" AriaLabel="Home" Href="#" Active="true" />
        <DockItem Icon="@Icons.Material.Filled.Favorite" AriaLabel="Favourites" Href="#" />
        <DockItem Icon="@Icons.Material.Filled.ShoppingCart" AriaLabel="Basket" Href="#" />
        <DockItem Icon="@Icons.Material.Filled.Notifications" AriaLabel="Notifications" Href="#" />
    </Dock>
</div>
