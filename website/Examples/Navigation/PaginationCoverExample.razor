<div class="flex flex-col items-center gap-5">
    <div class="grid w-full grid-cols-4 gap-2">
        @for (int i = 0; i < 8; i++)
        {
            string tone = ((i + _page) % 3) switch { 0 => "bg-primary", 1 => "bg-secondary", _ => "bg-accent" };
            <div class="aspect-square rounded-md @tone"></div>
        }
    </div>
    <Pagination Count="5" @bind-Selected="_page" Color="Color.Primary" />
    <p class="text-sm font-semibold">Page @_page of 5</p>
</div>

@code {
    private int _page = 3;
}
