@* Color overrides Completed/Active; DataContent replaces the step number with a symbol. *@
<Steps Class="w-full">
    <Step Color="Color.Success" DataContent="✓">Mastered</Step>
    <Step Color="Color.Success" DataContent="✓">Pressed</Step>
    <Step Color="Color.Warning" DataContent="!">Sleeve proof</Step>
    <Step Color="Color.Error" DataContent="✕">Shipping</Step>
    <Step DataContent="●">In stores</Step>
</Steps>
