@* With OnClick the card becomes a focusable button: Enter and Space activate it too. *@
<div class="flex flex-wrap items-center gap-6">
    <Card Outlined="true" OnClick="() => _plays++" Class="w-56 cursor-pointer transition hover:border-primary">
        <CardContent>
            <Icon Name="@Icons.Material.Filled.PlayArrow" Size="Size.Large" Color="Color.Primary" />
            <h3 class="card-title">Laisse tomber les filles</h3>
            <p class="text-sm text-base-content/60">Click or press Enter to play</p>
        </CardContent>
    </Card>
    <p class="text-lg">Played <strong>@_plays</strong> times</p>
</div>

@code {
    private int _plays;
}
