@* Animated adds a ping ring; pair the dot with text so the state is not colour-only. *@
<div class="flex flex-col gap-3">
    <span class="flex items-center gap-2"><Status Color="Color.Error" Animated="true" /> Incident in progress</span>
    <span class="flex items-center gap-2"><Status Color="Color.Success" /> All systems operational</span>
    <span class="flex items-center gap-2"><Status Color="Color.Warning" /> Degraded performance</span>
    <span class="flex items-center gap-2"><Status /> Offline</span>
</div>
