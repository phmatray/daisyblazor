@* OnClick turns the chip into a button, handy for filter toggles. *@
<div class="flex flex-col gap-3">
    <div class="flex flex-wrap gap-2">
        @foreach (string env in Environments)
        {
            bool on = _selected.Contains(env);
            <Chip Text="@env" Color="@(on ? Color.Primary : Color.Default)" Variant="@(on ? Variant.Filled : Variant.Outlined)"
                  Icon="@(on ? Icons.Material.Filled.Check : null)" Size="Size.Large" OnClick="() => Toggle(env)" aria-pressed="@(on ? "true" : "false")" />
        }
    </div>
    <p class="text-sm text-base-content/70">Showing: @(_selected.Count == 0 ? "everything" : string.Join(", ", _selected))</p>
</div>

@code {
    private static readonly string[] Environments = ["Production", "Staging", "Dev", "Preview", "Sandbox"];
    private readonly HashSet<string> _selected = ["Production"];

    private void Toggle(string env)
    {
        if (!_selected.Remove(env)) _selected.Add(env);
    }
}
