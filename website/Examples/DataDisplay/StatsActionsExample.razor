@* The Actions slot sits under the description; Class styles the container. *@
<Stats Shadow="true" Class="w-full bg-base-200">
    <Stat Title="Royalties" Value="@($"€{_balance:N0}")" Desc="Paid out monthly">
        <Actions>
            <Button Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" OnClick="() => _balance += 250">Add funds</Button>
        </Actions>
    </Stat>
    <Stat Title="Pre-orders" Value="@_preorders.ToString()" Desc="Vinyl edition">
        <Actions>
            <Button Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" OnClick="() => _preorders++">Order one</Button>
        </Actions>
    </Stat>
</Stats>

@code {
    private decimal _balance = 89400;
    private int _preorders = 318;
}
