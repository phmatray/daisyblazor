@* The Actions slot sits under the description; Class styles the container. *@
<Stats Shadow="true" Class="w-full bg-base-200">
    <Stat Title="Account credit" Value="@($"€{_balance:N0}")" Desc="Applied to the next invoice">
        <Actions>
            <Button Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" OnClick="() => _balance += 250">Add funds</Button>
        </Actions>
    </Stat>
    <Stat Title="Seats" Value="@_seats.ToString()" Desc="Pro plan">
        <Actions>
            <Button Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" OnClick="() => _seats++">Add a seat</Button>
        </Actions>
    </Stat>
</Stats>

@code {
    private decimal _balance = 8940;
    private int _seats = 38;
}
