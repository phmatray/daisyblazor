<Card Elevation="12" Class="w-full overflow-hidden">
    <figure class="relative">
        <img src="https://img.daisyui.com/images/stock/photo-1572635148818-ef6fd45eb394.webp" alt="A lemon on a yellow background" class="aspect-[16/10] w-full object-cover" />
        <Badge Inline="true" Color="Color.Primary" Class="absolute left-3 top-3">New</Badge>
    </figure>
    <CardContent Class="gap-1 p-4">
        <h3 class="card-title font-display">Spring campaign visual</h3>
        <p class="text-sm text-base-content/70">Brand assets · uploaded by Ana</p>
    </CardContent>
    <CardActions Class="justify-between px-4 pb-4">
        <span class="font-mono text-sm">PNG · 2.4 MB</span>
        <Button Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" StartIcon="@Icons.Material.Filled.Download">Download</Button>
    </CardActions>
</Card>
