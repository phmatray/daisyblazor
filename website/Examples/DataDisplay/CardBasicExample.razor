<Card Class="w-full max-w-sm">
    <CardHeader>
        <CardHeaderAvatar>
            <Avatar Color="Color.Primary">NT</Avatar>
        </CardHeaderAvatar>
        <CardHeaderContent>
            <p class="font-bold">Northwind Traders</p>
            <p class="text-sm text-base-content/60">Enterprise plan · customer since 2021</p>
        </CardHeaderContent>
    </CardHeader>
    <CardContent>
        <p>42 seats, renews on 1 March. Usage is up 18% this quarter, close to the plan limit.</p>
    </CardContent>
    <CardActions Class="justify-end">
        <Button Variant="Variant.Text">Details</Button>
        <Button Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add">Add seats</Button>
    </CardActions>
</Card>
