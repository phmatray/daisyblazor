<Card Class="w-full max-w-sm">
    <CardHeader>
        <CardHeaderAvatar>
            <Avatar Color="Color.Primary">FG</Avatar>
        </CardHeaderAvatar>
        <CardHeaderContent>
            <p class="font-bold">France Gall</p>
            <p class="text-sm text-base-content/60">Poupée de cire, poupée de son · 1965</p>
        </CardHeaderContent>
    </CardHeader>
    <CardContent>
        <p>Winner of the tenth Eurovision. Remastered from the original tapes, pressed on 180&nbsp;g vinyl.</p>
    </CardContent>
    <CardActions Class="justify-end">
        <Button Variant="Variant.Text">Details</Button>
        <Button Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.ShoppingCart">Add to cart</Button>
    </CardActions>
</Card>
