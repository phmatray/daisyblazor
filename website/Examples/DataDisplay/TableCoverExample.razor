<div class="flex flex-col gap-2">
    <div class="flex items-baseline justify-between px-1">
        <span class="font-display text-xl font-bold">Hit parade</span>
        <span class="text-xs font-bold uppercase tracking-widest text-base-content/60">Week 12</span>
    </div>
    <Table Items="_top" Striped="true" Dense="true" Class="rounded-box bg-base-200">
        <HeaderContent>
            <Th>#</Th>
            <Th>Single</Th>
            <Th></Th>
        </HeaderContent>
        <RowTemplate>
            <Td class="font-mono text-base font-bold text-primary">@context.Rank</Td>
            <Td class="font-semibold">@context.Single</Td>
            <Td class="text-right">
                <Icon Name="@(context.Up ? Icons.Material.Filled.TrendingUp : Icons.Material.Filled.TrendingDown)"
                      Color="@(context.Up ? Color.Success : Color.Error)" Size="Size.Small" />
            </Td>
        </RowTemplate>
    </Table>
</div>

@code {
    private record Entry(int Rank, string Single, bool Up);

    private readonly Entry[] _top =
    [
        new(1, "Bonnie and Clyde", true), new(2, "La Madrague", false), new(3, "Bubble Gum", true),
        new(4, "Comic Strip", true), new(5, "Harley Davidson", false),
    ];
}
