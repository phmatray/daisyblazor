@* Outlined swaps the shadow for a border; Elevation picks the shadow depth. *@
<div class="grid w-full gap-4 sm:grid-cols-3">
    <Card Outlined="true">
        <CardContent><h3 class="card-title">Outlined</h3><p class="text-sm">A border, no shadow.</p></CardContent>
    </Card>
    <Card Elevation="0" Class="bg-base-200">
        <CardContent><h3 class="card-title">Flat</h3><p class="text-sm">Elevation 0 on base-200.</p></CardContent>
    </Card>
    <Card Elevation="12">
        <CardContent><h3 class="card-title">Raised</h3><p class="text-sm">Elevation 12.</p></CardContent>
    </Card>
</div>
