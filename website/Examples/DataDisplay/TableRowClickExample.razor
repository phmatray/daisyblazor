@* OnRowClick makes rows clickable and hands you the item and its row index. *@
<Table Items="_customers" OnRowClick="(TableRowClickEventArgs<Customer> e) => _selected = e.Item">
    <HeaderContent>
        <Th>Customer</Th>
        <Th>Plan</Th>
    </HeaderContent>
    <RowTemplate>
        <Td class="@(context == _selected ? "font-bold text-primary" : null)">@context.Name</Td>
        <Td>@context.Plan</Td>
    </RowTemplate>
</Table>
<p class="mt-3 text-sm text-base-content/70">Selected: @(_selected?.Name ?? "click a row")</p>

@code {
    private record Customer(string Name, string Plan);

    private readonly Customer[] _customers =
    [
        new("Northwind Traders", "Enterprise"), new("Contoso", "Pro"), new("Fabrikam", "Free"),
    ];

    private Customer? _selected;
}
