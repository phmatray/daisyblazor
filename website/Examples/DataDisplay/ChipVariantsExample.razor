@* Filled is badge, Outlined is badge-outline and Text is badge-soft. *@
<div class="flex flex-col gap-4">
    <div class="flex flex-wrap items-center gap-2">
        <Chip Text="Filled" Color="Color.Primary" Variant="Variant.Filled" />
        <Chip Text="Outlined" Color="Color.Primary" Variant="Variant.Outlined" />
        <Chip Text="Soft" Color="Color.Primary" Variant="Variant.Text" />
    </div>
    <div class="flex flex-wrap items-center gap-2">
        <Chip Text="Small" Color="Color.Secondary" Size="Size.Small" />
        <Chip Text="Medium" Color="Color.Secondary" Size="Size.Medium" />
        <Chip Text="Large" Color="Color.Secondary" Size="Size.Large" />
    </div>
</div>
