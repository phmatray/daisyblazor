@* Item takes any fragment: a badge, a status dot, a tiny button. *@
<div class="flex flex-wrap items-center gap-10">
    <Indicator>
        <Item><Badge Inline="true" Color="Color.Primary">12</Badge></Item>
        <ChildContent><Button Variant="Variant.Outlined">Tickets</Button></ChildContent>
    </Indicator>
    <Indicator Vertical="IndicatorVertical.Bottom">
        <Item><Status Color="Color.Success" Size="StatusSize.Large" AriaLabel="Online" /></Item>
        <ChildContent><Avatar Image="https://img.daisyui.com/images/profile/demo/yellingcat@192.webp" Alt="Ana Silva" Size="Size.Large" /></ChildContent>
    </Indicator>
    <Indicator Horizontal="IndicatorHorizontal.Center">
        <Item><Badge Inline="true" Color="Color.Error">Overdue</Badge></Item>
        <ChildContent>
            <Card Outlined="true" Class="w-48"><CardContent><span class="font-semibold">Invoice #2087</span></CardContent></Card>
        </ChildContent>
    </Indicator>
</div>
