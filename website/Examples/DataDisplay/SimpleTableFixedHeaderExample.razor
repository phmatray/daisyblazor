@* FixedHeader caps the height and scrolls the body; add table-pin-rows to keep the header in view. *@
<SimpleTable FixedHeader="true" Dense="true" Class="table-pin-rows">
    <thead>
        <tr><th>Month</th><th>Signups</th><th>Plan</th></tr>
    </thead>
    <tbody>
        @foreach ((string month, int signups, string plan) in _signups)
        {
            <tr><td class="font-mono">@month</td><td>@signups</td><td>@plan</td></tr>
        }
    </tbody>
</SimpleTable>

@code {
    private readonly (string, int, string)[] _signups =
    [
        ("Jan", 412, "Pro"), ("Feb", 388, "Free"), ("Mar", 455, "Pro"), ("Apr", 501, "Enterprise"),
        ("May", 476, "Pro"), ("Jun", 530, "Free"), ("Jul", 498, "Pro"), ("Aug", 467, "Free"),
        ("Sep", 612, "Pro"), ("Oct", 640, "Enterprise"), ("Nov", 702, "Pro"), ("Dec", 655, "Free"),
    ];
}
