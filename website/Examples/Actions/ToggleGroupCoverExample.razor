<div class="flex flex-col items-center gap-5">
    <ToggleGroup T="int" @bind-Value="_rpm" Class="rounded-field border-2 border-base-300" Size="Size.Large">
        <ToggleItem Value="33" Text="33⅓" />
        <ToggleItem Value="45" Text="45" />
        <ToggleItem Value="78" Text="78" />
    </ToggleGroup>
    <ToggleGroup T="string" @bind-Value="_side" Class="rounded-field border-2 border-base-300" Color="Color.Secondary">
        <ToggleItem Value="@("a")" Icon="@Icons.Material.Filled.Album" Text="Side A" />
        <ToggleItem Value="@("b")" Icon="@Icons.Material.Filled.Album" Text="Side B" />
    </ToggleGroup>
    <ToggleGroup T="string" @bind-Value="_view" Class="rounded-field border-2 border-base-300" Size="Size.Small" Color="Color.Tertiary">
        <ToggleItem Value="@("grid")" Icon="@Icons.Material.Filled.GridView" aria-label="Grid" />
        <ToggleItem Value="@("list")" Icon="@Icons.Material.Filled.ViewList" aria-label="List" />
        <ToggleItem Value="@("queue")" Icon="@Icons.Material.Filled.QueueMusic" aria-label="Queue" />
    </ToggleGroup>
</div>

@code {
    private int _rpm = 45;
    private string? _side = "a";
    private string? _view = "grid";
}
