<div class="flex flex-col items-center gap-4">
    <div class="grid size-52 place-items-center rounded-full bg-neutral shadow-xl ring-8 ring-neutral/20">
        <div class="grid size-24 place-items-center rounded-full bg-primary text-primary-content">
            <Swap Animation="SwapAnimation.Rotate" @bind-Active="_playing">
                <On><Icon Name="@Icons.Material.Filled.Pause" Class="text-5xl!" /></On>
                <Off><Icon Name="@Icons.Material.Filled.PlayArrow" Class="text-5xl!" /></Off>
            </Swap>
        </div>
    </div>
    <p class="font-display text-lg font-bold">@(_playing ? "Spinning" : "Tap to spin")</p>
</div>

@code {
    private bool _playing;
}
