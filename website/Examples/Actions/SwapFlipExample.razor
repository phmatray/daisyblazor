<div class="flex items-center gap-4">
    <Swap Animation="SwapAnimation.Flip" @bind-Active="_syncing" Class="text-primary">
        <On><Icon Name="@Icons.Material.Filled.PauseCircle" Size="Size.Large" /></On>
        <Off><Icon Name="@Icons.Material.Filled.PlayCircle" Size="Size.Large" /></Off>
    </Swap>
    <span class="text-sm">@(_syncing ? "Sync running" : "Sync paused")</span>
</div>

@code {
    private bool _syncing;
}
