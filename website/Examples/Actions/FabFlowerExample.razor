@* translateZ(0) keeps the fixed FAB inside this demo box. *@
<div class="relative h-72 w-full overflow-hidden rounded-box bg-base-200 [transform:translateZ(0)]">
    <Fab Color="Color.Secondary" Flower="true" AriaLabel="Edit actions">
        <FabAction Icon="@Icons.Material.Filled.ContentCopy" Tooltip="Copy" TooltipPosition="top" />
        <FabAction Icon="@Icons.Material.Filled.Edit" Tooltip="Edit" TooltipPosition="top" />
        <FabAction Icon="@Icons.Material.Filled.Delete" Tooltip="Delete" TooltipPosition="left" Color="Color.Error" />
    </Fab>
</div>
