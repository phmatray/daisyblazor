<div class="flex flex-col items-center gap-4 text-center">
    <div class="grid size-32 place-items-center rounded-full bg-neutral text-neutral-content shadow-xl">
        <div class="grid size-12 place-items-center rounded-full bg-primary text-primary-content">
            <Icon Name="@Icons.Material.Filled.Album" />
        </div>
    </div>
    <div>
        <p class="font-display text-xl font-bold leading-tight">Les yeux bleus</p>
        <p class="text-sm opacity-70">Mireille et les Copains · 1966</p>
    </div>
    <div class="flex items-center gap-1">
        <IconButton Icon="@Icons.Material.Filled.Shuffle" Size="Size.Small" aria-label="Shuffle" />
        <IconButton Icon="@Icons.Material.Filled.SkipPrevious" aria-label="Previous" />
        <IconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Large" Color="Color.Primary" aria-label="Play" />
        <IconButton Icon="@Icons.Material.Filled.SkipNext" aria-label="Next" />
        <IconButton Icon="@Icons.Material.Filled.Favorite" Size="Size.Small" Color="Color.Error" aria-label="Like" />
    </div>
</div>
