<div class="flex flex-col gap-2">
    <p class="mb-1 font-display text-xl font-bold leading-none">Choose a pressing</p>
    @foreach (string theme in _themes)
    {
        <ThemeController Type="ThemeControllerType.Radio" Name="cover-pressing" Value="@theme" Checked="@(theme == "site")"
                         Class="flex items-center gap-3 rounded-box border-2 border-base-300 px-3 py-2">
            <span class="flex-1 font-semibold capitalize">@theme</span>
            <span data-theme="@theme" class="flex gap-1 rounded-full bg-base-100 p-1">
                <span class="size-4 rounded-full bg-primary"></span>
                <span class="size-4 rounded-full bg-secondary"></span>
                <span class="size-4 rounded-full bg-accent"></span>
            </span>
        </ThemeController>
    }
</div>

@code {
    // "site" is not a daisyUI theme: selecting it falls back to the page's own theme.
    private readonly string[] _themes = ["site", "retro", "cupcake", "synthwave"];
}
